[{"ar":"يَلَّا","uz":"Qani, ketdik!","note":"Soʻzlashuv tilida (dialekt) kimnidir shoshiltirish yoki ishni boshlashga undash uchun aytiladi.","ex":"يَلَّا، نَذْهَبُ إِلَى المَلْعَبِ!","exUz":"Qani, stadionga ketdik!"},{"ar":"طَيِّب","uz":"Xoʻp, yaxshi","note":"Rozilik bildirish yoki gapni yakunlash uchun juda koʻp ishlatiladi.","ex":"طَيِّب، سَأَتَّصِلُ بِكَ غَدًا.","exUz":"Xoʻp, ertaga senga qoʻngʻiroq qilaman."},{"ar":"مُمْتَازٌ","uz":"Aʼlo!","note":"Biror narsa juda yaxshi boʻlganda maqtov sifatida aytiladi.","ex":"عَمَلُكَ مُمْتَازٌ!","exUz":"Ishing aʼlo!"},{"ar":"بِالضَّبْطِ","uz":"Aynan shunday","note":"Suhbatdoshning gapiga toʻliq qoʻshilganda aytiladi.","ex":"هَلْ تَقْصِدُ هٰذَا الكِتَابَ؟ بِالضَّبْطِ!","exUz":"Shu kitobni nazarda tutyapsanmi? Aynan!"},{"ar":"مَعْلِيشْ","uz":"Hechqisi yoʻq / Kechirasiz","note":"Soʻzlashuv tilida (dialekt) kichik xato uchun uzr soʻrash yoki tasalli berishda aytiladi.","ex":"مَعْلِيشْ، تَأَخَّرْتُ قَلِيلًا.","exUz":"Kechirasan, biroz kechikdim."},{"ar":"عَلَى رَاحَتِكَ","uz":"Bemalol, oʻzing bilasan","note":"Kimgadir shoshilmaslik yoki xohlaganicha qilishni aytganda ishlatiladi.","ex":"اِجْلِسْ عَلَى رَاحَتِكَ.","exUz":"Bemalol oʻtir."},{"ar":"لَا بَأْسَ","uz":"Hechqisi yoʻq","note":"Muammo jiddiy emasligini bildirish uchun aytiladi.","ex":"لَا بَأْسَ، سَنُحَاوِلُ مَرَّةً أُخْرَى.","exUz":"Hechqisi yoʻq, yana bir urinib koʻramiz."},{"ar":"تَشَرَّفْنَا","uz":"Tanishganimdan xursandman","note":"Yangi odam bilan tanishganda xushmuomalalik bilan aytiladi.","ex":"اِسْمِي أَحْمَدُ. تَشَرَّفْنَا!","exUz":"Ismim Ahmad. Tanishganimdan xursandman!"},{"ar":"صَبَاحُ الخَيْرِ","uz":"Xayrli tong","note":"Ertalab salomlashishda aytiladi.","ex":"صَبَاحُ الخَيْرِ يَا أُمِّي!","exUz":"Xayrli tong, oyijon!"},{"ar":"صَبَاحُ النُّورِ","uz":"Nurli tong (javob)","note":"«Xayrli tong»ga javoban aytiladi.","ex":"صَبَاحُ الخَيْرِ! صَبَاحُ النُّورِ!","exUz":"Xayrli tong! Nurli tong!"},{"ar":"مَسَاءُ الخَيْرِ","uz":"Xayrli kech","note":"Kechqurun salomlashishda aytiladi.","ex":"مَسَاءُ الخَيْرِ يَا أَصْدِقَاءُ!","exUz":"Xayrli kech, doʻstlar!"},{"ar":"مَسَاءُ النُّورِ","uz":"Nurli kech (javob)","note":"«Xayrli kech»ga javoban aytiladi.","ex":"مَسَاءُ الخَيْرِ يَا سَارَةُ! مَسَاءُ النُّورِ!","exUz":"Xayrli kech, Sora! Nurli kech!"},{"ar":"كَمِ السَّاعَةُ؟","uz":"Soat necha?","note":"Vaqtni soʻraganda ishlatiladi.","ex":"كَمِ السَّاعَةُ الآنَ؟ إِنَّهَا الثَّالِثَةُ.","exUz":"Hozir soat necha? Soat uch."},{"ar":"مَرْحَبًا","uz":"Salom","note":"Har qanday vaziyatda ishlatiladigan oddiy salomlashish.","ex":"مَرْحَبًا يَا صَدِيقِي!","exUz":"Salom, doʻstim!"},{"ar":"أَهْلًا وَسَهْلًا","uz":"Xush kelibsiz","note":"Mehmonni kutib olishda yoki iliq salomlashishda aytiladi.","ex":"أَهْلًا وَسَهْلًا فِي بَيْتِنَا!","exUz":"Uyimizga xush kelibsiz!"},{"ar":"كَيْفَ حَالُكَ؟","uz":"Ishlaring qalay?","note":"Hol-ahvol soʻrashda eng koʻp ishlatiladigan savol.","ex":"كَيْفَ حَالُكَ اليَوْمَ؟","exUz":"Bugun ishlaring qalay?"},{"ar":"بِخَيْرٍ","uz":"Yaxshi (holim yaxshi)","note":"«Qalaysan?» savoliga javob sifatida aytiladi.","ex":"أَنَا بِخَيْرٍ، شُكْرًا.","exUz":"Men yaxshiman, rahmat."},{"ar":"شُكْرًا","uz":"Rahmat","note":"Minnatdorlik bildirishda aytiladi.","ex":"شُكْرًا عَلَى المُسَاعَدَةِ!","exUz":"Yordam uchun rahmat!"},{"ar":"شُكْرًا جَزِيلًا","uz":"Katta rahmat","note":"Chuqur minnatdorlik bildirishda aytiladi.","ex":"شُكْرًا جَزِيلًا عَلَى الهَدِيَّةِ!","exUz":"Sovgʻa uchun katta rahmat!"},{"ar":"عَفْوًا","uz":"Arzimaydi","note":"«Rahmat»ga javoban yoki kechirim soʻraganda aytiladi.","ex":"شُكْرًا! عَفْوًا.","exUz":"Rahmat! Arzimaydi."},{"ar":"مِنْ فَضْلِكَ","uz":"Iltimos","note":"Biror narsani muloyimlik bilan soʻraganda ishlatiladi.","ex":"أَعْطِنِي المَاءَ مِنْ فَضْلِكَ.","exUz":"Iltimos, menga suv ber."},{"ar":"آسِفٌ","uz":"Kechirasiz (uzr)","note":"Xato qilganda uzr soʻrash uchun aytiladi (qiz bola: آسِفَةٌ).","ex":"آسِفٌ، لَمْ أَقْصِدْ ذٰلِكَ.","exUz":"Kechirasan, ataylab qilmadim."},{"ar":"مَعَ السَّلَامَةِ","uz":"Xayr, salomat boʻling","note":"Xayrlashganda aytiladi.","ex":"مَعَ السَّلَامَةِ، نَرَاكَ غَدًا!","exUz":"Xayr, ertaga koʻrishamiz!"},{"ar":"إِلَى اللِّقَاءِ","uz":"Koʻrishguncha","note":"Xayrlashishda rasmiyroq ifoda.","ex":"إِلَى اللِّقَاءِ يَا أُسْتَاذُ!","exUz":"Koʻrishguncha, ustoz!"},{"ar":"أَكِيد","uz":"Albatta, aniq","note":"Biror narsaga ishonch bildirganda aytiladi.","ex":"هَلْ سَتَأْتِي إِلَى الحَفْلَةِ؟ أَكِيد!","exUz":"Bazmga kelasanmi? Albatta!"},{"ar":"طَبْعًا","uz":"Albatta, tabiiyki","note":"Ochiq-oydin narsaga rozilik bildirishda ishlatiladi.","ex":"طَبْعًا أُحِبُّ الشُّوكُولَاتَةَ!","exUz":"Albatta, shokoladni yaxshi koʻraman!"},{"ar":"رُبَّمَا","uz":"Balki","note":"Ishonch komil boʻlmaganda aytiladi.","ex":"رُبَّمَا تُمْطِرُ اليَوْمَ.","exUz":"Balki bugun yomgʻir yogʻar."},{"ar":"مُسْتَحِيلٌ","uz":"Boʻlishi mumkin emas!","note":"Hayratlanganda yoki qatʼiy rad etganda aytiladi.","ex":"فَازَ فَرِيقُنَا عَشَرَةً-صِفْر؟ مُسْتَحِيلٌ!","exUz":"Jamoamiz 10:0 yutdimi? Boʻlishi mumkin emas!"},{"ar":"رَائِعٌ","uz":"Ajoyib","note":"Biror narsa juda yoqqanda aytiladi.","ex":"هٰذَا الفِيلْمُ رَائِعٌ!","exUz":"Bu film ajoyib!"},{"ar":"جَمِيلٌ جِدًّا","uz":"Juda chiroyli","note":"Goʻzallikni maqtaganda aytiladi.","ex":"المَنْظَرُ جَمِيلٌ جِدًّا!","exUz":"Manzara juda chiroyli!"},{"ar":"حَظًّا سَعِيدًا","uz":"Omad!","note":"Imtihon yoki musobaqa oldidan tilak sifatida aytiladi.","ex":"حَظًّا سَعِيدًا فِي الاِمْتِحَانِ!","exUz":"Imtihonda omad!"},{"ar":"بِالتَّوْفِيقِ","uz":"Muvaffaqiyat tilayman","note":"Kimgadir ishida omad tilaganda aytiladi.","ex":"بِالتَّوْفِيقِ فِي عَمَلِكَ الجَدِيدِ!","exUz":"Yangi ishingda muvaffaqiyat tilayman!"},{"ar":"تَهَانِينَا","uz":"Tabriklaymiz!","note":"Yutuq yoki quvonchli voqea munosabati bilan aytiladi.","ex":"تَهَانِينَا عَلَى النَّجَاحِ!","exUz":"Muvaffaqiyating bilan tabriklaymiz!"},{"ar":"عِيدُ مِيلَادٍ سَعِيدٌ","uz":"Tugʻilgan kuning bilan!","note":"Tugʻilgan kun tabrigi.","ex":"عِيدُ مِيلَادٍ سَعِيدٌ يَا أُخْتِي!","exUz":"Tugʻilgan kuning bilan, opajon!"},{"ar":"شُوَيَّة","uz":"Biroz, ozgina","note":"Soʻzlashuv tilida (dialekt) «قَلِيلًا» oʻrniga ishlatiladi.","ex":"اِنْتَظِرْ شُوَيَّة!","exUz":"Biroz kut!"},{"ar":"كَمَانْ","uz":"Yana, ham","note":"Soʻzlashuv tilida (Misr, Shom) «yana» maʼnosida aytiladi.","ex":"أُرِيدُ كَمَانْ قِطْعَةً!","exUz":"Yana bir boʻlak xohlayman!"},{"ar":"خَلَاصْ","uz":"Boʻldi, tamom","note":"Biror ish tugaganini yoki «yetar» demoqchi boʻlganda aytiladi.","ex":"خَلَاصْ، اِنْتَهَيْتُ مِنَ الوَاجِبِ!","exUz":"Boʻldi, uy vazifasini tugatdim!"},{"ar":"يَعْنِي","uz":"Yaʼni, xullas","note":"Gapni tushuntirishda yoki oʻylab olishda juda koʻp aytiladi.","ex":"الفِيلْمُ كَانَ يَعْنِي... عَادِيًّا.","exUz":"Film xullas... oddiy edi."},{"ar":"دَقِيقَةً وَاحِدَةً","uz":"Bir daqiqa!","note":"Kimnidir biroz kutib turishga soʻraganda aytiladi.","ex":"دَقِيقَةً وَاحِدَةً، أَنَا قَادِمٌ!","exUz":"Bir daqiqa, kelyapman!"},{"ar":"عَلَى فِكْرَةٍ","uz":"Aytgancha","note":"Suhbatda yangi mavzu ochganda ishlatiladi.","ex":"عَلَى فِكْرَةٍ، أَيْنَ كِتَابِي؟","exUz":"Aytgancha, kitobim qayerda?"},{"ar":"بِصَرَاحَةٍ","uz":"Rostini aytsam","note":"Ochiq fikr bildirishdan oldin aytiladi.","ex":"بِصَرَاحَةٍ، الطَّعَامُ لَذِيذٌ جِدًّا.","exUz":"Rostini aytsam, ovqat juda mazali."},{"ar":"مَا رَأْيُكَ؟","uz":"Fikring qanday?","note":"Kimningdir fikrini soʻraganda ishlatiladi.","ex":"مَا رَأْيُكَ فِي هٰذَا القَمِيصِ؟","exUz":"Bu koʻylak haqida fikring qanday?"},{"ar":"أَنَا مُوَافِقٌ","uz":"Roziman","note":"Taklifga rozilik bildirishda aytiladi.","ex":"نَلْعَبُ كُرَةَ القَدَمِ؟ أَنَا مُوَافِقٌ!","exUz":"Futbol oʻynaymizmi? Roziman!"},{"ar":"فِكْرَةٌ رَائِعَةٌ","uz":"Zoʻr gʻoya!","note":"Taklif yoqqanda aytiladi.","ex":"نَذْهَبُ إِلَى البَحْرِ؟ فِكْرَةٌ رَائِعَةٌ!","exUz":"Dengizga boramizmi? Zoʻr gʻoya!"},{"ar":"مَا المُشْكِلَةُ؟","uz":"Muammo nima?","note":"Kimdir xafa yoki tashvishli koʻrinsa soʻraladi.","ex":"تَبْدُو حَزِينًا، مَا المُشْكِلَةُ؟","exUz":"Xafa koʻrinasan, muammo nima?"},{"ar":"لَا مُشْكِلَةَ","uz":"Muammo yoʻq","note":"Rozilik yoki xotirjamlik bildirishda aytiladi.","ex":"تُرِيدُ قَلَمِي؟ لَا مُشْكِلَةَ!","exUz":"Ruchkamni xohlaysanmi? Muammo yoʻq!"},{"ar":"بِسُرْعَةٍ","uz":"Tez!","note":"Kimnidir shoshiltirganda aytiladi.","ex":"تَعَالَ بِسُرْعَةٍ!","exUz":"Tez kel!"},{"ar":"عَلَى مَهْلِكَ","uz":"Shoshilma, sekin","note":"Kimgadir sabr bilan, sekin harakat qilishni aytganda ishlatiladi.","ex":"عَلَى مَهْلِكَ، الطَّرِيقُ زَلِقٌ.","exUz":"Shoshilma, yoʻl sirpanchiq."},{"ar":"اِنْتَبِهْ!","uz":"Ehtiyot boʻl!","note":"Xavf haqida ogohlantirishda aytiladi.","ex":"اِنْتَبِهْ! السَّيَّارَةُ قَادِمَةٌ!","exUz":"Ehtiyot boʻl! Mashina kelyapti!"},{"ar":"تَفَضَّلْ","uz":"Marhamat","note":"Biror narsa berganda yoki kirishga taklif qilganda aytiladi.","ex":"تَفَضَّلْ، هٰذَا الشَّايُ لَكَ.","exUz":"Marhamat, bu choy senga."},{"ar":"بِكَمْ هٰذَا؟","uz":"Bu qancha turadi?","note":"Doʻkon yoki bozorda narx soʻraganda ishlatiladi.","ex":"بِكَمْ هٰذَا القَمِيصُ؟","exUz":"Bu koʻylak qancha turadi?"},{"ar":"غَالٍ جِدًّا","uz":"Juda qimmat","note":"Savdolashganda koʻp aytiladi.","ex":"مِئَةُ دُولَارٍ؟ غَالٍ جِدًّا!","exUz":"Yuz dollarmi? Juda qimmat!"},{"ar":"أَيْنَ الحَمَّامُ؟","uz":"Hojatxona qayerda?","note":"Mehmonxona, restoran yoki maktabda kerakli savol.","ex":"عَفْوًا، أَيْنَ الحَمَّامُ؟","exUz":"Kechirasiz, hojatxona qayerda?"},{"ar":"أَنَا جَائِعٌ","uz":"Qornim och","note":"Ochlikni bildirishda aytiladi.","ex":"أَنَا جَائِعٌ جِدًّا، هَيَّا نَأْكُلُ!","exUz":"Qornim juda och, qani yeymiz!"},{"ar":"أَنَا عَطْشَانُ","uz":"Chanqadim","note":"Suv ichgisi kelganda aytiladi.","ex":"أَنَا عَطْشَانُ، أُرِيدُ مَاءً.","exUz":"Chanqadim, suv xohlayman."},{"ar":"بِالهَنَاءِ وَالشِّفَاءِ","uz":"Yoqimli ishtaha / Osh boʻlsin","note":"Ovqatlanayotgan odamga aytiladigan tilak.","ex":"هٰذَا طَعَامُكَ، بِالهَنَاءِ وَالشِّفَاءِ!","exUz":"Mana ovqating, osh boʻlsin!"},{"ar":"أَنَا تَعْبَانُ","uz":"Charchadim","note":"Charchoqni bildirishda kundalik nutqda koʻp ishlatiladi.","ex":"أَنَا تَعْبَانُ بَعْدَ التَّمْرِينِ.","exUz":"Mashgʻulotdan keyin charchadim."},{"ar":"تُصْبِحُ عَلَى خَيْرٍ","uz":"Xayrli tun","note":"Uxlashdan oldin xayrlashganda aytiladi.","ex":"تُصْبِحُ عَلَى خَيْرٍ يَا أَبِي!","exUz":"Xayrli tun, dadajon!"},{"ar":"وَأَنْتَ مِنْ أَهْلِهِ","uz":"Senga ham (javob)","note":"«Xayrli tun» tilagiga javoban aytiladi.","ex":"تُصْبِحُ عَلَى خَيْرٍ! وَأَنْتَ مِنْ أَهْلِهِ!","exUz":"Xayrli tun! Senga ham!"},{"ar":"مَا اسْمُكَ؟","uz":"Isming nima?","note":"Tanishuvda birinchi soʻraladigan savol.","ex":"مَا اسْمُكَ؟ اِسْمِي سَامِي.","exUz":"Isming nima? Ismim Somiy."},{"ar":"مِنْ أَيْنَ أَنْتَ؟","uz":"Qayerliksan?","note":"Kimningdir qayerdan ekanini soʻraganda ishlatiladi.","ex":"مِنْ أَيْنَ أَنْتَ يَا صَدِيقِي؟","exUz":"Qayerliksan, doʻstim?"},{"ar":"أَنَا مِنْ أُوزْبَكِسْتَانَ","uz":"Men Oʻzbekistondanman","note":"Oʻzingizni tanishtirishda kerak boʻladi.","ex":"أَنَا مِنْ أُوزْبَكِسْتَانَ، مِنْ مَدِينَةِ سَمَرْقَنْدَ.","exUz":"Men Oʻzbekistondanman, Samarqand shahridan."},{"ar":"أَتَكَلَّمُ العَرَبِيَّةَ قَلِيلًا","uz":"Arabchani biroz gapiraman","note":"Arab bilan suhbat boshlaganda foydali ibora.","ex":"عَفْوًا، أَتَكَلَّمُ العَرَبِيَّةَ قَلِيلًا.","exUz":"Kechirasiz, arabchani biroz gapiraman."},{"ar":"لَا أَفْهَمُ","uz":"Tushunmayapman","note":"Gap tushunarsiz boʻlganda aytiladi.","ex":"آسِفٌ، لَا أَفْهَمُ.","exUz":"Kechirasiz, tushunmayapman."},{"ar":"أَعِدْ مِنْ فَضْلِكَ","uz":"Iltimos, takrorlang","note":"Gapni qayta eshitmoqchi boʻlganda aytiladi.","ex":"لَمْ أَسْمَعْ، أَعِدْ مِنْ فَضْلِكَ.","exUz":"Eshitmadim, iltimos, takrorlang."},{"ar":"بِبُطْءٍ مِنْ فَضْلِكَ","uz":"Sekinroq, iltimos","note":"Suhbatdosh juda tez gapirganda soʻraladi.","ex":"تَكَلَّمْ بِبُطْءٍ مِنْ فَضْلِكَ.","exUz":"Iltimos, sekinroq gapiring."},{"ar":"مَاذَا يَعْنِي هٰذَا؟","uz":"Bu nimani anglatadi?","note":"Notanish soʻzning maʼnosini soʻraganda ishlatiladi.","ex":"مَاذَا يَعْنِي «مُمْتَاز»؟","exUz":"«Mumtoz» nimani anglatadi?"},{"ar":"كَيْفَ نَقُولُ بِالعَرَبِيَّةِ؟","uz":"Arabchada qanday aytiladi?","note":"Yangi soʻzni oʻrganishda juda foydali savol.","ex":"كَيْفَ نَقُولُ «olma» بِالعَرَبِيَّةِ؟ تُفَّاحَة.","exUz":"«Olma» arabchada qanday aytiladi? Tuffoha."},{"ar":"يَا لَيْتَ","uz":"Qaniydi","note":"Orzu yoki afsus bildirishda aytiladi.","ex":"يَا لَيْتَ اليَوْمَ عُطْلَةٌ!","exUz":"Qaniydi bugun dam olish kuni boʻlsa!"},{"ar":"لِلْأَسَفِ","uz":"Afsuski","note":"Yoqimsiz xabar aytishdan oldin ishlatiladi.","ex":"لِلْأَسَفِ، لَا أَسْتَطِيعُ الحُضُورَ.","exUz":"Afsuski, kela olmayman."},{"ar":"لِحُسْنِ الحَظِّ","uz":"Baxtimizga","note":"Omadli holat haqida gapirganda aytiladi.","ex":"لِحُسْنِ الحَظِّ، وَجَدْتُ مِفْتَاحِي.","exUz":"Baxtimga, kalitimni topdim."},{"ar":"أَخِيرًا","uz":"Nihoyat!","note":"Uzoq kutilgan narsa sodir boʻlganda aytiladi.","ex":"أَخِيرًا وَصَلْنَا!","exUz":"Nihoyat yetib keldik!"},{"ar":"حَقًّا؟","uz":"Rostdanmi?","note":"Hayratlanib yoki shubha bilan soʻraganda aytiladi.","ex":"نَجَحْتَ فِي الاِمْتِحَانِ؟ حَقًّا؟","exUz":"Imtihondan oʻtdingmi? Rostdanmi?"},{"ar":"لَا أُصَدِّقُ!","uz":"Ishonmayman!","note":"Juda hayratlanganda aytiladi.","ex":"لَا أُصَدِّقُ! هٰذَا رَائِعٌ!","exUz":"Ishonmayman! Bu ajoyib!"},{"ar":"كُلُّ شَيْءٍ تَمَامٌ","uz":"Hammasi joyida","note":"Vaziyat yaxshi ekanini bildirishda aytiladi.","ex":"لَا تَقْلَقْ، كُلُّ شَيْءٍ تَمَامٌ.","exUz":"Xavotir olma, hammasi joyida."},{"ar":"لَا تَقْلَقْ","uz":"Xavotir olma","note":"Kimnidir tinchlantirish uchun aytiladi.","ex":"لَا تَقْلَقْ، سَأُسَاعِدُكَ.","exUz":"Xavotir olma, senga yordam beraman."},{"ar":"أَنَا مَشْغُولٌ","uz":"Bandman","note":"Hozir vaqting yoʻqligini bildirishda aytiladi.","ex":"أَنَا مَشْغُولٌ الآنَ، أَتَّصِلُ بِكَ لَاحِقًا.","exUz":"Hozir bandman, keyinroq qoʻngʻiroq qilaman."},{"ar":"عِنْدِي فِكْرَةٌ","uz":"Bir gʻoyam bor","note":"Yangi taklif aytmoqchi boʻlganda ishlatiladi.","ex":"عِنْدِي فِكْرَةٌ: نَطْبُخُ مَعًا!","exUz":"Bir gʻoyam bor: birga ovqat pishiramiz!"},{"ar":"مَعَكَ حَقٌّ","uz":"Haqsan","note":"Suhbatdoshning fikriga qoʻshilganda aytiladi.","ex":"مَعَكَ حَقٌّ، الجَوُّ بَارِدٌ.","exUz":"Haqsan, havo sovuq."},{"ar":"نَلْتَقِي غَدًا","uz":"Ertaga koʻrishamiz","note":"Xayrlashganda keyingi uchrashuvni eslatib aytiladi.","ex":"نَلْتَقِي غَدًا فِي المَدْرَسَةِ.","exUz":"Ertaga maktabda koʻrishamiz."},{"ar":"اِشْتَقْتُ إِلَيْكَ","uz":"Seni sogʻindim","note":"Uzoq koʻrishmagan doʻst yoki qarindoshga aytiladi.","ex":"اِشْتَقْتُ إِلَيْكَ يَا جَدِّي!","exUz":"Sizni sogʻindim, bobojon!"},{"ar":"أَحْسَنْتَ!","uz":"Ofarin!","note":"Kimnidir yaxshi ishi uchun maqtaganda aytiladi.","ex":"أَحْسَنْتَ! جَوَابُكَ صَحِيحٌ.","exUz":"Ofarin! Javobing toʻgʻri."},{"ar":"يَا هَلَا","uz":"Xush kelibsan!","note":"Soʻzlashuv tilida (Xalij dialekti) iliq kutib olishda aytiladi.","ex":"يَا هَلَا يَا خَالِد!","exUz":"Xush kelibsan, Xolid!"},{"ar":"شُو الأَخْبَار؟","uz":"Nima gaplar?","note":"Soʻzlashuv tilida (Shom dialekti) doʻstlar orasida soʻraladi.","ex":"مَرْحَبًا! شُو الأَخْبَار؟","exUz":"Salom! Nima gaplar?"},{"ar":"عَادِي","uz":"Normal, oddiy","note":"Soʻzlashuvda «hechqisi yoʻq, odatiy» maʼnosida koʻp aytiladi.","ex":"كَيْفَ كَانَ اليَوْمُ؟ عَادِي.","exUz":"Kun qanday oʻtdi? Normal."},{"ar":"بَسّ","uz":"Faqat / Yetar","note":"Soʻzlashuv tilida (dialekt) «faqat» yoki «boʻldi» maʼnosida aytiladi.","ex":"أُرِيدُ شَايًا بَسّ.","exUz":"Faqat choy xohlayman."},{"ar":"مِيَّة مِيَّة","uz":"Yuz foiz!","note":"Soʻzlashuv tilida (dialekt) toʻliq ishonch yoki rozilik bildirishda aytiladi.","ex":"الخُطَّةُ مِيَّة مِيَّة!","exUz":"Reja yuz foiz zoʻr!"},{"ar":"الجَوُّ جَمِيلٌ","uz":"Havo ajoyib","note":"Ob-havo haqida suhbat boshlashda aytiladi.","ex":"الجَوُّ جَمِيلٌ اليَوْمَ، هَيَّا نَتَمَشَّى!","exUz":"Bugun havo ajoyib, qani sayr qilamiz!"},{"ar":"نَسِيتُ","uz":"Esimdan chiqdi","note":"Biror narsani unutganda aytiladi.","ex":"آسِفٌ، نَسِيتُ كِتَابِي فِي البَيْتِ.","exUz":"Kechirasiz, kitobimni uyda unutibman."},{"ar":"تَعَالَ","uz":"Bu yoqqa kel","note":"Kimnidir chaqirganda aytiladi (qiz bolaga: تَعَالَيْ).","ex":"تَعَالَ وَاجْلِسْ مَعَنَا!","exUz":"Kel, biz bilan oʻtir!"}]