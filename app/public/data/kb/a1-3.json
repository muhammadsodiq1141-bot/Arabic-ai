{"title":"3-vahda · Oʻqish va taʼlim","uz":"Maktab, institut, darslar; koʻplik (الْجَمْعُ), هَؤُلَاءِ, koʻplik olmoshlari","a1":3,"book":"Al-Manhaj · A1","steps":[{"k":"lugat","t":"Lugʻat · الْمُفْرَدَاتُ وَالتَّرَاكِيبُ","ar":"الْمُفْرَدَاتُ وَالتَّرَاكِيبُ","d":"18 soʻz va 6 ibora: oʻqish","items":[{"type":"intro","ins":"اسْتَمِعْ وَكَرِّرْ","words":[["صَفٌّ","sinf"],["نَشِيطٌ","faol, gʻayratli"],["يَقْرَأُ","📖 oʻqiydi"],["مَكْتَبَةٌ","📚 kutubxona"],["ذَكِيٌّ","aqlli"],["دَرْسٌ","dars"],["مَدْرَسَةٌ","🏫 maktab"],["كَسْلَانُ","dangasa"],["مُعْجَمٌ","lugʻat (kitob)"],["كُلِّيَّةٌ","fakultet"],["مَوْعِدٌ","📅 belgilangan vaqt"],["مَقْصِفٌ","bufet (oʻquv joyida)"],["جَامِعَةٌ","🎓 universitet"],["قَلِقٌ","😟 xavotirda"],["يَنْتَهِي","🏁 tugaydi"],["مَعْهَدُ اللُّغَاتِ","tillar instituti"],["امْتِحَانٌ","📝 imtihon"],["يَبْدَأُ","boshlanadi"]]},{"type":"intro","ins":"اسْتَمِعْ وَكَرِّرْ","words":[["وَقْتُ الِاسْتِرَاحَةِ","tanaffus vaqti"],["أَيَّامُ الْأُسْبُوعِ","hafta kunlari"],["دَرَجَةٌ عَالِيَةٌ","yuqori baho"],["أَحْيَانًا","baʼzan"],["بِالتَّوْفِيقِ","omad tilayman"],["حَصَلَ عَلَى","…ni oldi, …ga erishdi"]]},{"type":"pick","ar":"مَكْتَبَةٌ","ok":"📚","pool":["📚","📝","😟","🎓","🏫","📖","📅","🏁"]},{"type":"pick","ar":"امْتِحَانٌ","ok":"📝","pool":["📚","📝","😟","🎓","🏫","📖","📅","🏁"]},{"type":"pick","ar":"قَلِقٌ","ok":"😟","pool":["📚","📝","😟","🎓","🏫","📖","📅","🏁"]},{"type":"listen1","ar":"مُعْجَمٌ","opts":["Lugʻat (kitob)","Kutubxona","Sinf"],"ok":"Lugʻat (kitob)"},{"type":"listen1","ar":"بِالتَّوْفِيقِ","opts":["Omad tilayman","Baʼzan","Tanaffus vaqti"],"ok":"Omad tilayman"},{"type":"choose","q":"«Dangasa» arabcha qanday?","opts":["كَسْلَانُ","نَشِيطٌ","ذَكِيٌّ"],"ok":"كَسْلَانُ","why":"كَسْلَانُ — dangasa; uning ziddi — نَشِيطٌ (faol)."}]},{"k":"lmashq1","t":"Lugʻat mashqlari · تَدْرِيبَاتُ الْمُفْرَدَاتِ","ar":"ضَعْ رَقْمَ الْكَلِمَةِ أَمَامَ الصُّورَةِ الْمُنَاسِبَةِ","d":"Soʻzni rasm bilan topish","items":[{"type":"pick","ins":"ضَعْ رَقْمَ الْكَلِمَةِ أَمَامَ الصُّورَةِ الْ