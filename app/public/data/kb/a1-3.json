فٌّ — نَشِيطٌ — ذَكِيٌّ — كَسْلَانُ","qz":"Boshqalaridan farq qiladigan soʻzni tanlang","opts":["صَفٌّ","نَشِيطٌ","ذَكِيٌّ","كَسْلَانُ"],"ok":"صَفٌّ","why":"صَفٌّ — sinf (joy); qolganlari sifatlar."},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ الْمُخْتَلِفَةَ","q":"عَدَدٌ: الْأُولَى — الثَّانِيَةُ — الثَّالِثَةُ — الرَّبِيعُ","qz":"Boshqalaridan farq qiladigan soʻzni tanlang","opts":["الْأُولَى","الثَّانِيَةُ","الثَّالِثَةُ","الرَّبِيعُ"],"ok":"الرَّبِيعُ","why":"الرَّبِيعُ — bahor; qolganlari tartib sonlar."},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِالضِّدِّ","q":"Har bir soʻzni zid maʼnolisi bilan ulang","pairs":[["تَذْهَبُ","تَرْجِعُ"],["أَحْيَانًا","دَائِمًا"],["يَبْدَأُ","يَنْتَهِي"],["صَبَاحًا","مَسَاءً"],["قَصِيرَةٌ","طَوِيلَةٌ"]]},{"type":"match","ins":"صِلْ بَيْنَ الْمُفْرَدِ وَالْجَمْعِ","q":"Birlikni koʻplik bilan ulang","pairs":[["مَكْتَبَةٌ","مَكْتَبَاتٌ"],["لُغَةٌ","لُغَاتٌ"],["أُسْبُوعٌ","أَسَابِيعُ"],["سُؤَالٌ","أَسْئِلَةٌ"],["دَرْسٌ","دُرُوسٌ"]]}]},{"k":"oqish1","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ","ar":"مَاذَا تَدْرُسِينَ؟","d":"1-matn: Shaymo tillar institutida","items":[{"type":"read","ins":"اقْرَأِ النَّصَّ","title":"مَاذَا تَدْرُسِينَ؟","lines":[["أَسْمَاءُ","أَيْنَ تَذْهَبِينَ يَا شَيْمَاءُ؟","Qayerga ketyapsan, Shaymo?"],["شَيْمَاءُ","سَأَذْهَبُ إِلَى مَعْهَدِ اللُّغَاتِ.","Tillar institutiga ketyapman."],["أَسْمَاءُ","مَاذَا تَدْرُسِينَ؟","Nima oʻqiyapsan?"],["شَيْمَاءُ","أَدْرُسُ اللُّغَةَ الْعَرَبِيَّةَ مَعَ مُعَلِّمَةٍ عَرَبِيَّةٍ.","Arab ustoz (ayol) bilan arab tilini oʻqiyapman."],["أَسْمَاءُ","لِمَاذَا تَدْرُسِينَ اللُّغَةَ الْعَرَبِيَّةَ؟","Nega arab tilini oʻqiyapsan?"],["شَيْمَاءُ","لِأَنَّ اللُّغَةَ الْعَرَبِيَّةَ لُغَةٌ جَمِيلَةٌ.","Chunki arab tili — goʻzal til."],["أَسْمَاءُ","كَمْ يَوْمًا تَدْرُسِينَ؟","Necha kun oʻqiysan?"],["شَيْمَاءُ","أَدْرُسُ ثَلَاثَةَ أَيَّامٍ فِي الْأُسْبُوعِ، وَأَرْبَعَ سَاعَاتٍ فِي الْيَوْمِ.","Haftada uch kun, kuniga toʻrt soat oʻqiyman."],["أَسْمَاءُ","هَلْ لَدَيْكِ وَقْتُ اسْتِرَاحَةٍ بَيْنَ الدُّرُوسِ؟","Darslar orasida tanaffusing bormi?"],["شَيْمَاءُ","نَعَمْ، لَدَيَّ اسْتِرَاحَتَانِ: اسْتِرَاحَةٌ قَصِيرَةٌ، وَاسْتِرَاحَةٌ طَوِيلَةٌ.","Ha, ikkita tanaffusim bor: qisqa va uzun."],["أَسْمَاءُ","وَمَاذَا تَفْعَلِينَ فِي الِاسْتِرَاحَةِ؟","Tanaffusda nima qilasan?"],["شَيْمَاءُ","فِي الِاسْتِرَاحَةِ الْأُولَى أَذْهَبُ إِلَى الْمَقْصِفِ وَأَتَنَاوَلُ الشَّايَ مَعَ صَدِيقَاتِي، وَأَحْيَانًا أَذْهَبُ إِلَى الْمَكْتَبَةِ لِأَقْرَأَ فِي الْمُعْجَمِ،","Birinchi tanaffusda bufetga borib, dugonalarim bilan choy ichaman, baʼzan esa lugʻat oʻqish uchun kutubxonaga boraman,"],["شَيْمَاءُ","وَفِي الِاسْتِرَاحَةِ الثَّانِيَةِ أَذْهَبُ إِلَى الْحَدِيقَةِ، ثُمَّ أَتَنَاوَلُ طَعَامَ الْغَدَاءِ فِي الْمَعْهَدِ.","ikkinchi tanaffusda bogʻga boraman, keyin institutda tushlik qilaman."],["أَسْمَاءُ","وَمَتَى تَنْتَهِي الدُّرُوسُ؟","Darslar qachon tugaydi?"],["شَيْمَاءُ","تَنْتَهِي فِي السَّاعَةِ الثَّانِيَةِ ظُهْرًا.","Kunduzi soat ikkida tugaydi."],["أَسْمَاءُ","بِالتَّوْفِيقِ يَا صَدِيقَتِي.","Omad senga, dugonajon."],["شَيْمَاءُ","شُكْرًا لَكِ.","Rahmat senga."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"سَتَذْهَبُ شَيْمَاءُ إِلَى ………","qz":"Toʻgʻri javobni tanlang","opts":["الْمَدْرَسَةِ","الْبَيْتِ","مَعْهَدِ اللُّغَاتِ"],"ok":"مَعْهَدِ اللُّغَاتِ","full":"سَتَذْهَبُ شَيْمَاءُ إِلَى مَعْهَدِ اللُّغَاتِ.","fz":"Shaymo tillar institutiga boradi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"تَدْرُسُ شَيْمَاءُ ……… أَيَّامٍ فِي الْأُسْبُوعِ.","qz":"Toʻgʻri javobni tanlang","opts":["ثَلَاثَةَ","أَرْبَعَةَ","خَمْسَةَ"],"ok":"ثَلَاثَةَ","full":"تَدْرُسُ شَيْمَاءُ ثَلَاثَةَ أَيَّامٍ فِي الْأُسْبُوعِ.","fz":"Shaymo haftada uch kun oʻqiydi.","why":"Uch kun; «toʻrt» — kunlik soatlar soni."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"تَذْهَبُ شَيْمَاءُ إِلَى الْمَكْتَبَةِ ………","qz":"Toʻgʻri javobni tanlang","opts":["قَبْلَ الدَّرْسِ","بَعْدَ الدَّرْسِ","فِي الِاسْتِرَاحَةِ"],"ok":"فِي الِاسْتِرَاحَةِ","full":"تَذْهَبُ شَيْمَاءُ إِلَى الْمَكْتَبَةِ فِي الِاسْتِرَاحَةِ.","fz":"Shaymo kutubxonaga tanaffusda boradi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"تَنْتَهِي دُرُوسُ شَيْمَاءَ فِي السَّاعَةِ ………","qz":"Toʻgʻri javobni tanlang","opts":["الْوَاحِدَةِ","الثَّانِيَةِ","الثَّالِثَةِ"],"ok":"الثَّانِيَةِ","full":"تَنْتَهِي دُرُوسُ شَيْمَاءَ فِي السَّاعَةِ الثَّانِيَةِ.","fz":"Shaymoning darslari soat ikkida tugaydi."},{"type":"tf","ins":"ضَعْ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","s":"شَيْمَاءُ لَدَيْهَا اسْتِرَاحَةٌ وَاحِدَةٌ.","uz":"Shaymoning bitta tanaffusi bor.","ok":false,"why":"Matnda: «لَدَيَّ اسْتِرَاحَتَانِ» — ikkita tanaffus."},{"type":"tf","ins":"ضَعْ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","s":"تَدْرُسُ شَيْمَاءُ مَعَ مُعَلِّمَةٍ عَرَبِيَّةٍ.","uz":"Shaymo arab ustoz (ayol) bilan oʻqiydi.","ok":true},{"type":"tf","ins":"ضَعْ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","s":"تَتَنَاوَلُ شَيْمَاءُ الشَّايَ فِي الِاسْتِرَاحَةِ مَعَ صَدِيقَاتِهَا.","uz":"Shaymo tanaffusda dugonalari bilan choy ichadi.","ok":true},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"لِمَاذَا تَدْرُسُ شَيْمَاءُ اللُّغَةَ الْعَرَبِيَّةَ؟","qz":"Mos javobni tanlang","opts":["لِأَنَّ اللُّغَةَ الْعَرَبِيَّةَ لُغَةٌ جَمِيلَةٌ.","لِتَقْرَأَ فِي الْمُعْجَمِ.","أَرْبَعَ سَاعَاتٍ فِي الْيَوْمِ."],"ok":"لِأَنَّ اللُّغَةَ الْعَرَبِيَّةَ لُغَةٌ جَمِيلَةٌ."},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"لِمَاذَا تَذْهَبُ شَيْمَاءُ إِلَى الْمَكْتَبَةِ؟","qz":"Mos javobni tanlang","opts":["لِأَنَّ اللُّغَةَ الْعَرَبِيَّةَ لُغَةٌ جَمِيلَةٌ.","لِتَقْرَأَ فِي الْمُعْجَمِ.","أَرْبَعَ سَاعَاتٍ فِي الْيَوْمِ."],"ok":"لِتَقْرَأَ فِي الْمُعْجَمِ."},{"type":"match","ins":"صِلِ الصُّورَةَ بِاسْمِ الْمَادَّةِ","q":"Rasmni fan nomi bilan ulang","pairs":[["💻","الْحَاسُوبُ"],["ABC","اللُّغَةُ الْإِنْجِلِيزِيَّةُ"],["📐","الرِّيَاضِيَّاتُ"],["🎨","الرَّسْمُ"],["🔬","الْعُلُومُ"],["أ ب ت","اللُّغَةُ الْعَرَبِيَّةُ"]]},{"type":"letters","ins":"امْلَأِ الْمُرَبَّعَاتِ بِأَسْمَاءِ الصُّوَرِ","q":"Rasm nomini harflardan yozing","show":"حَقِيبَةٌ","letters":["حَ","قِ","ي","بَ","ةٌ"],"uz":"sumka","pic":"🎒"}]},{"k":"oqish2","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ","ar":"لَدَيَّ خَمْسَةُ أَوْلَادٍ","d":"2-matn: besh farzandli ona","items":[{"type":"read","ins":"اقْرَأِ النَّصَّ","title":"لَدَيَّ خَمْسَةُ أَوْلَادٍ","lines":[["","أَنَا رَبَّةُ بَيْتٍ، أَعِيشُ فِي الْأُرْدُنِّ، وَلَدَيَّ خَمْسَةُ أَوْلَادٍ:","Men uy bekasiman, Iordaniyada yashayman, besh farzandim bor:"],["","ابْنِي الْأَوَّلُ يَدْرُسُ فِي أَمْرِيكَا فِي كُلِّيَّةِ الْهَنْدَسَةِ فِي السَّنَةِ الثَّالِثَةِ، هُوَ ذَكِيٌّ جِدًّا وَيُحِبُّ السَّفَرَ.","Birinchi oʻgʻlim Amerikada, muhandislik fakultetining uchinchi kursida oʻqiydi; u juda aqlli va sayohatni yaxshi koʻradi."],["","وَابْنِي الثَّانِي يَدْرُسُ فِي مِصْرَ، فِي السَّنَةِ الثَّانِيَةِ، هُوَ مُجْتَهِدٌ وَيُحِبُّ الْقِرَاءَةَ، وَيَشْتَرِي كَثِيرًا مِنَ الْكُتُبِ.","Ikkinchi oʻgʻlim Misrda, ikkinchi kursda oʻqiydi; u tirishqoq, kitob oʻqishni yaxshi koʻradi va koʻp kitob sotib oladi."],["","ابْنِي الثَّالِثُ يَدْرُسُ فِي الْمَدْرَسَةِ الثَّانَوِيَّةِ، هُوَ نَشِيطٌ وَيُحِبُّ كِتَابَةَ الْقِصَصِ.","Uchinchi oʻgʻlim yuqori sinflarda (sanaviya) oʻqiydi; u gʻayratli va hikoya yozishni yaxshi koʻradi."],["","أَمَّا الِابْنُ الرَّابِعُ فَيَدْرُسُ فِي الْمَدْرَسَةِ الْمُتَوَسِّطَةِ، لَكِنْ لَدَيْهِ مُشْكِلَةٌ، هُوَ كَسْلَانُ، لَا يُحِبُّ الدِّرَاسَةَ،","Toʻrtinchi oʻgʻlim esa oʻrta sinflarda oʻqiydi, lekin uning muammosi bor: u dangasa, oʻqishni yoqtirmaydi,"],["","وَلَا يُرِيدُ أَنْ يَذْهَبَ إِلَى الْمَدْرَسَةِ، يُحِبُّ اللَّعِبَ وَمُشَاهَدَةَ التِّلْفَازِ، وَيُرِيدُ أَنْ يَكُونَ لَاعِبًا فِي الْمُسْتَقْبَلِ.","maktabga borishni istamaydi; oʻyin va televizor koʻrishni yaxshi koʻradi, kelajakda oʻyinchi boʻlmoqchi."],["","وَلَدَيَّ بِنْتٌ صَغِيرَةٌ عُمْرُهَا سَبْعُ سَنَوَاتٍ، وَتَدْرُسُ فِي الْمَدْرَسَةِ الِابْتِدَائِيَّةِ، هِيَ مَرِحَةٌ وَتُحِبُّ الرَّسْمَ.","Yetti yoshli kichkina qizim ham bor, boshlangʻich maktabda oʻqiydi; u quvnoq va rasm chizishni yaxshi koʻradi."],["","أُحِبُّ أَوْلَادِي كَثِيرًا.","Farzandlarimni juda yaxshi koʻraman."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"يَدْرُسُ الِابْنُ الْأَكْبَرُ فِي كُلِّيَّةِ ………","qz":"Toʻgʻri javobni tanlang","opts":["الْأَدَبِ","الطِّبِّ","الْهَنْدَسَةِ"],"ok":"الْهَنْدَسَةِ","full":"يَدْرُسُ الِابْنُ الْأَكْبَرُ فِي كُلِّيَّةِ الْهَنْدَسَةِ.","fz":"Katta oʻgʻil muhandislik fakultetida oʻqiydi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"تُحِبُّ الطِّفْلَةُ الصَّغِيرَةُ ………","qz":"Toʻgʻri javobni tanlang","opts":["الرَّسْمَ","الْقِرَاءَةَ","اللَّعِبَ"],"ok":"الرَّسْمَ","full":"تُحِبُّ الطِّفْلَةُ الصَّغِيرَةُ الرَّسْمَ.","fz":"Kichkina qiz rasm chizishni yaxshi koʻradi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"يُرِيدُ الِابْنُ الْأَصْغَرُ أَنْ يَكُونَ ………","qz":"Toʻgʻri javobni tanlang","opts":["طَبِيبًا","لَاعِبًا","طَيَّارًا"],"ok":"لَاعِبًا","full":"يُرِيدُ الِابْنُ الْأَصْغَرُ أَنْ يَكُونَ لَاعِبًا.","fz":"Kichik oʻgʻil oʻyinchi boʻlmoqchi.","why":"Toʻrtinchi (eng kichik) oʻgʻil: «يُرِيدُ أَنْ يَكُونَ لَاعِبًا»."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"هُنَاكَ مُشْكِلَةٌ لَدَى الِابْنِ ………","qz":"Toʻgʻri javobni tanlang","opts":["الثَّانِي","الثَّالِثِ","الرَّابِعِ"],"ok":"الرَّابِعِ","full":"هُنَاكَ مُشْكِلَةٌ لَدَى الِابْنِ الرَّابِعِ.","fz":"Muammo toʻrtinchi oʻgʻilda.","why":"U dangasa va oʻqishni yoqtirmaydi."},{"type":"tf","ins":"ضَعْ ✓ أَوْ ✗","s":"يَعِيشُ الِابْنُ الْأَكْبَرُ فِي أَمْرِيكَا.","uz":"Katta oʻgʻil Amerikada yashaydi.","ok":true,"why":"U Amerikada oʻqiydi."},{"type":"tf","ins":"ضَعْ ✓ أَوْ ✗","s":"الْأُمُّ لَدَيْهَا أَرْبَعُ بَنَاتٍ وَابْنٌ وَاحِدٌ.","uz":"Onaning toʻrt qizi va bitta oʻgʻli bor.","ok":false,"why":"Aksincha: toʻrt oʻgʻil va bitta qiz."},{"type":"tf","ins":"ضَعْ ✓ أَوْ ✗","s":"تَعِيشُ الْأُسْرَةُ جَمِيعًا فِي مَكَانٍ وَاحِدٍ.","uz":"Butun oila bir joyda yashaydi.","ok":false,"why":"Birinchi oʻgʻil — Amerikada, ikkinchisi — Misrda."},{"type":"order","ins":"رَتِّبِ الْمَرَاحِلَ التَّعْلِيمِيَّةَ تَرْتِيبًا تَصَاعُدِيًّا","uz":"«رَوْضَةُ الْأَطْفَالِ» (bogʻcha)dan keyingi taʼlim bosqichlarini pastdan yuqoriga tartiblang","words":["الثَّانَوِيَّةُ","الْجَامِعِيَّةُ","الِابْتِدَائِيَّةُ","الْمُتَوَسِّطَةُ"],"ok":"الِابْتِدَائِيَّةُ الْمُتَوَسِّطَةُ الثَّانَوِيَّةُ الْجَامِعِيَّةُ"},{"type":"match","ins":"صِلْ بَيْنَ الِابْنِ وَصِفَتِهِ","q":"Farzandni sifati bilan ulang","pairs":[["الِابْنُ الْأَوَّلُ","ذَكِيٌّ وَيُحِبُّ السَّفَرَ"],["الِابْنُ الثَّانِي","مُجْتَهِدٌ وَيُحِبُّ الْقِرَاءَةَ"],["الِابْنُ الثَّالِثُ","نَشِيطٌ وَيُحِبُّ الْكِتَابَةَ"],["الِابْنُ الرَّابِعُ","كَسْلَانُ وَيُحِبُّ اللَّعِبَ"],["الْبِنْتُ الْخَامِسَةُ","مَرِحَةٌ وَتُحِبُّ الرَّسْمَ"]]},{"type":"choose","ins":"ضَعِ الْكَلِمَةَ الْمُنَاسِبَةَ فِي الْفَرَاغِ","q":"صَدِيقِي ……… لَا يُحِبُّ الدِّرَاسَةَ.","qz":"Boʻsh joyni toʻldiring","opts":["الْوَاجِبَ","الِابْتِدَائِيَّةِ","كُلِّيَّةِ","مُشْكِلَةٌ","كَسْلَانُ"],"ok":"كَسْلَانُ","full":"صَدِيقِي كَسْلَانُ لَا يُحِبُّ الدِّرَاسَةَ.","fz":"Doʻstim dangasa, oʻqishni yoqtirmaydi."},{"type":"choose","ins":"اخْتَرْ حَرْفَ الْجَرِّ الْمُنَاسِبَ","q":"ذَهَبْتُ ……… الْمَقْصِفِ.","qz":"Mos predlogni tanlang","opts":["فِي","إِلَى","مِنْ","لِـ","عَلَى"],"ok":"إِلَى","full":"ذَهَبْتُ إِلَى الْمَقْصِفِ.","fz":"Bufetga bordim.","why":"Biror joyga borish — إِلَى."}]},{"k":"suhbat","t":"Suhbat · الْمُحَادَثَةُ","ar":"الدِّرَاسَةُ وَالتَّعْلِيمُ","d":"Oʻqish haqida savollar va namunalar","items":[{"type":"read","ins":"اقْرَأْ وَتَحَدَّثْ","title":"الْأَسْئِلَةُ","lines":[["","هَلْ أَنْتَ طَالِبٌ؟","Siz talabamisiz?"],["","فِي أَيِّ مَدْرَسَةٍ أَوْ جَامِعَةٍ تَدْرُسُ؟","Qaysi maktab yoki universitetda oʻqiysiz?"],["","فِي أَيِّ صَفٍّ أَوْ سَنَةٍ دِرَاسِيَّةٍ أَنْتَ؟","Qaysi sinf yoki kursdasiz?"],["","مَا مَادَّتُكَ الْمُفَضَّلَةُ؟","Sevimli faningiz qaysi?"],["","هَلْ تُحِبُّ الدِّرَاسَةَ؟","Oʻqishni yoqtirasizmi?"],["","كَمْ سَاعَةً تَدْرُسُ كُلَّ يَوْمٍ؟","Har kuni necha soat dars qilasiz?"],["","مَتَى تَبْدَأُ دُرُوسُكَ؟","Darslaringiz qachon boshlanadi?"],["","مَنْ هُوَ مُعَلِّمُكَ الْمُفَضَّلُ؟","Sevimli ustozingiz kim?"],["","مَا أَصْعَبُ مَادَّةٍ بِالنِّسْبَةِ لَكَ؟","Siz uchun eng qiyin fan qaysi?"],["","مَاذَا تُرِيدُ أَنْ تُصْبِحَ فِي الْمُسْتَقْبَلِ؟","Kelajakda kim boʻlishni xohlaysiz?"]]},{"type":"read","ins":"تَحَدَّثْ كَمَا فِي النَّمُوذَجِ","title":"النَّمُوذَجُ","lines":[["","أُرِيدُ أَنْ أَكُونَ مُعَلِّمًا فِي الْمُسْتَقْبَلِ.","Kelajakda oʻqituvchi boʻlishni xohlayman."],["","أُرِيدُ أَنْ أَكُونَ تَاجِرًا فِي الْمُسْتَقْبَلِ.","Kelajakda savdogar boʻlishni xohlayman."],["","مَاذَا تَفْعَلُ فِي الْبَيْتِ؟","Uyda nima qilasan?"],["","مَاذَا تَفْعَلُ فِي الِاسْتِرَاحَةِ؟","Tanaffusda nima qilasan?"],["","شَرِبْتُ كَثِيرًا مِنَ الْمَاءِ.","Koʻp suv ichdim."],["","اشْتَرَيْتُ كَثِيرًا مِنَ الْكُتُبِ.","Koʻp kitob sotib oldim."],["","أَشْرَبُ الْقَهْوَةَ أَحْيَانًا.","Baʼzan qahva ichaman."],["","أَشْرَبُ الْمَاءَ دَائِمًا.","Doim suv ichaman."]]},{"type":"choose","q":"«Siz talabamisiz?» arabcha qanday?","opts":["هَلْ أَنْتَ طَالِبٌ؟","هَلْ تُحِبُّ الدِّرَاسَةَ؟","مَا مَادَّتُكَ الْمُفَضَّلَةُ؟"],"ok":"هَلْ أَنْتَ طَالِبٌ؟","why":"هَلْ — «-mi?» soʻroq yuklamasi: هَلْ أَنْتَ طَالِبٌ؟"},{"type":"listen1","ar":"مَتَى تَبْدَأُ دُرُوسُكَ؟","opts":["Darslaringiz qachon boshlanadi?","Darslaringiz qachon tugaydi?","Har kuni necha soat oʻqiysiz?"],"ok":"Darslaringiz qachon boshlanadi?"},{"type":"choose","q":"أُرِيدُ أَنْ ……… طَبِيبًا فِي الْمُسْتَقْبَلِ.","qz":"Namunadagidek toʻldiring","opts":["أَكُونَ","أَشْرَبُ","أَدْرُسُ"],"ok":"أَكُونَ","full":"أُرِيدُ أَنْ أَكُونَ طَبِيبًا فِي الْمُسْتَقْبَلِ.","fz":"Kelajakda shifokor boʻlishni xohlayman."},{"type":"free","ins":"تَحَدَّثْ كَمَا فِي النَّمُوذَجِ","q":"Oʻqishingiz haqidagi savollarga arabcha javob bering va har bir namunaga (أُرِيدُ أَنْ أَكُونَ، مَاذَا تَفْعَلُ فِي، كَثِيرًا مِنْ، أَحْيَانًا / دَائِمًا) oʻzingizdan bittadan gap tuzing (yozing yoki ovozli yuboring).","hint":"أَدْرُسُ فِي ... — أُرِيدُ أَنْ أَكُونَ ... ف