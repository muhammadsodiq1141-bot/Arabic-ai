رِ الْكَلِمَةَ الْمُخْتَلِفَةَ","q":"خَالَةٌ — عَمَّةٌ — جَدَّةٌ — مُدِيرٌ","qz":"Boshqalaridan farq qiladigan soʻzni tanlang","opts":["خَالَةٌ","عَمَّةٌ","جَدَّةٌ","مُدِيرٌ"],"ok":"مُدِيرٌ","why":"مُدِيرٌ — kasb; qolganlari ayol qarindoshlar."},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ الْمُخْتَلِفَةَ","q":"أُسْرَةٌ — مُتَزَوِّجٌ — عَائِلَةٌ — أَقَارِبُ","qz":"Boshqalaridan farq qiladigan soʻzni tanlang","opts":["أُسْرَةٌ","مُتَزَوِّجٌ","عَائِلَةٌ","أَقَارِبُ"],"ok":"مُتَزَوِّجٌ","why":"مُتَزَوِّجٌ — sifat; qolganlari «oila, qarindoshlar» maʼnosida."},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ الْمُخْتَلِفَةَ","q":"مُتَقَاعِدٌ — يَعْمَلُ — يَدْرُسُ — يُحِبُّ","qz":"Boshqalaridan farq qiladigan soʻzni tanlang","opts":["مُتَقَاعِدٌ","يَعْمَلُ","يَدْرُسُ","يُحِبُّ"],"ok":"مُتَقَاعِدٌ","why":"مُتَقَاعِدٌ — ism; qolganlari feʼllar (يَـ bilan boshlanadi)."},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ الْمُخْتَلِفَةَ","q":"كَرِيمٌ — طَوِيلٌ — تَوْءَمٌ — سَمِينٌ","qz":"Boshqalaridan farq qiladigan soʻzni tanlang","opts":["كَرِيمٌ","طَوِيلٌ","تَوْءَمٌ","سَمِينٌ"],"ok":"تَوْءَمٌ","why":"تَوْءَمٌ — egizak; qolganlari sifatlar."},{"type":"classify","ins":"صَنِّفِ الْكَلِمَاتِ كَمَا فِي الْمِثَالِ","q":"Soʻzni bosing, keyin ustunini tanlang","cols":["مِهَنٌ","صِفَاتٌ","أَفْعَالٌ","أَقَارِبُ"],"words":[["طَبِيبٌ",0],["كَرِيمٌ",1],["يَدْرُسُ",2],["عَمٌّ",3],["مَرِحٌ",1],["جَدٌّ",3],["سَمِينٌ",1],["خَالَةٌ",3],["طَبَّاخٌ",0],["مُدِيرٌ",0],["حَنُونٌ",1],["شُرْطِيٌّ",0],["يُشْبِهُ",2],["عَمَّةٌ",3],["يَعْمَلُ",2]]},{"type":"match","ins":"صِلِ الْجُمْلَةَ بِمَا يُنَاسِبُهَا","q":"Har bir gapni davomi bilan ulang","pairs":[["أَبِي يَعْمَلُ","طَبِيبًا فِي الْمُسْتَشْفَى."],["أُمِّي لَا تَعْمَلُ،","هِيَ رَبَّةُ بَيْتٍ."],["أَزُورُ عَائِلَتِي","كُلَّ أُسْبُوعٍ."],["تَتَكَوَّنُ أُسْرَتِي","مِنْ خَمْسَةِ أَفْرَادٍ."]]}]},{"k":"oqish1","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ","ar":"هَذِهِ عَائِلَتِي","d":"1-matn: oila surati va mashqlar","items":[{"type":"read","ins":"اقْرَأِ النَّصَّ","title":"هَذِهِ عَائِلَتِي","lines":[["خَالِدٌ","هَلْ هَذِهِ صُورَةُ عَائِلَتِكَ؟","Bu sening oilangning suratimi?"],["مُحَمَّدٌ","نَعَمْ، هَذَا جَدِّي عُمَرُ، عُمْرُهُ سَبْعُونَ عَامًا، هُوَ مُتَقَاعِدٌ،","Ha, bu bobom Umar, u yetmish yoshda, nafaqada."],["مُحَمَّدٌ","وَهَذِهِ جَدَّتِي فَاطِمَةُ، عُمْرُهَا سِتُّونَ عَامًا، وَهِيَ رَبَّةُ بَيْتٍ.","Bu buvim Fotima, oltmish yoshda, u uy bekasi."],["مُحَمَّدٌ","وَهَذَا خَالِي فَهْمِي، يَعْمَلُ مُدِيرًا، وَهَذِهِ خَالَتِي أَمَلُ، وَتَعْمَلُ مُعَلِّمَةً.","Bu togʻam Fahmiy, direktor boʻlib ishlaydi; bu xolam Amal, oʻqituvchi boʻlib ishlaydi."],["مُحَمَّدٌ","وَهَذَا أَبِي حُسَيْنٌ، عُمْرُهُ خَمْسَةٌ وَثَلَاثُونَ عَامًا، وَيَعْمَلُ مُهَنْدِسًا، وَهَذِهِ أُمِّي، هِيَ رَبَّةُ بَيْتٍ.","Bu otam Husayn, oʻttiz besh yoshda, muhandis boʻlib ishlaydi; bu onam, u uy bekasi."],["خَالِدٌ","مَنْ هَذَا؟ يُشْبِهُ أَبَاكَ كَثِيرًا.","Bu kim? Otangga juda oʻxshar ekan."],["مُحَمَّدٌ","هَذَا عَمِّي حَسَنٌ، هُوَ تَوْءَمُ أَبِي، يَعْمَلُ طَبِيبًا،","Bu amakim Hasan, u otamning egizagi, shifokor boʻlib ishlaydi."],["مُحَمَّدٌ","وَهَذِهِ عَمَّتِي هُدَى، هِيَ مُمَرِّضَةٌ.","Bu ammam Hudo, u hamshira."],["خَالِدٌ","مَنْ هَذَانِ الطِّفْلَانِ؟","Bu ikki bola kim?"],["مُحَمَّدٌ","هَذَا أَخِي مَحْمُودٌ، عُمْرُهُ عَشْرُ سَنَوَاتٍ،","Bu ukam Mahmud, u oʻn yoshda."],["مُحَمَّدٌ","وَهَذِهِ أُخْتِي خَدِيجَةُ وَعُمْرُهَا ثَلَاثُ سَنَوَاتٍ.","Bu singlim Xadicha, u uch yoshda."],["خَالِدٌ","مُمْتَازٌ!","Ajoyib!"]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"تَعْمَلُ هُدَى فِي ………","qz":"Toʻgʻri javobni tanlang","opts":["الْمُسْتَشْفَى","الشَّرِكَةِ","الْمَدْرَسَةِ"],"ok":"الْمُسْتَشْفَى","full":"تَعْمَلُ هُدَى فِي الْمُسْتَشْفَى.","fz":"Hudo kasalxonada ishlaydi.","why":"Hudo — hamshira (مُمَرِّضَةٌ), hamshira kasalxonada ishlaydi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"أَمَلُ هِيَ ……… مُحَمَّدٍ.","qz":"Toʻgʻri javobni tanlang","opts":["جَدَّةُ","خَالَةُ","عَمَّةُ"],"ok":"خَالَةُ","full":"أَمَلُ هِيَ خَالَةُ مُحَمَّدٍ.","fz":"Amal — Muhammadning xolasi.","why":"«وَهَذِهِ خَالَتِي أَمَلُ»."},{"type":"tf","ins":"ضَعْ عَلَامَةَ (✓) أَوْ عَلَامَةَ (✗) بِحَسَبِ مَا قَرَأْتَ","s":"تَعْمَلُ الْأُمُّ مُعَلِّمَةً.","uz":"Ona oʻqituvchi boʻlib ishlaydi.","ok":false,"why":"Ona — uy bekasi (رَبَّةُ بَيْتٍ); oʻqituvchi — xola Amal."},{"type":"tf","ins":"ضَعْ عَلَامَةَ (✓) أَوْ عَلَامَةَ (✗) بِحَسَبِ مَا قَرَأْتَ","s":"الْعَمُّ عُمْرُهُ خَمْسَةٌ وَثَلَاثُونَ عَامًا.","uz":"Amaki oʻttiz besh yoshda.","ok":true,"why":"Amaki — otaning egizagi, ota esa 35 yoshda."},{"type":"tf","ins":"ضَعْ عَلَامَةَ (✓) أَوْ عَلَامَةَ (✗) بِحَسَبِ مَا قَرَأْتَ","s":"تَتَكَوَّنُ أُسْرَةُ مُحَمَّدٍ مِنْ أَرْبَعَةِ أَفْرَادٍ.","uz":"Muhammadning oilasi toʻrt kishidan iborat.","ok":false,"why":"Ota, ona, Muhammad, Mahmud va Xadicha — besh kishi."},{"type":"match","ins":"صِلْ بَيْنَ اللَّقَبِ وَالِاسْمِ وَالْعَمَلِ كَمَا فِي الْمِثَالِ","q":"Qarindoshni ismi bilan ulang","pairs":[["الْأَبُ","حُسَيْنٌ"],["الْعَمُّ","حَسَنٌ"],["الْعَمَّةُ","هُدَى"],["الْخَالُ","فَهْمِي"],["الْخَالَةُ","أَمَلُ"]]},{"type":"match","ins":"صِلْ بَيْنَ اللَّقَبِ وَالِاسْمِ وَالْعَمَلِ كَمَا فِي الْمِثَالِ","q":"Qarindoshni ishi bilan ulang","pairs":[["الْجَدُّ","مُتَقَاعِدٌ"],["الْأَبُ","مُهَنْدِسٌ"],["الْعَمُّ","طَبِيبٌ"],["الْعَمَّةُ","مُمَرِّضَةٌ"],["الْخَالُ","مُدِيرٌ"],["الْخَالَةُ","مُعَلِّمَةٌ"]]},{"type":"match","ins":"صِلْ بَيْنَ الْمُفْرَدِ وَالْجَمْعِ","q":"Birlikni koʻplik bilan ulang","pairs":[["أَبٌ","آبَاءٌ"],["أُمٌّ","أُمَّهَاتٌ"],["أَخٌ","إِخْوَةٌ"],["أُخْتٌ","أَخَوَاتٌ"],["فَرْدٌ","أَفْرَادٌ"]]},{"type":"match","ins":"صِلْ بَيْنَ السُّؤَالِ وَالْجَوَابِ","q":"Savolni javobi bilan ulang","pairs":[["كَمْ عُمْرُكَ؟","عُمْرِي ثَلَاثُونَ عَامًا."],["مِنْ أَيْنَ أَنْتَ؟","أَنَا مِنْ أَسْبَانِيَا."],["كَمْ فَرْدًا فِي أُسْرَتِكَ؟","فِي أُسْرَتِي خَمْسَةُ أَفْرَادٍ."],["مَاذَا يَعْمَلُ أَبُوكَ؟","أَبِي يَعْمَلُ طَبِيبًا."],["هَلْ لَكَ إِخْوَةٌ؟","نَعَمْ، لِي ثَلَاثَةُ إِخْوَةٍ."]]},{"type":"choose","ins":"ضَعِ الْكَلِمَةَ الْمُنَاسِبَةَ فِي الْفَرَاغِ","q":"أَبِي يَعْمَلُ ………","qz":"Boʻsh joyni toʻldiring","opts":["أَفْرَادٍ","مُجْتَهِدٌ","زِيَارَةِ","تَاجِرًا","مُتَقَاعِدٌ"],"ok":"تَاجِرًا","full":"أَبِي يَعْمَلُ تَاجِرًا.","fz":"Otam savdogar boʻlib ishlaydi.","why":"يَعْمَلُ dan keyin kasb ـًا bilan keladi: تَاجِرًا."},{"type":"choose","ins":"ضَعِ الْكَلِمَةَ الْمُنَاسِبَةَ فِي الْفَرَاغِ","q":"أَخِي طَالِبٌ ……… يَدْرُسُ فِي الْجَامِعَةِ.","qz":"Boʻsh joyni toʻldiring","opts":["أَفْرَادٍ","مُجْتَهِدٌ","زِيَارَةِ","تَاجِرًا","مُتَقَاعِدٌ"],"ok":"مُجْتَهِدٌ","full":"أَخِي طَالِبٌ مُجْتَهِدٌ يَدْرُسُ فِي الْجَامِعَةِ.","fz":"Akam tirishqoq talaba, universitetda oʻqiydi."}]},{"k":"oqish2","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ","ar":"أُحِبُّ أُسْرَتِي","d":"2-matn va oila shajarasi","items":[{"type":"read","ins":"اقْرَأِ النَّصَّ","title":"أُحِبُّ أُسْرَتِي","lines":[["","مَرْحَبًا بِكُمْ، اسْمِي عَائِشَةُ، عُمْرِي عِشْرُونَ عَامًا،","Xush kelibsizlar, ismim Oisha, yigirma yoshdaman."],["","أَنَا مِصْرِيَّةٌ، مِنْ مَدِينَةِ الْقَاهِرَةِ،","Men misrlikman, Qohira shahridan."],["","أُسْرَتِي تَتَكَوَّنُ مِنْ سِتَّةِ أَفْرَادٍ:","Oilam olti kishidan iborat:"],["","أَبِي اسْمُهُ خَالِدٌ، عُمْرُهُ خَمْسَةٌ وَخَمْسُونَ عَامًا، وَيَعْمَلُ تَاجِرًا، هُوَ لَطِيفٌ وَكَرِيمٌ،","Otamning ismi Xolid, ellik besh yoshda, savdogar boʻlib ishlaydi; u muloyim va saxiy."],["","أُمِّي اسْمُهَا سَاجِدَةُ، عُمْرُهَا خَمْسُونَ عَامًا، هِيَ رَبَّةُ بَيْتٍ، أُمِّي جَمِيلَةٌ وَحَنُونَةٌ.","Onamning ismi Sojida, ellik yoshda, uy bekasi; onam goʻzal va mehribon."],["","لِي أَخَوَانِ: الْكَبِيرُ اسْمُهُ عَادِلٌ، عُمْرُهُ سَبْعَةٌ وَعِشْرُونَ عَامًا،","Ikki akam-ukam bor: kattasining ismi Odil, yigirma yetti yoshda,"],["","هُوَ مُتَزَوِّجٌ، وَيَعْمَلُ مَعَ أَبِي، هُوَ طَوِيلٌ وَقَوِيٌّ.","u uylangan, otam bilan ishlaydi; u baland boʻyli va kuchli."],["","وَأَخِي الصَّغِيرُ اسْمُهُ إِبْرَاهِيمُ، طَالِبٌ فِي الْمَدْرَسَةِ، وَعُمْرُهُ خَمْسَةَ عَشَرَ عَامًا، هُوَ ذَكِيٌّ وَمُجْتَهِدٌ.","Kichik ukamning ismi Ibrohim, maktab oʻquvchisi, oʻn besh yoshda; u aqlli va tirishqoq."],["","وَلِي أُخْتٌ وَاحِدَةٌ اسْمُهَا زَيْنَبُ، عُمْرُهَا سَبْعَةَ عَشَرَ عَامًا، تَدْرُسُ فِي الْجَامِعَةِ،","Bitta singlim bor, ismi Zaynab, oʻn yetti yoshda, universitetda oʻqiydi;"],["","هِيَ مَرِحَةٌ وَمُبْتَسِمَةٌ، أَنَا أُحِبُّ أُسْرَتِي كَثِيرًا.","u quvnoq va doim jilmayib yuradi. Men oilamni juda yaxshi koʻraman."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"أُسْرَةُ عَائِشَةَ مِنْ ………","qz":"Toʻgʻri javobni tanlang","opts":["مِصْرَ","الْأُرْدُنِ","السُّودَانِ"],"ok":"مِصْرَ","full":"أُسْرَةُ عَائِشَةَ مِنْ مِصْرَ.","fz":"Oishaning oilasi Misrdan."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"يَعْمَلُ عَادِلٌ ………","qz":"Toʻgʻri javobni tanlang","opts":["مُعَلِّمًا","تَاجِرًا","طَبِيبًا"],"ok":"تَاجِرًا","full":"يَعْمَلُ عَادِلٌ تَاجِرًا.","fz":"Odil savdogar boʻlib ishlaydi.","why":"Odil otasi bilan ishlaydi (يَعْمَلُ مَعَ أَبِي), otasi esa savdogar."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"أَصْغَرُ أَفْرَادِ الْأُسْرَةِ ………","qz":"Toʻgʻri javobni tanlang","opts":["عَادِلٌ","إِبْرَاهِيمُ","زَيْنَبُ"],"ok":"إِبْرَاهِيمُ","full":"أَصْغَرُ أَفْرَادِ الْأُسْرَةِ إِبْرَاهِيمُ.","fz":"Oilaning eng kichigi — Ibrohim.","why":"Ibrohim — 15 yosh, Zaynab — 17, Odil — 27."},{"type":"tf","ins":"ضَعْ عَلَامَةَ (✓) أَوْ عَلَامَةَ (✗) بِحَسَبِ مَا قَرَأْتَ","s":"تَتَكَوَّنُ أُسْرَةُ عَائِشَةَ مِنْ خَمْسَةِ أَفْرَادٍ.","uz":"Oishaning oilasi besh kishidan iborat.","ok":false,"why":"Matnda: «مِنْ سِتَّةِ أَفْرَادٍ» — olti kishi."},{"type":"tf","ins":"ضَعْ عَلَامَةَ (✓) أَوْ عَلَامَةَ (✗) بِحَسَبِ مَا قَرَأْتَ","s":"الْأَبُ أَكْبَرُ مِنَ الْأُمِّ بِخَمْسِ سَنَوَاتٍ.","uz":"Ota onadan besh yosh katta.","ok":true,"why":"55 − 50 = 5."},{"type":"match","ins":"صِلْ بَيْنَ أَفْرَادِ الْأُسْرَةِ وَالِاسْمِ وَالصِّفَةِ كَمَا فِي الْمِثَالِ","q":"Oila aʼzosini sifati bilan ulang","pairs":[["الْأَبُ","كَرِيمٌ"],["الْأُمُّ","حَنُونَةٌ"],["الْأَخُ الْكَبِيرُ","قَوِيٌّ"],["الْأَخُ الصَّغِيرُ","ذَكِيٌّ"],["الْأُخْتُ","مَرِحَةٌ"]]},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِالضِّدِّ","q":"Har bir soʻzni zid maʼnolisi bilan ulang","pairs":[["مَرِحٌ","جَادٌّ"],["طَوِيلٌ","قَصِيرٌ"],["سَمِينٌ","نَحِيفٌ"],["مُتَزَوِّجٌ","عَزَبٌ"],["مُجْتَهِدٌ","كَسْلَانُ"]]},{"type":"read","ins":"اقْرَأِ الشَّكْلَ","title":"عَائِلَةُ صَالِحٍ","lines":[["","الزَّوْجُ: عَبْدُ اللهِ — الزَّوْجَةُ: هَاجَرُ","Er — Abdulloh, xotin — Hojar"],["","الْأَبْنَاءُ: شَادِيَةُ، إِبْرَاهِيمُ، مَاجِدٌ، عَبْلَةُ","Farzandlari: Shodiya, Ibrohim, Mojid, Abla"],["","إِخْوَةُ عَبْدِ اللهِ: طَارِقٌ، سُمَيَّةُ — أَبْنَاؤُهُمْ: أَسْمَاءُ، هَادِي","Abdullohning aka-uka, opa-singillari: Toriq, Sumayya; ularning farzandlari: Asmo, Hodiy"],["","إِخْوَةُ هَاجَرَ: عَاصِمٌ، سَنَاءُ — أَبْنَاؤُهُمْ: شَادِي، عَلْيَاءُ","Hojarning aka-uka, opa-singillari: Osim, Sano; ularning farzandlari: Shodiy, Alyo"],["","أَبْنَاءُ مَاجِدٍ: كَرِيمٌ، صَالِحٌ، هَنَاءُ","Mojidning farzandlari: Karim, Solih, Hano"]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ طِبْقًا لِلشَّكْلِ","q":"وَالِدُ كَرِيمٍ اسْمُهُ ………","qz":"Shajaraga qarab tanlang","opts":["عَبْدُ اللهِ","إِبْرَاهِيمُ","مَاجِدٌ"],"ok":"مَاجِدٌ","full":"وَالِدُ كَرِيمٍ اسْمُهُ مَاجِدٌ.","fz":"Karimning otasi — Mojid.","why":"Karim — Mojidning farzandi; Abdulloh — uning bobosi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ طِبْقًا لِلشَّكْلِ","q":"خَالَةُ مَاجِدٍ اسْمُهَا ………","qz":"Shajaraga qarab tanlang","opts":["سَنَاءُ","عَبْلَةُ","سُمَيَّةُ"],"ok":"سَنَاءُ","full":"خَالَةُ مَاجِدٍ اسْمُهَا سَنَاءُ.","fz":"Mojidning xolasi — Sano.","why":"Mojidning onasi — Hojar; Hojarning singlisi Sano — xola. Sumayya — amma (ota tomoni)."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ طِبْقًا لِلشَّكْلِ","q":"صَالِحٌ حَفِيدُ ………","qz":"Shajaraga qarab tanlang","opts":["شَادِيَةَ","هَاجَرَ","طَارِقٍ"],"ok":"هَاجَرَ","full":"صَالِحٌ حَفِيدُ هَاجَرَ.","fz":"Solih — Hojarning nevarasi.","why":"Solih — Mojidning oʻgʻli, Mojid — Hojarning oʻgʻli."}]},{"k":"suhbat","t":"Suhbat · الْمُحَادَثَةُ","ar":"الْأُسْرَةُ وَالْعَائِلَةُ","d":"Oila haqida savollar va iboralar","items":[{"type":"read","ins":"اقْرَأْ وَتَحَدَّثْ","title":"الْأَسْئِلَةُ","lines":[["","كَمْ عَدَدُ أَفْرَادِ أُسْرَتِكَ؟","Oilangiz necha kishidan iborat?"],["","هَلْ أُسْرَتُكَ كَبِيرَةٌ أَمْ صَغِيرَةٌ؟","Oilangiz kattami yoki kichik?"],["","مَا اسْمُ وَالِدِكَ؟","Otangizning ismi nima?"],["","مَا اسْمُ وَالِدَتِكَ؟","Onangizning ismi nima?"],["","مَاذَا يَعْمَلُ وَالِدُكَ؟","Otangiz nima ish qiladi?"],["","مَاذَا تَعْمَلُ وَالِدَتُكَ؟","Onangiz nima ish qiladi?"],["","هَلْ لَدَيْكَ إِخْوَةٌ؟","Aka-ukalaringiz bormi?"],["","هَلْ لَدَيْكَ أَخَوَاتٌ؟","Opa-singillaringiz bormi?"],["","مَنِ الْأَكْبَرُ فِي أُسْرَتِكَ؟","Oilangizda eng katta kim?"],["","مَنِ الْأَصْغَرُ فِي أُسْرَتِكَ؟","Oilangizda eng kichik kim?"]]},{"type":"read","ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ وَهَاتِ مِثْلَهَا مِنْ عِنْدِكَ","title":"تَعَابِيرُ","lines":[["أَنَا أُحِبُّ + اسْمٌ","أَنَا أُحِبُّ أُسْرَتِي كَثِيرًا.","Men oilamni juda yaxshi koʻraman."],["أَنَا أُحِبُّ + اسْمٌ","أَنَا أُحِبُّ أَصْدِقَائِي.","Men doʻstlarimni yaxshi koʻraman."],["تَتَكَوَّنُ مِنْ","أُسْرَتِي تَتَكَوَّنُ مِنْ خَمْسَةِ أَفْرَادٍ.","Oilam besh kishidan iborat."],["تَتَكَوَّنُ مِنْ","الْوَجْبَةُ تَتَكَوَّنُ مِنَ الرُّزِّ وَالسَّمَكِ.","Taom guruch va baliqdan iborat."],["أُحِبُّ أَنْ + فِعْلٌ","أُحِبُّ أَنْ أَتَنَاوَلَ طَعَامَ السَّمَكِ.","Baliq taomini yeyishni yoqtiraman."],["أُحِبُّ أَنْ + فِعْلٌ","أُحِبُّ أَنْ أُشَاهِدَ كُرَةَ الْقَدَمِ.","Futbol tomosha qilishni yoqtiraman."]]},{"type":"choose","q":"«Otangiz nima ish qiladi?» arabcha qanday?","opts":["مَاذَا يَعْمَلُ وَالِدُكَ؟","مَاذَا تَعْمَلُ وَالِدَتُكَ؟","مَا اسْمُ وَالِدِكَ؟"],"ok":"مَاذَا يَعْمَلُ وَالِدُكَ؟","why":"وَالِدٌ — ota, وَالِدَةٌ — ona; ota uchun يَعْمَلُ, ona uchun تَعْمَلُ."},{"type":"choose","q":"هَلْ لَدَيْكَ إِخْوَةٌ؟","qz":"Mos javobni tanlang","say":"هَلْ لَدَيْكَ إِخْوَةٌ؟","opts":["نَعَمْ، لِي ثَلَاثَةُ إِخْوَةٍ.","أَبِي يَعْمَلُ طَبِيبًا.","عُمْرِي ثَلَاثُونَ عَامًا."],"ok":"نَعَمْ، لِي ثَلَاثَةُ إِخْوَةٍ."},{"type":"choose","q":"كَمْ عَدَدُ أَفْرَادِ أُسْرَتِكَ؟","qz":"Mos javobni tanlang","say":"كَمْ عَدَدُ أَفْرَادِ أُسْرَتِكَ؟","opts":["أُسْرَتِي تَتَكَوَّنُ مِنْ خَمْسَةِ أَفْرَادٍ.","أَنَا أُحِبُّ أَصْدِقَائِي.","أَنَا مِنْ أَسْبَانِيَا."],"ok":"أُسْرَتِي تَتَكَوَّنُ مِنْ خَمْسَةِ أَفْرَادٍ."},{"type":"free","ins":"تَحَدَّثْ عَنْ أُسْرَتِكَ","q":"Oilangiz haqida savollarga arabcha javob bering va har bir iboraga (أُحِبُّ، تَتَكَوَّنُ مِنْ، أُحِبُّ أَنْ) oʻzingizdan bittadan misol keltiring (yozing yoki ovozli yuboring).","hint":"أُسْرَتِي تَتَكَوَّنُ مِنْ ... أَفْرَادٍ. أَبِي يَعْمَلُ ... أَنَا أُحِبُّ ... أُحِبُّ أَنْ ..."}]},{"k":"qoida1","t":"Qoida · الْمُثَنَّى وَاسْمُ الْإِشَارَةِ لَهُ","ar":"الِاسْمُ الْمُثَنَّى · هَذَانِ · هَاتَانِ","d":"Ikkilik shakli va ishora ismlari","rule":{"h":"الْمُثَنَّى  ·  هَذَانِ  ·  هَاتَانِ","p":["Ikkilik (<span class=\"ar\">الْمُثَنَّى</span>) — ikki kishi yoki ikki narsani bildiradi: birlik + <b>ـَانِ</b> yoki <b>ـَيْنِ</b>: <span class=\"ar\">كِتَابٌ ← كِتَابَانِ - كِتَابَيْنِ</span>.","<span class=\"ar\">ة</span> bilan tugagan soʻzda <span class=\"ar\">ة</span> → <span class=\"ar\">ت</span>: <span class=\"ar\">مَدْرَسَةٌ ← مَدْرَسَتَانِ</span>.","<span class=\"ar\">هَذَانِ</span> — muzakkar ikkilik uchun: <span class=\"ar\">هَذَانِ وَلَدَانِ</span>; <span class=\"ar\">هَاتَانِ</span> — muannas ikkilik uchun: <span class=\"ar\">هَاتَانِ بِنْتَانِ</span>.","Odamlar haqida <span class=\"ar\">مَنْ</span>, narsalar haqida <span class=\"ar\">مَا</span>: <span class=\"ar\">مَا هَذَانِ؟ — هَذَانِ قَلَمَانِ.</span>"]},"items":[{"type":"choose","ins":"لَاحِظِ الْأَمْثِلَةَ ثُمَّ أَكْمِلْ","q":"خَالٌ ← ………","qz":"Ikkilik (الْمُثَنَّى) shaklini tanlang","opts":["خَالَانِ","خَالَتَانِ","خَالَةٌ"],"ok":"خَالَانِ","why":"Toʻliq javob: خَالَانِ — خَالَيْنِ."},{"type":"choose","ins":"لَاحِظِ الْأَمْثِلَةَ ثُمَّ أَكْمِلْ","q":"خَالَةٌ ← ………","qz":"Ikkilik (الْمُثَنَّى) shaklini tanlang","opts":["خَالَتَانِ","خَالَةَانِ","خَالَانِ"],"ok":"خَالَتَانِ","why":"Toʻliq javob: خَالَتَانِ — خَالَتَيْنِ. ة → ت boʻladi."},{"type":"choose","ins":"لَاحِظِ الْأَمْثِلَةَ ثُمَّ أَكْمِلْ","q":"مَدِينَةٌ ← ………","qz":"Ikkilik (الْمُثَنَّى) shaklini tanlang","opts":["مَدِينَتَانِ","مَدِينَةَانِ","مَدِينَةٌ"],"ok":"مَدِينَتَانِ","why":"Toʻliq javob: مَدِينَتَانِ — مَدِينَتَيْنِ. ة → ت boʻladi."},{"type":"choose","ins":"حَوِّلِ الْأَسْمَاءَ الْآتِيَةَ إِلَى مُثَنًّى","q":"عَامٌ ← ………","qz":"Ikkilik (الْمُثَنَّى) shaklini tanlang","opts":["عَامَانِ","عَامَتَانِ","عَامٌ"],"ok":"عَامَانِ","why":"Toʻliq javob: عَامَانِ — عَامَيْنِ."},{"type":"choose","ins":"حَوِّلِ الْأَسْمَاءَ الْآتِيَةَ إِلَى مُثَنًّى","q":"صُورَةٌ ← ………","qz":"Ikkilik (الْمُثَنَّى) shaklini tanlang","opts":["صُورَتَانِ","صُورَةَانِ","صُورَةٌ"],"ok":"صُورَتَانِ","why":"Toʻliq javob: صُورَتَانِ — صُورَتَيْنِ. ة → ت boʻladi."},{"type":"choose","ins":"حَوِّلِ الْأَسْمَاءَ الْآتِيَةَ إِلَى مُثَنًّى","q":"الْأَوْسَطُ ← ………","qz":"Ikkilik (الْمُثَنَّى) shaklini tanlang","opts":["الْأَوْسَطَانِ","الْأَوْسَطَتَانِ","الْأَوْسَطُ"],"ok":"الْأَوْسَطَانِ","why":"Toʻliq javob: الْأَوْسَطَانِ — الْأَوْسَطَيْنِ."},{"type":"choose","ins":"لَاحِظْ وَأَكْمِلْ","q":"مَنْ ………؟ — ……… وَلَدَانِ.","qz":"هَذَانِ yoki هَاتَانِ?","opts":["هَذَانِ","هَاتَانِ"],"ok":"هَذَانِ","full":"مَنْ هَذَانِ؟ — هَذَانِ وَلَدَانِ.","fz":"Bular kim? — Bular ikki oʻgʻil bola.","why":"هَذَانِ — muzakkar ikkilik uchun: وَلَدَانِ.","pic":"👦👦"},{"type":"choose","ins":"لَاحِظْ وَأَكْمِلْ","q":"مَنْ ………؟ — ……… بِنْتَانِ.","qz":"هَذَانِ yoki هَاتَانِ?","opts":["هَذَانِ","هَاتَانِ"],"ok":"هَاتَانِ","full":"مَنْ هَاتَانِ؟ — هَاتَانِ بِنْتَانِ.","fz":"Bular kim? — Bular ikki qiz.","why":"هَاتَانِ — muannas ikkilik uchun: بِنْتَانِ (ـتَانِ).","pic":"👧👧"},{"type":"choose","ins":"اسْتَخْدِمْ (هَذَانِ / هَاتَانِ) فِي الْمَكَانِ الصَّحِيحِ","q":"مَا ………؟ — ……… مَدْرَسَتَانِ.","qz":"هَذَانِ yoki هَاتَانِ?","opts":["ه