{"title":"9-vahda · Xarid (التَّسَوُّقُ)","uz":"Doʻkon, bozor, narx soʻrash; mudoriʼ feʼlining ikkilik va koʻplik shakllari; kelasi zamon (سَـ / سَوْفَ)","a1":9,"book":"Al-Manhaj · A1","steps":[{"k":"lugat","t":"Lugʻat · الْمُفْرَدَاتُ وَالتَّرَاكِيبُ","ar":"الْمُفْرَدَاتُ وَالتَّرَاكِيبُ","d":"14 soʻz va 8 ibora: xarid","items":[{"type":"intro","ins":"اسْتَمِعْ وَكَرِّرْ","title":"الْمُفْرَدَاتُ","words":[["كِيلُو","⚖️ kilogramm"],["الْبَائِعُ","sotuvchi"],["يَشْتَرِي","🛒 sotib oladi"],["طَازَجٌ","yangi, toza (uzilgan)"],["الزَّبُونُ","xaridor, mijoz"],["يَبِيعُ","sotadi"],["رَخِيصٌ","arzon"],["بَقَّالٌ","baqqol (oziq-ovqat sotuvchi)"],["أَعْطَى","berdi"],["مَقَاسٌ","📏 oʻlcham (razmer)"],["جَزَّارٌ","qassob"],["الْقُطْنُ","paxta (ip gazlama)"],["الصُّوفُ","🧶 jun"],["مَتْجَرٌ","🏬 doʻkon"]]},{"type":"intro","ins":"اسْتَمِعْ وَكَرِّرْ","title":"التَّرَاكِيبُ","words":[["دَفَعَ الْحِسَابَ","💳 hisobni toʻladi"],["لَحْمٌ مَفْرُومٌ","🥩 qiyma goʻsht"],["بِالصِّحَّةِ وَالْعَافِيَةِ","Osh boʻlsin (sogʻliq va salomatlik bilan)"],["كَمِ الثَّمَنُ؟","Narxi qancha?"],["قَارُورَةُ مَاءٍ","💧 bir shisha suv"],["كِيسُ خُبْزٍ","🍞 bir xalta non"],["عُلْبَةُ حَلِيبٍ","🥛 bir quti sut"],["لَيْلَةٌ سَعِيدَةٌ","🌙 Xayrli tun"]]},{"type":"listen1","ar":"رَخِيصٌ","opts":["Arzon","Yangi","Qimmat"],"ok":"Arzon","why":"رَخِيصٌ — arzon; uning ziddi غَالٍ (qimmat)."},{"type":"listen1","ar":"الزَّبُونُ","opts":["Sotuvchi","Xaridor, mijoz","Qassob"],"ok":"Xaridor, mijoz","why":"الزَّبُونُ — sotib oluvchi; الْبَائِعُ — sotuvchi."},{"type":"pick","ar":"عُلْبَةُ حَلِيبٍ","ok":"🥛","pool":["⚖️","🛒","📏","🧶","🏬","🥩","💧","🍞","🥛","🌙"]},{"type":"pick","ar":"الصُّوفُ","ok":"🧶","pool":["⚖️","🛒","📏","🧶","🏬","🥩","💧","🍞","🥛","🌙"]},{"type":"choose","q":"جَزَّارٌ","qz":"Maʼnosini tanlang","say":"جَزَّارٌ","opts":["Qassob","Baqqol","Sotuvchi"],"ok":"Qassob","why":"جَزَّارٌ goʻsht sotadi, بَقَّالٌ — oziq-ovqat (tuxum, sut, pishloq)."},{"type":"choose","q":"Kechqurun xayrlashganda nima deysiz?","opts":["لَيْلَةٌ سَعِيدَةٌ","كَمِ الثَّمَنُ؟","دَفَعَ الْحِسَابَ"],"ok":"لَيْلَةٌ سَعِيدَةٌ"}]},{"k":"tadrib","t":"Lugʻat mashqlari · تَدْرِيبَاتُ الْمُفْرَدَاتِ","ar":"تَدْرِيبَاتُ الْمُفْرَدَاتِ","d":"Rasm, ulash, soʻz topish","items":[{"type":"pick","ins":"ضَعْ رَقْمَ الْكَلِمَةِ أَمَامَ الصُّورَةِ الْمُنَاسِبَةِ","ar":"قَارُورَةُ مَاءٍ","ok":"💧","pool":["⚖️","🛒","📏","🧶","🏬","🥩","💧","🍞","🥛","🌙"]},{"type":"pick","ins":"ضَعْ رَقْمَ الْكَلِمَةِ أَمَامَ الصُّورَةِ الْمُنَاسِبَةِ","ar":"لَحْمٌ مَفْرُومٌ","ok":"🥩","pool":["⚖️","🛒","📏","🧶","🏬","🥩","💧","🍞","🥛","🌙"]},{"type":"pick","ins":"ضَعْ رَقْمَ الْكَلِمَةِ أَمَامَ الصُّورَةِ الْمُنَاسِبَةِ","ar":"مَقَاسٌ","ok":"📏","pool":["⚖️","🛒","📏","🧶","🏬","🥩","💧","🍞","🥛","🌙"]},{"type":"pick","ins":"ضَعْ رَقْمَ الْكَلِمَةِ أَمَامَ الصُّورَةِ الْمُنَاسِبَةِ","ar":"كِيسُ خُبْزٍ","ok":"🍞","pool":["⚖️","🛒","📏","🧶","🏬","🥩","💧","🍞","🥛","🌙"]},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِمَا يُنَاسِبُهَا","q":"Har bir iborani unga mos (oʻxshash) ibora bilan ulang","pairs":[["مَسَاءُ الْخَيْرِ","لَيْلَةٌ سَعِيدَةٌ"],["عُلْبَةُ حَلِيبٍ","قَارُورَةُ مَاءٍ"],["لَحْمٌ مَفْرُومٌ","لَحْمٌ مُقَطَّعٌ"],["بِالصِّحَّةِ وَالْعَافِيَةِ","بِالْهَنَاءِ وَالشِّفَاءِ"],["كَمِ الثَّمَنُ؟","كَمِ الْحِسَابُ؟"]]},{"type":"letters","ins":"ابْحَثْ عَنْ كَلِمَةِ السِّرِّ","q":"Harflardan soʻz tuzing","show":"لَيْمُونٌ","letters":["لَ","يْ","مُ","و","نٌ"],"uz":"limon","pic":"🍋"},{"type":"letters","ins":"ابْحَثْ عَنْ كَلِمَةِ السِّرِّ","q":"Harflardan soʻz tuzing","show":"جُبْنٌ","letters":["جُ","بْ","نٌ"],"uz":"pishloq","pic":"🧀"},{"type":"letters","ins":"ابْحَثْ عَنْ كَلِمَةِ السِّرِّ","q":"Harflardan soʻz tuzing","show":"دَجَاجٌ","letters":["دَ","جَ","ا","جٌ"],"uz":"tovuq","pic":"🐔"}]},{"k":"matn1","t":"Oʻqish · كَمِ الْحِسَابُ؟","ar":"الْقِرَاءَةُ وَالْفَهْمُ: النَّصُّ الْأَوَّلُ","d":"Baqqol va qassob huzurida","items":[{"type":"read","ins":"اقْرَأْ","title":"حِوَارٌ فِي دُكَّانِ الْبَقَّالِ","lines":[["الْمُشْتَرِي","مَسَاءُ الْخَيْرِ.","Xayrli kech."],["الْبَقَّالُ","مَسَاءُ النُّورِ.","Xayrli kech (nurli kech)."],["الْمُشْتَرِي","هَلْ عِنْدَكَ بَيْضٌ؟","Sizda tuxum bormi?"],["الْبَقَّالُ","نَعَمْ، كَمْ بَيْضَةً تُرِيدُ؟","Ha, nechta tuxum xohlaysiz?"],["الْمُشْتَرِي","أُرِيدُ عَشْرَ بَيْضَاتٍ، وَكِيسَ خُبْزٍ لَوْ سَمَحْتَ.","Oʻnta tuxum va bir xalta non, iltimos."],["الْبَقَّالُ","هَلْ تُرِيدُ شَيْئًا آخَرَ؟","Yana biror narsa xohlaysizmi?"],["الْمُشْتَرِي","نَعَمْ، أُرِيدُ جُبْنًا أَبْيَضَ وَزَيْتُونًا أَسْوَدَ.","Ha, oq pishloq va qora zaytun xohlayman."],["الْبَقَّالُ","كَمْ كِيلُو تُرِيدُ؟","Necha kilo xohlaysiz?"],["الْمُشْتَرِي","أُرِيدُ نِصْفَ كِيلُو مِنَ الْجُبْنِ، وَرُبْعَ كِيلُو مِنَ الزَّيْتُونِ.","Yarim kilo pishloq va chorak kilo zaytun xohlayman."],["الْبَقَّالُ","تَفَضَّلْ، هَلْ تُرِيدُ شَيْئًا آخَرَ؟","Marhamat. Yana biror narsa xohlaysizmi?"],["الْمُشْتَرِي","نَعَمْ، أُرِيدُ عُلْبَةَ حَلِيبٍ، وَقَارُورَةَ مَاءٍ كَبِيرَةً، كَمِ الْحِسَابُ؟","Ha, bir quti sut va katta bir shisha suv. Hisob qancha?"],["الْبَقَّالُ","خَمْسُونَ لِيرَةً.","Ellik lira."],["الْمُشْتَرِي","تَفَضَّلْ، لَيْلَةٌ سَعِيدَةٌ.","Marhamat. Xayrli tun."]]},{"type":"read","ins":"اقْرَأْ","title":"حِوَارٌ عِنْدَ الْجَزَّارِ","lines":[["الْمَرْأَةُ","السَّلَامُ عَلَيْكُمْ.","Assalomu alaykum."],["الْجَزَّارُ","وَعَلَيْكُمُ السَّلَامُ.","Va alaykum assalom."],["الْمَرْأَةُ","أُرِيدُ كِيلُو لَحْمٍ مُقَطَّعٍ، وَنِصْفَ كِيلُو لَحْمٍ مَفْرُومٍ.","Bir kilo boʻlaklangan goʻsht va yarim kilo qiyma xohlayman."],["الْجَزَّارُ","هَلْ تُرِيدِينَ لَحْمَ غَنَمٍ أَوْ بَقَرٍ؟","Qoʻy goʻshtimi yoki mol goʻshtimi?"],["الْمَرْأَةُ","لَحْمَ غَنَمٍ مُقَطَّعًا، وَلَحْمَ بَقَرٍ مَفْرُومًا.","Qoʻy goʻshti boʻlaklab, mol goʻshti qiyma qilib."],["الْجَزَّارُ","هَلْ تُرِيدِينَ دَجَاجًا؟","Tovuq ham xohlaysizmi?"],["الْمَرْأَةُ","شُكْرًا، اشْتَرَيْتُهُ مِنَ السُّوقِ، كَمِ الْحِسَابُ؟","Rahmat, uni bozordan oldim. Hisob qancha?"],["الْجَزَّارُ","مِئَةٌ وَثَلَاثُونَ لِيرَةً.","Bir yuz oʻttiz lira."],["الْمَرْأَةُ","تَفَضَّلْ.","Marhamat."],["الْجَزَّارُ","بِالصِّحَّةِ وَالْعَافِيَةِ.","Osh boʻlsin."],["الْمَرْأَةُ","مَعَ السَّلَامَةِ.","Xayr."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"وَقْتُ الشِّرَاءِ مِنَ الْبَقَّالِ فِي ……","opts":["الصَّبَاحِ","الظُّهْرِ","الْمَسَاءِ"],"ok":"الْمَسَاءِ","full":"وَقْتُ الشِّرَاءِ مِنَ الْبَقَّالِ فِي الْمَسَاءِ.","fz":"Baqqoldan xarid kechqurun boʻldi.","why":"Ular «مَسَاءُ الْخَيْرِ» deb salomlashdi — demak, kechqurun."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"تُرِيدُ الْمَرْأَةُ لَحْمًا مَفْرُومًا مِنَ ……","opts":["الْغَنَمِ","الْبَقَرِ","الْجَمَلِ"],"ok":"الْبَقَرِ","full":"تُرِيدُ الْمَرْأَةُ لَحْمًا مَفْرُومًا مِنَ الْبَقَرِ.","fz":"Ayol mol goʻshtidan qiyma xohlaydi.","why":"«لَحْمَ غَنَمٍ مُقَطَّعًا، وَلَحْمَ بَقَرٍ مَفْرُومًا» — qiyma mol goʻshtidan."},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗","s":"طَلَبَ الْمُشْتَرِي زَيْتُونًا أَخْضَرَ.","uz":"Notoʻgʻri: u qora zaytun (زَيْتُونًا أَسْوَدَ) soʻradi.","ok":false},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗","s":"اشْتَرَتِ الْمَرْأَةُ الدَّجَاجَ مِنَ السُّوقِ.","uz":"Toʻgʻri: «اشْتَرَيْتُهُ مِنَ السُّوقِ» — tovuqni bozordan olgan.","ok":true},{"type":"classify","ins":"امْلَأِ الْجَدْوَلَ بِالْمُشْتَرَيَاتِ","q":"Kim nimani sotib oldi? Ustunlarga ajrating","cols":["عِنْدَ الْبَقَّالِ","عِنْدَ الْجَزَّارِ"],"words":[["بَيْضٌ",0],["جُبْنٌ أَبْيَضُ",0],["لَحْمُ غَنَمٍ",1],["زَيْتُونٌ أَسْوَدُ",0],["لَحْمُ بَقَرٍ مَفْرُومٌ",1],["عُلْبَةُ حَلِيبٍ",0]]},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِمَا يُنَاسِبُهَا","q":"Soʻzlarni ulab ibora tuzing","pairs":[["لَحْمٌ","مَفْرُومٌ"],["قَارُورَةُ","مَاءٍ"],["جُبْنٌ","أَبْيَضُ"],["كِيسُ","خُبْزٍ"],["بِالصِّحَّةِ","وَالْعَافِيَةِ"],["لَيْلَةٌ","سَعِيدَةٌ"]]},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ الْمُنَاسِبَةَ","q":"دَفَعْتُ …… لِلْبَائِعِ.","opts":["الْحِسَابَ","السُّوقَ","رَخِيصٌ"],"ok":"الْحِسَابَ","full":"دَفَعْتُ الْحِسَابَ لِلْبَائِعِ.","fz":"Sotuvchiga hisobni toʻladim."},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ الْمُنَاسِبَةَ","q":"السَّمَكُ الْيَوْمَ طَازَجٌ و……","opts":["عُلْبَةٌ","رَخِيصٌ","يَبِيعُ"],"ok":"رَخِيصٌ","full":"السَّمَكُ الْيَوْمَ طَازَجٌ وَرَخِيصٌ.","fz":"Bugun baliq yangi va arzon."},{"type":"match","ins":"اكْتُبِ الْأَشْيَاءَ الَّتِي يَبِيعُهَا كُلٌّ مِنْ","q":"Kim nima sotadi? Ulang","pairs":[["الْخَبَّازُ","الْخُبْزَ"],["الْجَزَّارُ","اللَّحْمَ وَالدَّجَاجَ"],["الْفَاكِهِيُّ","الْفَاكِهَةَ"],["الْخُضَرِيُّ","الْخَضْرَاوَاتِ"]]}]},{"k":"matn2","t":"Oʻqish · بِكَمِ الْكِيلُو؟","ar":"الْقِرَاءَةُ وَالْفَهْمُ: النَّصُّ الثَّانِي","d":"Sabzavot va meva bozorida","items":[{"type":"read","ins":"اقْرَأْ","title":"بِكَمِ الْكِيلُو لَوْ سَمَحْتَ؟","lines":[["الزَّبُونَةُ","صَبَاحُ الْخَيْرِ.","Xayrli tong."],["الْبَائِعُ","صَبَاحُ النُّورِ.","Xayrli tong (nurli tong)."],["الزَّبُونَةُ","هَلْ لَدَيْكَ خَضْرَاوَاتٌ طَازَجَةٌ الْيَوْمَ؟","Bugun sizda yangi sabzavotlar bormi?"],["الْبَائِعُ","نَعَمْ، طَازَجَةٌ وَرَخِيصَةٌ أَيْضًا.","Ha, yangi va arzon ham."],["الزَّبُونَةُ","أُرِيدُ كِيلُو مِنَ الطَّمَاطِمِ، وَنِصْفَ كِيلُو مِنَ الْخِيَارِ، وَرُبْعَ كِيلُو مِنَ الْفُلْفُلِ الْأَخْضَرِ.","Bir kilo pomidor, yarim kilo bodring va chorak kilo koʻk qalampir xohlayman."],["الْبَائِعُ","هَلْ تُرِيدِينَ شَيْئًا آخَرَ؟","Yana biror narsa xohlaysizmi?"],["الزَّبُونَةُ","نَعَمْ، أُرِيدُ لَيْمُونًا وَخَسًّا.","Ha, limon va salat bargi xohlayman."],["الْبَائِعُ","هَلْ تُرِيدِينَ فَاكِهَةً؟","Meva ham xohlaysizmi?"],["الزَّبُونَةُ","بِكَمْ كِيلُو الْمَوْزِ؟","Bananning kilosi qancha?"],["الْبَائِعُ","الْمَوْزُ بِـ 15 رِيَالًا، وَالتُّفَّاحُ بِـ 10 رِيَالَاتٍ، وَالْبُرْتُقَالُ بِـ 5 رِيَالَاتٍ.","Banan 15 riyol, olma 10 riyol, apelsin 5 riyol."],["الزَّبُونَةُ","الْمَوْزُ غَالِي الثَّمَنِ، أَعْطِنِي كِيلُو مِنَ التُّفَّاحِ، وَكِيلُوَيْنِ مِنَ الْبُرْتُقَالِ.","Banan qimmat ekan. Menga bir kilo olma va ikki kilo apelsin bering."],["الْبَائِعُ","بِكُلِّ سُرُورٍ.","Jonim bilan."],["الزَّبُونَةُ","كَمِ الْحِسَابُ؟","Hisob qancha?"],["الْبَائِعُ","الْحِسَابُ 33 رِيَالًا.","Hisob 33 riyol."],["الزَّبُونَةُ","تَفَضَّلْ 50 رِيَالًا.","Marhamat, 50 riyol."],["الْبَائِعُ","وَهَذَا الْبَاقِي، بِالصِّحَّةِ وَالْعَافِيَةِ.","Mana qaytimi. Osh boʻlsin."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"الْخَضْرَاوَاتُ فِي السُّوقِ ……","opts":["كَثِيرَةٌ وَغَالِيَةٌ","قَلِيلَةٌ وَبَائِتَةٌ","طَازَجَةٌ وَرَخِيصَةٌ"],"ok":"طَازَجَةٌ وَرَخِيصَةٌ","full":"الْخَضْرَاوَاتُ فِي السُّوقِ طَازَجَةٌ وَرَخِيصَةٌ.","fz":"Bozordagi sabzavotlar yangi va arzon."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"بَاقِي الْحِسَابِ ……","opts":["50","33","17"],"ok":"17","why":"50 − 33 = 17 riyol qaytim."},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗","s":"التُّفَّاحُ أَغْلَى مِنَ الْبُرْتُقَالِ.","uz":"Toʻgʻri: olma 10 riyol, apelsin 5 riyol.","ok":true},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗","s":"أَخَذَتِ الْمَرْأَةُ رُبْعَ كِيلُو مِنَ الْفُلْفُلِ الْأَحْمَرِ.","uz":"Notoʻgʻri: u koʻk qalampir (الْفُلْفُلِ الْأَخْضَرِ) oldi.","ok":false},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"لِمَاذَا لَمْ تَشْتَرِ الْمَوْزَ؟","qz":"Nega banan olmadi?","opts":["لِأَنَّ الْمَوْزَ غَالِي الثَّمَنِ.","لِأَنَّ الْمَوْزَ رَخِيصٌ.","لِأَنَّ الْمَوْزَ بَائِتٌ."],"ok":"لِأَنَّ الْمَوْزَ غَالِي الثَّمَنِ.","why":"Matnda: «الْمَوْزُ غَالِي الثَّمَنِ» — banan qimmat."},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ غَيْرَ الْمُنَاسِبَةِ","q":"نَصْنَعُ السَّلَطَةَ مِنَ: ……","qz":"Qaysi soʻz mos emas?","opts":["الطَّمَاطِمِ","الرُّزِّ","الْخَسِّ","الْخِيَارِ"],"ok":"الرُّزِّ","why":"Salat pomidor, salat bargi va bodringdan qilinadi; guruch (الرُّزُّ) mos emas."},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ غَيْرَ الْمُنَاسِبَةِ","q":"مِنَ الْفَوَاكِهِ: ……","qz":"Qaysi soʻz mos emas?","opts":["الْبَاذِنْجَانُ","الْبُرْتُقَالُ","التُّفَّاحُ","الْبِطِّيخُ"],"ok":"الْبَاذِنْجَانُ","why":"الْبَاذِنْجَانُ (baqlajon) — sabzavot, qolganlari meva."},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِضِدِّهَا","q":"Soʻzni zid maʼnolisi bilan ulang","pairs":[["الْمُشْتَرِي","الْبَائِعُ"],["رَخِيصٌ","غَالٍ"],["طَازَجٌ","بَائِتٌ"],["يَبِيعُ","يَشْتَرِي"],["أَعْطَى","أَخَذَ"]]},{"type":"choose","ins":"صِلِ الْجُمْلَةَ بِالصُّورَةِ الْمُنَاسِبَةِ","pic":"💻","q":"Rasmga mos gapni tanlang","opts":["أَشْتَرِي كُلَّ شَيْءٍ مِنَ الْإِنْتَرْنِتْ.","أَعْطَيْتُ النُّقُودَ لِلْبَائِعِ.","السُّوقُ مُزْدَحِمٌ الْيَوْمَ."],"ok":"أَشْتَرِي كُلَّ شَيْءٍ مِنَ الْإِنْتَرْنِتْ."},{"type":"choose","ins":"صِلِ الْجُمْلَةَ بِالصُّورَةِ الْمُنَاسِبَةِ","pic":"💵","q":"Rasmga mos gapni tanlang","opts":["الْخَضْرَاوَاتُ طَازَجَةٌ وَرَخِيصَةٌ.","أَعْطَيْتُ النُّقُودَ لِلْبَائِعِ.","أُرِيدُ لَحْمًا بَقَرِيًّا مُقَطَّعًا."],"ok":"أَعْطَيْتُ النُّقُودَ لِلْبَائِعِ."}]},{"k":"suhbat","t":"Suhbat · الْمُحَادَثَةُ","ar":"الْمُحَادَثَةُ: التَّسَوُّقُ وَالشِّرَاءُ","d":"Savollar va iboralar","items":[{"type":"read","ins":"اقْرَأْ وَأَجِبْ","title":"التَّسَوُّقُ وَالشِّرَاءُ","lines":[["","هَلْ تُحِبُّ التَّسَوُّقَ؟","Xarid qilishni yoqtirasanmi?"],["","أَيْنَ تَتَسَوَّقُ عَادَةً؟","Odatda qayerdan xarid qilasan?"],["","هَلْ تَذْهَبُ إِلَى السُّوقِ أَمْ إِلَى الْمَرْكَزِ التِّجَارِيِّ؟","Bozorga borasanmi yoki savdo markaziga?"],["","مَاذَا تَشْتَرِي عَادَةً؟","Odatda nima sotib olasan?"],["","مَنْ يَشْتَرِي الطَّعَامَ فِي بَيْتِكَ؟","Uyingda ovqatni kim sotib oladi?"],["","كَمْ مَرَّةً تَتَسَوَّقُ فِي الْأُسْبُوعِ؟","Haftada necha marta xarid qilasan?"],["","هَلْ تَشْتَرِي الْمَلَابِسَ مِنَ السُّوقِ أَمْ مِنَ الْمَتْجَرِ؟","Kiyimni bozordan olasanmi yoki doʻkondan?"],["","مَا لَوْنُ الْمَلَابِسِ الْمُفَضَّلُ لَدَيْكَ؟","Sevimli kiyim ranging qaysi?"],["","هَلْ تُحِبُّ التَّسَوُّقَ مَعَ الْعَائِلَةِ أَمْ مَعَ الْأَصْدِقَاءِ؟","Xaridni oila bilan yoqtirasanmi yoki doʻstlar bilan?"],["","هَلِ الْأَسْعَارُ فِي مَدِينَتِكَ غَالِيَةٌ أَمْ رَخِيصَةٌ؟","Shahringda narxlar qimmatmi yoki arzon?"],["","مَاذَا تَشْتَرِي عِنْدَمَا يَكُونُ لَدَيْكَ مَالٌ كَثِيرٌ؟","Puling koʻp boʻlganda nima sotib olasan?"],["","هَلْ تُحِبُّ شِرَاءَ الْهَدَايَا؟ وَلِمَنْ؟","Sovgʻa sotib olishni yoqtirasanmi? Kimga?"]]},{"type":"read","ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","title":"تَعَابِيرُ","lines":[["","هَلْ تُرِيدُ دَجَاجًا أَوْ سَمَكًا؟","Tovuq xohlaysizmi yoki baliq?"],["","هَلْ تُرِيدِينَ خَضْرَاوَاتٍ أَوْ فَوَاكِهَ؟","Sabzavot xohlaysizmi yoki meva? (ayolga)"],["","هَلْ تُرِيدُ شَيْئًا آخَرَ مِنَ السُّوقِ؟","Bozordan yana biror narsa xohlaysizmi?"],["","هَلْ تُرِيدُ شَيْئًا آخَرَ مِنَ الْمَكْتَبَةِ؟","Kitob doʻkonidan yana biror narsa xohlaysizmi?"],["","أَعْطِنِي قَلَمًا لَوْ سَمَحْتَ.","Menga bir qalam bering, iltimos."],["","أَعْطِنِي كِيسَ مِلْحٍ لَوْ سَمَحْتَ.","Menga bir xalta tuz bering, iltimos."],["","أَيَّ لَوْنٍ تُفَضِّلُ؟","Qaysi rangni afzal koʻrasiz?"],["","أَيَّ سُوقٍ تُفَضِّلُ؟","Qaysi bozorni afzal koʻrasiz?"]]},{"type":"choose","q":"كَمِ الْحِسَابُ؟","qz":"Mos javobni tanlang","say":"كَمِ الْحِسَابُ؟","opts":["خَمْسُونَ لِيرَةً.","بِالصِّحَّةِ وَالْعَافِيَةِ.","مَسَاءُ النُّورِ."],"ok":"خَمْسُونَ لِيرَةً."},{"type":"choose","q":"هَلْ تُرِيدُ شَيْئًا آخَرَ؟","qz":"Mos javobni tanlang","say":"هَلْ تُرِيدُ شَيْئًا آخَرَ؟","opts":["نَعَمْ، أُرِيدُ عُلْبَةَ حَلِيبٍ.","مَسَاءُ النُّورِ.","مِئَةٌ وَثَلَاثُونَ لِيرَةً."],"ok":"نَعَمْ، أُرِيدُ عُلْبَةَ حَلِيبٍ."},{"type":"choose","q":"Doʻkonda sotuvchidan bir qalam soʻrang","opts":["أَعْطِنِي قَلَمًا لَوْ سَمَحْتَ.","أَيَّ لَوْنٍ تُفَضِّلُ؟","هَلْ تُرِيدُ شَيْئًا آخَرَ؟"],"ok":"أَعْطِنِي قَلَمًا لَوْ سَمَحْتَ.","why":"«أَعْطِنِي … لَوْ سَمَحْتَ» — «Menga … bering, iltimos»."},{"type":"choose","q":"مَسَاءُ الْخَيْرِ.","qz":"Mos javobni tanlang","say":"مَسَاءُ الْخَيْرِ","opts":["مَسَاءُ النُّورِ.","لَيْلَةٌ سَعِيدَةٌ.","تَفَضَّلْ."],"ok":"مَسَاءُ النُّورِ."},{"type":"free","ins":"تَحَدَّثْ","q":"Savollardan 4 tasiga oʻzingiz haqingizda arabcha javob bering (yozing yoki ovoz bilan ayting): هَلْ تُحِبُّ التَّسَوُّقَ؟ أَيْنَ تَتَسَوَّقُ عَادَةً؟ مَاذَا تَشْتَرِي عَادَةً؟ كَمْ مَرَّةً تَتَسَوَّقُ فِي الْأُسْبُوعِ؟","hint":"نَعَمْ، أُحِبُّ التَّسَوُّقَ. أَتَسَوَّقُ عَادَةً فِي …"}]},{"k":"qoida1","t":"Qoida · الْمُضَارِعُ مَعَ الْمُثَنَّى وَالْجَمْعِ","ar":"إِسْنَادُ الْمُضَارِعِ إِلَى ضَمَائِرِ الْمُثَنَّى وَالْجَمْعِ","d":"نَحْنُ، هُمَا، هُمْ، هُنَّ، أَنْتُمَا، أَنْتُمْ، أَنْتُنَّ","rule":{"h":"إِسْنَادُ الْمُضَارِعِ إِلَى الْمُثَنَّى وَالْجَمْعِ","p":["<span class=\"ar\">نَحْنُ</span> — <b>نَـ</b> bilan boshlanadi: <span class=\"ar\">نَسْأَلُ</span>.","Ikkilik (<span class=\"ar\">الْمُثَنَّى</span>) — oxiriga <b>ـانِ</b>: <span class=\"ar\">هُمَا يَسْأَلَانِ</span> (erkak), <span class=\"ar\">هُمَا تَسْأَلَانِ</span> (ayol), <span class=\"ar\">أَنْتُمَا تَسْأَلَانِ</span>.","Erkak koʻplik — <b>ـونَ</b>: <span class=\"ar\">هُمْ يَسْأَلُونَ - أَنْتُمْ تَسْأَلُونَ</span>.","Ayol koʻplik — <b>ـنَ</b>: <span class=\"ar\">هُنَّ يَسْأَلْنَ - أَنْتُنَّ تَسْأَلْنَ</span>."]},"items":[{"type":"choose","ins":"أَكْمِلِ الْجَدْوَلَ الْآتِيَ","q":"هُمَا (مُذَكَّرٌ) …… (رَجَعَ)","opts":["يَرْجِعَانِ","تَرْجِعَانِ","يَرْجِعُونَ"],"ok":"يَرْجِعَانِ","why":"هُمَا (erkak) — يَـ bilan: يَرْجِعَانِ. Kitob jadvalida bu katakda تَرْجِعَانِ deb xato bosilgan."},{"type":"choose","ins":"أَكْمِلِ الْجَدْوَلَ الْآتِيَ","q":"هُنَّ …… (جَمَعَ)","opts":["يَجْمَعُونَ","يَجْمَعْنَ","تَجْمَعَانِ"],"ok":"يَجْمَعْنَ","why":"Ayol koʻplik — ـنَ: هُنَّ يَجْمَعْنَ."},{"type":"choose","ins":"أَكْمِلِ الْجَدْوَلَ الْآتِيَ","q":"نَحْنُ …… (لَعِبَ)","opts":["نَلْعَبُ","يَلْعَبُونَ","تَلْعَبْنَ"],"ok":"نَلْعَبُ"},{"type":"classify","ins":"أَكْمِلِ الْجَدْوَلَ الْآتِيَ","q":"Feʼllarni shakliga qarab ajrating","cols":["الْمُثَنَّى (ـانِ)","جَمْعُ الْمُذَكَّرِ (ـونَ)","جَمْعُ الْمُؤَنَّثِ (ـنَ)"],"words":[["تَلْعَبَانِ",0],["يَرْجِعُونَ",1],["يَلْعَبْنَ",2],["يَجْمَعَانِ",0],["تَرْجِعْنَ",2],["تَجْمَعُونَ",1]]},{"type":"choose","ins":"اكْتُبِ الْفِعْلَ الْمُضَارِعَ الْمُنَاسِبَ فِي الْفَرَاغِ","q":"الطَّالِبَاتُ …… إِلَى الْمَعْهَدِ. (ذَهَبَ)","opts":["يَذْهَبُونَ","يَذْهَبْنَ","تَذْهَبُ"],"ok":"يَذْهَبْنَ","full":"الطَّالِبَاتُ يَذْهَبْنَ إِلَى الْمَعْهَدِ.","fz":"Talaba qizlar institutga boradilar.","why":"الطَّالِبَاتُ — ayol koʻplik: يَذْهَبْنَ."},{"type":"choose","ins":"اكْتُبِ الْفِعْلَ الْمُضَارِعَ الْمُنَاسِبَ فِي الْفَرَاغِ","q":"هَلْ …… فِي هَذَا الْمَطْعَمِ يَا أَصْدِقَائِي؟ (أَكَلَ)","opts":["تَأْكُلُونَ","يَأْكُلُونَ","تَأْكُلُ"],"ok":"تَأْكُلُونَ","full":"هَلْ تَأْكُلُونَ فِي هَذَا الْمَطْعَمِ يَا أَصْدِقَائِي؟","fz":"Doʻstlarim, shu restoranda ovqatlanasizlarmi?","why":"Doʻstlarga murojaat — أَنْتُمْ: تَأْكُلُونَ."},{"type":"choose","ins":"اكْتُبِ الْفِعْلَ الْمُضَارِعَ الْمُنَاسِبَ فِي الْفَرَاغِ","q":"نَحْنُ …… التِّلْفَازَ فِي الْغُرْفَةِ. (شَاهَدَ)","opts":["نُشَاهِدُ","يُشَاهِدُ","أُشَاهِدُ"],"ok":"نُشَاهِدُ","full":"نَحْنُ نُشَاهِدُ التِّلْفَازَ فِي الْغُرْفَةِ.","fz":"Biz xonada televizor koʻramiz."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","q":"أَنْتُمْ …… الْحَافِلَةَ كُلَّ يَوْمٍ.","opts":["يَرْكَبُونَ","يَرْكَبَانِ","تَرْكَبُونَ"],"ok":"تَرْكَبُونَ","full":"أَنْتُمْ تَرْكَبُونَ الْحَافِلَةَ كُلَّ يَوْمٍ.","fz":"Sizlar har kuni avtobusga minasizlar.","why":"أَنْتُمْ — تَـ … ـونَ: تَرْكَبُونَ."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","q":"أَنْتُمَا …… الشَّايَ فِي الْمَقْصِفِ.","opts":["تَشْرَبِينَ","تَشْرَبُونَ","تَشْرَبَانِ"],"ok":"تَشْرَبَانِ","full":"أَنْتُمَا تَشْرَبَانِ الشَّايَ فِي الْمَقْصِفِ.","fz":"Ikkovingiz oshxonada choy ichasiz."},{"type":"choose","ins":"أَسْنِدِ الْجُمَلَ إِلَى ضَمَائِرِ الْمُثَنَّى وَالْجَمْعِ","q":"أَنْتَ تَأْخُذُ اللَّحْمَ. ← أَنْتُمْ ……","opts":["تَأْخُذُونَ","تَأْخُذَانِ","يَأْخُذُونَ"],"ok":"تَأْخُذُونَ","full":"أَنْتُمْ تَأْخُذُونَ اللَّحْمَ.","fz":"Sizlar goʻshtni olasizlar."},{"type":"choose","ins":"أَسْنِدِ الْجُمَلَ إِلَى ضَمَائِرِ الْمُثَنَّى وَالْجَمْعِ","q":"هُوَ يَبِيعُ الْفَاكِهَةَ. ← هُمَا ……","opts":["يَبِيعُونَ","يَبِيعَانِ","تَبِيعَانِ"],"ok":"يَبِيعَانِ","full":"هُمَا يَبِيعَانِ الْفَاكِهَةَ.","fz":"Ular (ikkovi) meva sotadilar."}]},{"k":"qoida2","t":"Qoida · الْمُسْتَقْبَلُ","ar":"الْمُسْتَقْبَلُ: سَـ / سَوْفَ","d":"Kelasi zamon: سَـ va سَوْفَ","rule":{"h":"الْمُسْتَقْبَلُ","p":["Kelasi zamon = <b>سَـ</b> yoki <b>سَوْفَ</b> + mudoriʼ feʼl: <span class=\"ar\">سَأَكْتُبُ - سَوْفَ أَكْتُبُ</span>.","<span class=\"ar\">مَاذَا فَعَلْتَ؟ كَتَبْتُ الدَّرْسَ</span> — oʻtgan zamon.","<span class=\"ar\">مَاذَا تَفْعَلُ؟ أَكْتُبُ الدَّرْسَ</span> — hozirgi zamon.","<span class=\"ar\">مَاذَا سَتَفْعَلُ؟ سَأَكْتُبُ الدَّرْسَ</span> — kelasi zamon."]},"items":[{"type":"choose","ins":"اسْأَلْ زَمِيلَكَ عَنِ الْأَفْعَالِ فِي الصُّوَرِ","pic":"🍽️","q":"مَاذَا فَعَلْتَ؟","qz":"Rasm: likopcha boʻsh — ovqat yeb boʻlindi","opts":["أَكَلْتُ الطَّعَامَ.","آكُلُ الطَّعَامَ الْآنَ.","سَآكُلُ الطَّعَامَ."],"ok":"أَكَلْتُ الطَّعَامَ.","why":"«مَاذَا فَعَلْتَ؟» — oʻtgan zamon: أَكَلْتُ."},{"type":"choose","ins":"اسْأَلْ زَمِيلَكَ عَنِ الْأَفْعَالِ فِي الصُّوَرِ","pic":"🍲","q":"مَاذَا سَتَفْعَلُ؟","qz":"Rasm: odam taomga qarab turibdi — hali yemagan","opts":["أَكَلْتُ الطَّعَامَ.","آكُلُ الطَّعَامَ الْآنَ.","سَآكُلُ الطَّعَامَ."],"ok":"سَآكُلُ الطَّعَامَ.","why":"«مَاذَا سَتَفْعَلُ؟» — kelasi zamon: سَآكُلُ."},{"type":"choose","ins":"حَوِّلِ الْفِعْلَ الْمُضَارِعَ إِلَى الْمُسْتَقْبَلِ","q":"أُمِّي تَشْتَرِي الْخُضْرَةَ مِنَ الْبَقَّالِ. ← أُمِّي …… الْخُضْرَةَ مِنَ الْبَقَّالِ.","opts":["سَتَشْتَرِي","سَيَشْتَرِي","سَأَشْتَرِي"],"ok":"سَتَشْتَرِي","full":"أُمِّي سَتَشْتَرِي الْخُضْرَةَ مِنَ الْبَقَّالِ.","fz":"Onam baqqoldan koʻkatlar sotib oladi (keyin).","why":"تَشْتَرِي + سَـ = سَتَشْتَرِي (shaxs oʻzgarmaydi)."},{"type":"choose","ins":"حَوِّلِ الْفِعْلَ الْمُضَارِعَ إِلَى الْمُسْتَقْبَلِ","q":"هُمْ يَدْرُسُونَ فِي الْمَدْرَسَةِ الثَّانَوِيَّةِ. ← هُمْ …… فِي الْمَدْرَسَةِ الثَّانَوِيَّةِ.","opts":["سَيَدْرُسُونَ","سَتَدْرُسُونَ","دَرَسُوا"],"ok":"سَيَدْرُسُونَ","full":"هُمْ سَيَدْرُسُونَ فِي الْمَدْرَسَةِ الثَّانَوِيَّةِ.","fz":"Ular oʻrta maktabda oʻqiydilar (kelajakda)."},{"type":"choose","ins":"حَوِّلِ الْفِعْلَ الْمَاضِيَ إِلَى الْمُسْتَقْبَلِ","q":"مَتَى ذَهَبْتِ إِلَى السُّوقِ يَا زَيْنَبُ؟ ← مَتَى …… إِلَى السُّوقِ يَا زَيْن