شْتَرَيْتُ …… مِنَ الصَّيْدَلِيَّةِ.","opts":["الدَّوَاءَ","الْمُسْتَشْفَى","زِيَارَةٌ"],"ok":"الدَّوَاءَ","full":"اشْتَرَيْتُ الدَّوَاءَ مِنَ الصَّيْدَلِيَّةِ.","fz":"Dorixonadan dori sotib oldim."},{"type":"choose","ins":"اخْتَرِ الْكَلِمَةَ الْمُنَاسِبَةَ","q":"أَشْعُرُ بِـ…… فِي يَدِي.","opts":["أَلَمٍ","وَصْفَةٍ","دَوَاءٍ"],"ok":"أَلَمٍ","full":"أَشْعُرُ بِأَلَمٍ فِي يَدِي.","fz":"Qoʻlimda ogʻriq sezyapman."},{"type":"letters","ins":"ابْحَثْ عَنِ الْكَلِمَاتِ الْآتِيَةِ، ثُمَّ اكْتُبْ كَلِمَةَ السِّرِّ","q":"Harflardan soʻz tuzing","show":"صُدَاعٌ","letters":["صُ","دَ","ا","عٌ"],"uz":"bosh ogʻrigʻi"},{"type":"letters","ins":"ابْحَثْ عَنِ الْكَلِمَاتِ الْآتِيَةِ، ثُمَّ اكْتُبْ كَلِمَةَ السِّرِّ","q":"Harflardan soʻz tuzing","show":"شِفَاءٌ","letters":["شِ","فَ","ا","ءٌ"],"uz":"shifo, tuzalish"}]},{"k":"matn1","t":"Oʻqish · سَيَّارَةُ الْإِسْعَافِ","ar":"الْقِرَاءَةُ وَالْفَهْمُ: النَّصُّ الْأَوَّلُ","d":"Oʻgʻil kasal: tez yordam chaqirish","items":[{"type":"read","ins":"اقْرَأْ","title":"سَيَّارَةُ الْإِسْعَافِ","lines":[["الِابْنُ","أُمِّي! أُمِّي.","Onajon! Onajon!"],["الْأُمُّ","مَاذَا بِكَ؟","Senga nima boʻldi?"],["الِابْنُ","أَشْعُرُ بِأَلَمٍ شَدِيدٍ فِي بَطْنِي.","Qornimda qattiq ogʻriq sezyapman."],["الْأُمُّ","يَجِبُ أَنْ نَذْهَبَ إِلَى الْمُسْتَشْفَى الْآنَ.","Hozir kasalxonaga borishimiz kerak."],["الِابْنُ","لَا أَسْتَطِيعُ أَنْ أَمْشِيَ يَا أُمِّي.","Yura olmayman, onajon."],["الْأُمُّ","سَأَتَّصِلُ بِسَيَّارَةِ الْإِسْعَافِ.","Tez yordam mashinasiga qoʻngʻiroq qilaman."],["الْأُمُّ","السَّلَامُ عَلَيْكُمْ، مُسْتَشْفَى الشِّفَاءِ؟","Assalomu alaykum, «Ash-Shifo» kasalxonasimi?"],["الْمُوَظَّفُ","وَعَلَيْكُمُ السَّلَامُ، نَعَمْ، تَفَضَّلِي.","Va alaykum assalom, ha, eshitaman."],["الْأُمُّ","ابْنِي مَرِيضٌ جِدًّا، يَشْعُرُ بِأَلَمٍ شَدِيدٍ فِي بَطْنِهِ، وَحَرَارَتُهُ مُرْتَفِعَةٌ، نَحْتَاجُ إِلَى سَيَّارَةِ إِسْعَافٍ سَرِيعًا مِنْ فَضْلِكَ.","Oʻgʻlim juda kasal: qornida qattiq ogʻriq bor, harorati baland. Iltimos, tezda tez yordam mashinasi kerak."],["الْمُوَظَّفُ","أَعْطِنِي الْعُنْوَانَ مِنْ فَضْلِكِ.","Manzilni ayting, iltimos."],["الْأُمُّ","5 شَارِعُ الْهُدَى، الْحَيُّ الْجَدِيدُ، فِي وَسَطِ الْمَدِينَةِ.","Al-Huda koʻchasi, 5-uy, Yangi mahalla, shahar markazida."],["الْمُوَظَّفُ","لَا تَقْلَقِي! سَتَصِلُ سَيَّارَةُ الْإِسْعَافِ إِلَيْكُمْ فِي أَقْرَبِ وَقْتٍ، نِصْفَ سَاعَةٍ عَلَى الْأَكْثَرِ.","Xavotir olmang! Tez yordam imkon qadar tez yetib boradi — koʻpi bilan yarim soatda."],["الْأُمُّ","بِانْتِظَارِهَا، شُكْرًا لَكَ.","Kutamiz, rahmat sizga."],["الْأُمُّ","لَا بَأْسَ عَلَيْكَ يَا ابْنِي، سَتَكُونُ بِخَيْرٍ.","Xavotir olma, oʻgʻlim, yaxshi boʻlib ketasan."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"سَتَأْتِي سَيَّارَةُ الْإِسْعَافِ بَعْدَ …… دَقِيقَةً.","opts":["20","30","40"],"ok":"30","why":"«نِصْفَ سَاعَةٍ عَلَى الْأَكْثَرِ» — yarim soat = 30 daqiqa."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"طَلَبَ الْمُوَظَّفُ ……","opts":["ثَمَنَ الْفَحْصِ","عُنْوَانَ السَّكَنِ","اسْمَ الْمَرِيضِ"],"ok":"عُنْوَانَ السَّكَنِ","full":"طَلَبَ الْمُوَظَّفُ عُنْوَانَ السَّكَنِ.","fz":"Xodim yashash manzilini soʻradi.","why":"«أَعْطِنِي الْعُنْوَانَ مِنْ فَضْلِكِ»."},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗، ثُمَّ صَحِّحِ الْخَطَأَ","s":"تَحَدَّثَ فِي النَّصِّ أَرْبَعَةُ أَشْخَاصٍ.","uz":"Notoʻgʻri: uch kishi gapirdi — oʻgʻil, ona va xodim.","ok":false},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗، ثُمَّ صَحِّحِ الْخَطَأَ","s":"يَسْكُنُ الْمَرِيضُ فِي وَسَطِ الْمَدِينَةِ.","uz":"Toʻgʻri: manzil — «فِي وَسَطِ الْمَدِينَةِ».","ok":true},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"مَا اسْمُ الْمُسْتَشْفَى الَّذِي اتَّصَلَتْ بِهِ الْأُمُّ؟","opts":["مُسْتَشْفَى الشِّفَاءِ","عِيَادَةُ الطَّبِيبِ سَعِيدٍ","الْحَيُّ الْجَدِيدُ"],"ok":"مُسْتَشْفَى الشِّفَاءِ"},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"مَاذَا نَقُولُ لِلْمَرِيضِ؟","opts":["لَا بَأْسَ عَلَيْكَ، سَتَكُونُ بِخَيْرٍ.","بِالصِّحَّةِ وَالْعَافِيَةِ.","كَمِ الْحِسَابُ؟"],"ok":"لَا بَأْسَ عَلَيْكَ، سَتَكُونُ بِخَيْرٍ."},{"type":"match","ins":"صِلِ الْجُمْلَةَ بِمَا يُنَاسِبُهَا","q":"Gapning boshini oxiri bilan ulang","pairs":[["أَنَا مَرِيضٌ","وَحَرَارَتِي مُرْتَفِعَةٌ."],["أَشْعُرُ بِـ","أَلَمٍ شَدِيدٍ فِي بَطْنِي."],["نَحْتَاجُ أَنْ","نَشْتَرِيَ الدَّوَاءَ مِنَ الصَّيْدَلِيَّةِ."],["لَا تَقْلَقْ","سَتَكُونُ بِخَيْرٍ."],["سَأَتَّصِلُ بِـ","سَيَّارَةِ الْإِسْعَافِ."]]},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِالضِّدِّ","q":"Soʻzni zid maʼnolisi bilan ulang","pairs":[["مَرِيضٌ","صَحِيحٌ"],["أَلَمٌ","رَاحَةٌ"],["سَرِيعٌ","بَطِيءٌ"],["مُرْتَفِعَةٌ","مُنْخَفِضَةٌ"],["شَدِيدٌ","خَفِيفٌ"]]},{"type":"choose","ins":"صِلِ الْجُمْلَةَ بِالصُّورَةِ الْمُنَاسِبَةِ","pic":"💊","q":"Rasm: dorixona javonlari oldidagi odam","opts":["اشْتَرَيْتُ الدَّوَاءَ مِنَ الصَّيْدَلِيَّةِ.","الْمُمَرِّضَةُ تُسَاعِدُ الْمَرِيضَ.","الطَّبِيبُ يَفْحَصُ الْمَرِيضَ."],"ok":"اشْتَرَيْتُ الدَّوَاءَ مِنَ الصَّيْدَلِيَّةِ."},{"type":"choose","ins":"صِلِ الْجُمْلَةَ بِالصُّورَةِ الْمُنَاسِبَةِ","pic":"📝","q":"Rasm: shifokor retsept yozmoqda","opts":["أَزُورُ الْمَرِيضَ فِي الْمُسْتَشْفَى.","كَتَبَ الطَّبِيبُ وَصْفَةَ الْعِلَاجِ.","يَتَنَاوَلُ الطِّفْلُ الدَّوَاءَ."],"ok":"كَتَبَ الطَّبِيبُ وَصْفَةَ الْعِلَاجِ."}]},{"k":"matn2","t":"Oʻqish · مَوْعِدٌ عِنْدَ الطَّبِيبِ","ar":"الْقِرَاءَةُ وَالْفَهْمُ: النَّصُّ الثَّانِي","d":"Tish shifokoriga navbat va koʻrik","items":[{"type":"read","ins":"اقْرَأْ","title":"مَوْعِدٌ عِنْدَ الطَّبِيبِ","lines":[["الْمُمَرِّضَةُ","مَرْحَبًا، عِيَادَةُ الطَّبِيبِ سَعِيدٍ لِلْأَسْنَانِ، تَفَضَّلْ.","Salom, doktor Saidning tish klinikasi, eshitaman."],["أَنَسٌ","أُرِيدُ أَنْ أَحْجِزَ مَوْعِدًا لِفَحْصِ أَسْنَانِي.","Tishlarimni koʻrikdan oʻtkazish uchun navbatga yozilmoqchiman."],["الْمُمَرِّضَةُ","فِي أَيِّ يَوْمٍ؟","Qaysi kunga?"],["أَنَسٌ","يَوْمَ السَّبْتِ فِي السَّاعَةِ الثَّامِنَةِ مَسَاءً.","Shanba kuni, kechki soat sakkizga."],["الْمُمَرِّضَةُ","الطَّبِيبُ مَشْغُولٌ فِي الثَّامِنَةِ، هَلْ يُمْكِنُ فِي السَّاعَةِ التَّاسِعَةِ؟","Doktor sakkizda band. Soat toʻqqizda boʻladimi?"],["أَنَسٌ","نَعَمْ، كَمْ ثَمَنُ الْفَحْصِ؟","Ha. Koʻrik narxi qancha?"],["الْمُمَرِّضَةُ","ثَمَنُ الْفَحْصِ 100 رِيَالٍ.","Koʻrik narxi 100 riyol."],["أَنَسٌ","سَأَدْفَعُ عِنْدَ الْحُضُورِ.","Kelganimda toʻlayman."],["الْمُمَرِّضَةُ","حَسَنًا، بِانْتِظَارِكَ.","Yaxshi, sizni kutamiz."],["","فِي الْعِيَادَةِ","Klinikada"],["الْمُمَرِّضَةُ","أَهْلًا وَسَهْلًا! تَفَضَّلْ بِالدُّخُولِ.","Xush kelibsiz! Kiring."],["الطَّبِيبُ","لَا بَأْسَ عَلَيْكَ، مَاذَا بِكَ؟","Xavotir olmang. Sizga nima boʻldi?"],["أَنَسٌ","أَشْعُرُ بِأَلَمٍ شَدِيدٍ فِي أَسْنَانِي؛ عِنْدَمَا آكُلُ حَلْوَى أَوْ أَشْرَبُ شَيْئًا بَارِدًا.","Shirinlik yesam yoki sovuq narsa ichsam, tishlarim qattiq ogʻriydi."],["الطَّبِيبُ","اجْلِسْ عَلَى الْكُرْسِيِّ، وَافْتَحْ فَمَكَ.","Kursiga oʻtiring va ogʻzingizni oching."],["الطَّبِيبُ","هُنَاكَ تَسَوُّسٌ فِي أَسْنَانِكَ، وَهَذَا هُوَ سَبَبُ الْأَلَمِ، سَأَكْتُبُ لَكَ دَوَاءً، وَأَنْصَحُكَ بِاسْتِخْدَامِ الْفُرْشَاةِ وَمَعْجُونِ الْأَسْنَانِ عِنْدَ الِاسْتِيقَاظِ وَقَبْلَ النَّوْمِ، وَالِابْتِعَادِ عَنِ الْحَلْوَى، إِذَا شَعَرْتَ بِأَلَمٍ مَرَّةً أُخْرَى؛ فَسَأَحْشُو لَكَ أَسْنَانَكَ.","Tishlaringizda chirish bor — ogʻriqning sababi shu. Sizga dori yozib beraman. Uygʻonganda va uxlashdan oldin choʻtka va tish pastasidan foydalanishni, shirinlikdan uzoq turishni maslahat beraman. Yana ogʻrisa, tishingizni plombalayman."],["أَنَسٌ","شُكْرًا لَكَ يَا طَبِيبُ.","Rahmat sizga, doktor."],["الطَّبِيبُ","أَرْجُو لَكَ الشِّفَاءَ الْعَاجِلَ.","Tezroq tuzalib keting."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"سَيَذْهَبُ أَنَسٌ إِلَى الطَّبِيبِ فِي السَّاعَةِ ……","opts":["الثَّامِنَةِ","التَّاسِعَةِ","الْعَاشِرَةِ"],"ok":"التَّاسِعَةِ","why":"Doktor sakkizda band edi, shuning uchun soat toʻqqizga yozildi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"سَيَسْتَخْدِمُ أَنَسٌ الْفُرْشَاةَ …… فِي الْيَوْمِ.","opts":["مَرَّةً وَاحِدَةً","مَرَّتَيْنِ","ثَلَاثَ مَرَّاتٍ"],"ok":"مَرَّتَيْنِ","why":"«عِنْدَ الِاسْتِيقَاظِ وَقَبْلَ النَّوْمِ» — kuniga ikki marta."},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗ بِحَسَبِ مَا قَرَأْتَ","s":"ذَهَبَ أَنَسٌ إِلَى طَبِيبِ الْعُيُونِ.","uz":"Notoʻgʻri: u tish shifokoriga (طَبِيبِ الْأَسْنَانِ) bordi.","ok":false},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗ بِحَسَبِ مَا قَرَأْتَ","s":"الطَّبِيبُ مَشْغُولٌ فِي السَّاعَةِ الثَّامِنَةِ.","uz":"Toʻgʻri: «الطَّبِيبُ مَشْغُولٌ فِي الثَّامِنَةِ».","ok":true},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"مَا سَبَبُ أَلَمِ أَنَسٍ؟","opts":["التَّسَوُّسُ فِي أَسْنَانِهِ","الْحَرَارَةُ الْمُرْتَفِعَةُ","الطَّعَامُ الْمُلَوَّثُ"],"ok":"التَّسَوُّسُ فِي أَسْنَانِهِ","why":"«هُنَاكَ تَسَوُّسٌ فِي أَسْنَانِكَ، وَهَذَا هُوَ سَبَبُ الْأَلَمِ»."},{"type":"choose","ins":"اكْتُبِ الْكَلِمَةَ الْمُنَاسِبَةَ لِلْجُمَلِ الْآتِيَةِ","q":"مَكَانٌ نَشْتَرِي مِنْهُ الدَّوَاءَ.","opts":["الصَّيْدَلِيَّةُ","الْعِيَادَةُ","الْمَدْرَسَةُ"],"ok":"الصَّيْدَلِيَّةُ"},{"type":"choose","ins":"اكْتُبِ الْكَلِمَةَ الْمُنَاسِبَةَ لِلْجُمَلِ الْآتِيَةِ","q":"امْرَأَةٌ تَعْمَلُ فِي الْمُسْتَشْفَى وَتُسَاعِدُ الطَّبِيبَ.","opts":["الْمَرِيضُ","الْمُمَرِّضَةُ","الْمُوَظَّفُ"],"ok":"الْمُمَرِّضَةُ"},{"type":"choose","ins":"اخْتَرْ حَرْفَ الْجَرِّ الْمُنَاسِبَ","q":"ابْتَعِدْ …… الطَّعَامِ الْمُلَوَّثِ.","opts":["بِـ","لِـ","فِي","عَنِ"],"ok":"عَنِ","full":"ابْتَعِدْ عَنِ الطَّعَامِ الْمُلَوَّثِ.","fz":"Ifloslangan ovqatdan uzoq tur.","why":"يَبْتَعِدُ عَنْ … — «… dan uzoqlashadi»."},{"type":"choose","ins":"اخْتَرْ حَرْفَ الْجَرِّ الْمُنَاسِبَ","q":"مَرْحَبًا بِكَ …… أَيِّ وَقْتٍ.","opts":["بِـ","لِـ","فِي","عَنْ"],"ok":"فِي","full":"مَرْحَبًا بِكَ فِي أَيِّ وَقْتٍ.","fz":"Istalgan vaqtda xush kelibsiz."},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِمَا يُنَاسِبُهَا","q":"Iborani toʻldiring","pairs":[["وَصْفَةٌ","طِبِّيَّةٌ"],["حَرَارَةٌ","مُرْتَفِعَةٌ"],["تَسَوُّسُ","الْأَسْنَانِ"],["فِي أَقْرَبِ","وَقْتٍ"]]}]},{"k":"suhbat","t":"Suhbat · الْمُحَادَثَةُ","ar":"الْمُحَادَثَةُ: الصِّحَّةُ","d":"Savollar va iboralar","items":[{"type":"read","ins":"اقْرَأْ وَأَجِبْ","title":"الصِّحَّةُ","lines":[["","كَيْفَ حَالُكَ الْيَوْمَ؟","Bugun ahvoling qanday?"],["","هَلْ أَنْتَ بِصِحَّةٍ جَيِّدَةٍ؟","Sogʻligʻing yaxshimi?"],["","هَلْ أَنْتَ مَرِيضٌ الْآنَ؟","Hozir kasalmisan?"],["","مَاذَا تَشْعُرُ عِنْدَمَا تَكُونُ مَرِيضًا؟ وَمَاذَا تَفْعَلُ؟","Kasal boʻlganingda nimani his qilasan? Nima qilasan?"],["","هَلْ تَأْكُلُ طَعَامًا صِحِّيًّا؟","Sogʻlom ovqat yeysanmi?"],["","هَلْ تَشْرَبُ الْمَاءَ كَثِيرًا؟","Suvni koʻp ichasanmi?"],["","كَمْ مَرَّةً تُمَارِسُ الرِّيَاضَةَ؟","Sport bilan necha marta shugʻullanasan?"],["","هَلْ تُحِبُّ الرِّيَاضَةَ؟","Sportni yoqtirasanmi?"],["","هَلْ تَنَامُ مُبَكِّرًا؟","Erta uxlaysanmi?"],["","كَمْ سَاعَةً تَنَامُ فِي اللَّيْلِ؟","Kechasi necha soat uxlaysan?"]]},{"type":"read","ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","title":"تَعَابِيرُ","lines":[["","أَشْعُرُ بِأَلَمٍ فِي رِجْلِي.","Oyogʻimda ogʻriq sezyapman."],["","أَشْعُرُ بِالسُّرُورِ؛ لِأَنَّنِي نَجَحْتُ فِي الِامْتِحَانِ.","Xursandman, chunki imtihondan oʻtdim."],["","يَجِبُ أَنْ تَتَنَاوَلَ الدَّوَاءَ.","Dorini ichishing kerak."],["","يَجِبُ أَنْ تَسْمَعَ كَلَامَ الْأَبَوَيْنِ.","Ota-ona gapiga quloq solishing kerak."],["","لَا أَسْتَطِيعُ أَنْ أَمْشِيَ عَلَى رِجْلِي.","Oyogʻimda yura olmayman."],["","لَا أَسْتَطِيعُ أَنْ أَقْرَأَ هَذِهِ الْكَلِمَةَ.","Bu soʻzni oʻqiy olmayman."],["","شُكْرًا لَكَ عَلَى مُسَاعَدَتِكَ.","Yordaming uchun rahmat."],["","شُكْرًا لَكَ عَلَى كُلِّ شَيْءٍ.","Hamma narsa uchun rahmat."]]},{"type":"choose","q":"مَاذَا بِكَ؟","qz":"Mos javobni tanlang","say":"مَاذَا بِكَ؟","opts":["أَشْعُرُ بِأَلَمٍ فِي رِجْلِي.","شُكْرًا لَكَ عَلَى كُلِّ شَيْءٍ.","يَجِبُ أَنْ تَتَنَاوَلَ الدَّوَاءَ."],"ok":"أَشْعُرُ بِأَلَمٍ فِي رِجْلِي."},{"type":"choose","q":"Kasal doʻstingizga «Dorini ichishing kerak» deng","opts":["يَجِبُ أَنْ تَتَنَاوَلَ الدَّوَاءَ.","لَا أَسْتَطِيعُ أَنْ أَمْشِيَ.","أَشْعُرُ بِالسُّرُورِ."],"ok":"يَجِبُ أَنْ