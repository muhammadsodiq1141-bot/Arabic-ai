{"title":"10-vahda · Salomatlik (الصِّحَّةُ)","uz":"Shifokor, kasalxona, dori; feʼlli gap tuzilishi; inkor (لَيْسَ، مَا، لَمْ، لَا، لَنْ)","a1":10,"book":"Al-Manhaj · A1","steps":[{"k":"lugat","t":"Lugʻat · الْمُفْرَدَاتُ وَالتَّرَاكِيبُ","ar":"الْمُفْرَدَاتُ وَالتَّرَاكِيبُ","d":"21 soʻz va 8 ibora: salomatlik","items":[{"type":"intro","ins":"اسْتَمِعْ وَكَرِّرْ","title":"الْمُفْرَدَاتُ","words":[["يَحْجِزُ","band qiladi (navbatga yoziladi)"],["مَشْغُولٌ","band"],["أَلَمٌ","🤕 ogʻriq"],["يَدْفَعُ","toʻlaydi"],["فُرْشَاةٌ","🪥 choʻtka"],["مَرِيضٌ","🤒 kasal, bemor"],["يَنْصَحُ","maslahat beradi"],["مَعْجُونٌ","pasta (tish pastasi)"],["مُمَرِّضَةٌ","👩‍⚕️ hamshira"],["يَبْتَعِدُ","uzoqlashadi, chetlanadi"],["مُسْتَشْفَى","🏥 kasalxona"],["دَوَاءٌ","💊 dori"],["يَسْتَخْدِمُ","ishlatadi, foydalanadi"],["عِيَادَةٌ","klinika (shifokor qabulxonasi)"],["حُقْنَةٌ","💉 ukol"],["يَفْحَصُ","tekshiradi, koʻrikdan oʻtkazadi"],["مُلَوَّثٌ","ifloslangan"],["الرَّاحَةُ","dam olish, orom"],["اسْتَلْقَى","choʻzilib yotdi"],["زِيَارَةٌ","borib koʻrish, tashrif"],["الْعُنْوَانُ","manzil"]]},{"type":"intro","ins":"اسْتَمِعْ وَكَرِّرْ","title":"التَّرَاكِيبُ","words":[["سَيَّارَةُ الْإِسْعَافِ","🚑 tez yordam mashinasi"],["تَسَوُّسُ الْأَسْنَانِ","🦷 tish chirishi (karies)"],["لَا بَأْسَ عَلَيْكَ","Xavotir olma, tuzalib ketasan"],["فِي أَقْرَبِ وَقْتٍ","imkon qadar tez"],["حَرَارَةٌ مُرْتَفِعَةٌ","🌡️ yuqori harorat (isitma)"],["حَشْوُ الْأَسْنَانِ","tish plombalash"],["وَصْفَةٌ طِبِّيَّةٌ","📝 retsept"],["أَشْعُرُ بِـ …","… ni his qilyapman"]]},{"type":"listen1","ar":"مُمَرِّضَةٌ","opts":["Hamshira","Bemor","Shifokor"],"ok":"Hamshira","why":"مُمَرِّضَةٌ — kasalxonada shifokorga yordam beradigan ayol."},{"type":"listen1","ar":"الْعُنْوَانُ","opts":["Manzil","Dam olish","Retsept"],"ok":"Manzil"},{"type":"pick","ar":"دَوَاءٌ","ok":"💊","pool":["🤕","🪥","🤒","👩‍⚕️","🏥","💊","💉","🚑","🦷","🌡️","📝"]},{"type":"pick","ar":"مُسْتَشْفَى","ok":"🏥","pool":["🤕","🪥","🤒","👩‍⚕️","🏥","💊","💉","🚑","🦷","🌡️","📝"]},{"type":"