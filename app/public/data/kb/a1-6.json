سِبَةِ أَمَامَ الْكَلِمَةِ","type":"pick","ar":"مَوْقِفُ السَّيَّارَاتِ","ok":"🅿️","pool":["🌧️","🥵","🌤️","☀️","🚦","🌡️","📺","🅿️"]},{"type":"listen1","ins":"اكْتُبْ رَقْمَ الصُّورَةِ الْمُنَاسِبَةِ أَمَامَ الْكَلِمَةِ","ar":"مُزْدَحِمٌ","opts":["Gavjum","Moʻtadil","Quyoshli"],"ok":"Gavjum"},{"type":"listen1","ins":"اكْتُبْ رَقْمَ الصُّورَةِ الْمُنَاسِبَةِ أَمَامَ الْكَلِمَةِ","ar":"اتَّجَهَ","opts":["Tomonga yurdi, yoʻl oldi","Yogʻdi","His qildi"],"ok":"Tomonga yurdi, yoʻl oldi"},{"type":"match","ins":"صِلْ بَيْنَ الْكَلِمَتَيْنِ الْمُتَنَاسِبَتَيْنِ","q":"Bir-biriga mos ikki soʻzni ulang","pairs":[["الْجَوُّ","مُشْمِسٌ"],["دَرَجَةُ","الْحَرَارَةِ"],["طَوَالَ","الْيَوْمِ"],["إِشَارَاتُ","الْمُرُورِ"],["تَحْتَ","الصِّفْرِ"],["النَّشْرَةُ","الْجَوِّيَّةُ"]]}]},{"k":"qiroat1","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ (1)","ar":"الطَّرِيقُ مُزْدَحِمٌ الْيَوْمَ","d":"Odil va Sodiq kutubxonaga boradi","items":[{"type":"read","ins":"اقْرَأْ ثُمَّ أَجِبْ","title":"الطَّرِيقُ مُزْدَحِمٌ الْيَوْمَ","lines":[["عَادِلٌ","هَيَّا يَا صَدِيقِي يَجِبُ أَنْ نَذْهَبَ إِلَى الْمَكْتَبَةِ؛ لِنَشْتَرِيَ كُتُبَ الْجَامِعَةِ.","Qani, doʻstim, kutubxonaga (kitob doʻkoniga) borishimiz kerak — universitet kitoblarini sotib olamiz."],["صَادِقٌ","أَيْنَ تَقَعُ الْمَكْتَبَةُ؟","Kutubxona qayerda joylashgan?"],["عَادِلٌ","فِي وَسَطِ الْمَدِينَةِ.","Shahar markazida."],["صَادِقٌ","وَكَيْفَ سَنَذْهَبُ إِلَى هُنَاكَ؟","U yerga qanday boramiz?"],["عَادِلٌ","سَنَرْكَبُ الْحَافِلَةَ مِنَ الْمَحَطَّةِ.","Bekatdan avtobusga chiqamiz."],["صَادِقٌ","وَأَيْنَ الْمَحَطَّةُ؟","Bekat qayerda?"],["عَادِلٌ","خَلْفَ الْجَامِعَةِ عَلَى يَمِينِ الشَّارِعِ.","Universitet orqasida, koʻchaning oʻng tomonida."],["صَادِقٌ","هَلْ هِيَ بَعِيدَةٌ؟","Uzoqmi?"],["عَادِلٌ","لَا، سَنَمْشِي مِئَةَ مِتْرٍ، ثُمَّ نَتَّجِهُ إِلَى الْيَسَارِ، سَنَجِدُ الْمَحَطَّةَ.","Yoʻq, yuz metr yuramiz, keyin chapga burilamiz — bekatni topamiz."],["صَادِقٌ","كَيْفَ سَنَعُودُ إِلَى الْجَامِعَةِ مَرَّةً أُخْرَى؟","Universitetga qanday qaytamiz?"],["عَادِلٌ","يُمْكِنُ أَنْ نَرْكَبَ الْحَافِلَةَ مِنْ أَمَامِ الْمَكْتَبَةِ.","Kutubxona oldidan avtobusga chiqsak boʻladi."],["صَادِقٌ","لٰكِنَّ وَسَطَ الْمَدِينَةِ مُزْدَحِمٌ جِدًّا وَقْتَ الظُّهْرِ، وَالْحَافِلَةُ تَقِفُ كَثِيرًا فِي الْمَحَطَّاتِ وَإِشَارَاتِ الْمُرُورِ، وَرُبَّمَا نَتَأَخَّرُ عَنْ مَوْعِدِ الدَّرْسِ.","Lekin tushda shahar markazi juda tirband boʻladi, avtobus bekatlar va svetoforlarda koʻp toʻxtaydi — darsga kechikishimiz mumkin."],["عَادِلٌ","حَسَنًا، سَنَرْكَبُ فِي الْعَوْدَةِ سَيَّارَةَ أُجْرَةٍ مِنْ مَوْقِفِ السَّيَّارَاتِ.","Mayli, qaytishda avtoturargohdan taksiga chiqamiz."]]},{"ins":"اخْتَرِ الْإِجَابَةَ الصَّحِيحَةَ","type":"choose","q":"يَذْهَبُ الصَّدِيقَانِ إِلَى ………","opts":["الْمَكْتَبَةِ","الْمَحَطَّةِ","مَوْقِفِ السَّيَّارَاتِ"],"ok":"الْمَكْتَبَةِ","full":"يَذْهَبُ الصَّدِيقَانِ إِلَى الْمَكْتَبَةِ."},{"ins":"اخْتَرِ الْإِجَابَةَ الصَّحِيحَةَ","type":"choose","q":"تَقَعُ الْمَحَطَّةُ خَلْفَ ………","opts":["الْمَكْتَبَةِ","الْجَامِعَةِ","الشَّارِعِ"],"ok":"الْجَامِعَةِ","full":"تَقَعُ الْمَحَطَّةُ خَلْفَ الْجَامِعَةِ."},{"ins":"اخْتَرِ الْإِجَابَةَ الصَّحِيحَةَ","type":"choose","q":"وَسَطُ الْمَدِينَةِ مُزْدَحِمٌ جِدًّا ………","opts":["لَيْلًا","ظُهْرًا","صَبَاحًا"],"ok":"ظُهْرًا","why":"Sodiq: «مُزْدَحِمٌ جِدًّا وَقْتَ الظُّهْرِ» — tush paytida."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗","type":"tf","s":"الْمَحَطَّةُ بَعِيدَةٌ.","uz":"Bekat uzoq.","ok":false,"why":"Odil: «لَا، سَنَمْشِي مِئَةَ مِتْرٍ» — atigi yuz metr."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗","type":"tf","s":"سَيَرْكَبَانِ الْحَافِلَةَ فِي الْعَوْدَةِ.","uz":"Qaytishda avtobusga chiqishadi.","ok":false,"why":"Qaytishda taksiga chiqishadi: «سَيَّارَةَ أُجْرَةٍ»."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗","type":"tf","s":"الْجَامِعَةُ فِي وَسَطِ الْمَدِينَةِ.","uz":"Universitet shahar markazida.","ok":false,"why":"Shahar markazida — kutubxona, universitet emas."},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"مِنْ أَيْنَ سَيَرْكَبَانِ سَيَّارَةَ الْأُجْرَةِ فِي الْعَوْدَةِ؟","opts":["مِنْ مَوْقِفِ السَّيَّارَاتِ","مِنَ الْمَحَطَّةِ","مِنْ أَمَامِ الْجَامِعَةِ"],"ok":"مِنْ مَوْقِفِ السَّيَّارَاتِ"},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِضِدِّهَا","q":"Soʻzni ziddi bilan ulang","pairs":[["بَعِيدَةٌ","قَرِيبَةٌ"],["يَمِينٌ","يَسَارٌ"],["رَكِبَ","نَزَلَ"],["الذَّهَابُ","الْعَوْدَةُ"],["مُزْدَحِمٌ","هَادِئٌ"]]},{"type":"choose","ins":"امْلَأِ الْفَرَاغَ بِالْكَلِمَةِ الْمُنَاسِبَةِ","q":"سَنَمْشِي مِئَةَ ………، ثُمَّ نَتَّجِهُ إِلَى الْيَسَارِ.","opts":["مِتْرٍ","يَمِينِ","الْمُرُورِ"],"ok":"مِتْرٍ","full":"سَنَمْشِي مِئَةَ مِتْرٍ، ثُمَّ نَتَّجِهُ إِلَى الْيَسَارِ."},{"type":"choose","ins":"امْلَأِ الْفَرَاغَ بِالْكَلِمَةِ الْمُنَاسِبَةِ","q":"الْحَافِلَةُ تَقِفُ فِي إِشَارَاتِ ……… .","opts":["الْمُرُورِ","مِتْرٍ","الْمَحَطَّةُ"],"ok":"الْمُرُورِ","full":"الْحَافِلَةُ تَقِفُ فِي إِشَارَاتِ الْمُرُورِ."},{"type":"letters","ins":"ابْحَثْ عَنِ الْكَلِمَاتِ فِي الشَّبَكَةِ","q":"Soʻzni harflardan yigʻing","show":"مَحَطَّةٌ","letters":["مَ","حَ","طَّ","ةٌ"],"uz":"bekat"}]},{"k":"qiroat2","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ (2)","ar":"كَيْفَ الْجَوُّ عِنْدَكُمْ؟","d":"Omir va Kristof fasllar haqida","items":[{"type":"read","ins":"اقْرَأْ ثُمَّ أَجِبْ","title":"كَيْفَ الْجَوُّ عِنْدَكُمْ؟","lines":[["عَامِرٌ","مَرْحَبًا يَا كِرِيسْتُوفُ! مَلَابِسُكَ خَفِيفَةٌ، أَلَا تَشْعُرُ بِالْبَرْدِ؟","Salom, Kristof! Kiyiming yupqa, sovqotmayapsanmi?"],["كِرِيسْتُوف","نَعَمْ. الْجَوُّ لَيْسَ بَارِدًا، الْجَوُّ عِنْدَكُمْ حَارٌّ.","Ha (sovqotmayapman). Havo sovuq emas, sizlarda havo issiq."],["عَامِرٌ","نَحْنُ الْآنَ فِي فَصْلِ الشِّتَاءِ يَا صَدِيقِي!","Doʻstim, hozir qish fasli-ku!"],["كِرِيسْتُوف","الشِّتَاءُ فِي مِصْرَ مِثْلُ الصَّيْفِ فِي رُوسْيَا.","Misrdagi qish Rossiyadagi yozga oʻxshaydi."],["عَامِرٌ","كَمْ دَرَجَةُ الْحَرَارَةِ فِي الشِّتَاءِ عِنْدَكُمْ؟","Sizlarda qishda harorat necha daraja boʻladi?"],["كِرِيسْتُوف","دَرَجَةُ الْحَرَارَةِ مُنْخَفِضَةٌ جِدًّا وَتَكُونُ تَحْتَ الصِّفْرِ، وَالْجَوُّ يَكُونُ بَارِدًا جِدًّا، وَتَتَسَاقَطُ الثُّلُوجُ، وَاللَّيْلُ أَطْوَلُ مِنَ النَّهَارِ.","Harorat juda past, noldan past boʻladi; havo juda sovuq, qor yogʻadi, tun kunduzdan uzun."],["عَامِرٌ","وَكَيْفَ الْجَوُّ فِي فَصْلِ الصَّيْفِ؟","Yozda havo qanday?"],["كِرِيسْتُوف","الْجَوُّ حَارٌّ وَدَافِئٌ، وَالنَّهَارُ أَطْوَلُ مِنَ اللَّيْلِ.","Havo issiq va iliq, kunduz tundan uzun."],["عَامِرٌ","وَمَاذَا عَنْ فَصْلِ الْخَرِيفِ؟","Kuz-chi?"],["كِرِيسْتُوف","الْجَوُّ فِيهِ مُتَغَيِّرٌ وَبَارِدٌ غَالِبًا، وَيَنْزِلُ كَثِيرٌ مِنَ الْمَطَرِ، وَتَتَسَاقَطُ أَوْرَاقُ الْأَشْجَارِ.","Kuzda havo oʻzgaruvchan, koʻpincha sovuq; yomgʻir koʻp yogʻadi, daraxt barglari toʻkiladi."],["عَامِرٌ","مَاذَا تُفَضِّلُ مِنَ الْفُصُولِ؟","Qaysi faslni afzal koʻrasan?"],["كِرِيسْتُوف","أُفَضِّلُ فَصْلَ الرَّبِيعِ؛ فَالْجَوُّ فِيهِ لَطِيفٌ، وَالشَّمْسُ مُشْرِقَةٌ، وَمَنْظَرُ الْأَشْجَارِ جَمِيلٌ، وَهُوَ فَصْلُ السِّيَاحَةِ عِنْدَنَا.","Bahorni afzal koʻraman: havo yoqimli, quyosh charaqlaydi, daraxtlar manzarasi chiroyli; bizda u sayyohlik fasli."],["عَامِرٌ","إِذَنْ أُسَافِرُ إِلَى رُوسْيَا فِي فَصْلِ الرَّبِيعِ.","Unda bahorda Rossiyaga boraman."],["كِرِيسْتُوف","بِانْتِظَارِكَ يَا صَدِيقِي، هَيَّا، سَنَتَأَخَّرُ عَنِ الْجَامِعَةِ.","Kutaman, doʻstim. Qani, universitetga kechikamiz."]]},{"ins":"اخْتَرِ الْإِجَابَةَ الصَّحِيحَةَ","type":"choose","q":"نَحْنُ الْآنَ فِي فَصْلِ ………","opts":["الصَّيْفِ","الشِّتَاءِ","الرَّبِيعِ"],"ok":"الشِّتَاءِ","full":"نَحْنُ الْآنَ فِي فَصْلِ الشِّتَاءِ."},{"ins":"اخْتَرِ الْإِجَابَةَ الصَّحِيحَةَ","type":"choose","q":"الرَّبِيعُ فِي رُوسْيَا فَصْلُ ………","opts":["السِّيَاحَةِ","الثُّلُوجِ","الْمَطَرِ"],"ok":"السِّيَاحَةِ","full":"الرَّبِيعُ فِي رُوسْيَا فَصْلُ السِّيَاحَةِ."},{"ins":"اخْتَرِ الْإِجَابَةَ الصَّحِيحَةَ","type":"choose","q":"سَيُسَافِرُ عَامِرٌ إِلَى ……… فِي فَصْلِ الرَّبِيعِ.","opts":["مِصْرَ","رُوسْيَا","الْقَاهِرَةِ"],"ok":"رُوسْيَا","full":"سَيُسَافِرُ عَامِرٌ إِلَى رُوسْيَا فِي فَصْلِ الرَّبِيعِ."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗","type":"tf","s":"يَشْعُرُ كِرِيسْتُوفُ بِالْبَرْدِ.","uz":"Kristof sovqotyapti.","ok":false,"why":"Kristof uchun havo issiq: «الْجَوُّ عِنْدَكُمْ حَارٌّ»."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗","type":"tf","s":"النَّهَارُ أَطْوَلُ مِنَ اللَّيْلِ فِي الشِّتَاءِ.","uz":"Qishda kunduz tundan uzun.","ok":false,"why":"Qishda: «اللَّيْلُ أَطْوَلُ مِنَ النَّهَارِ»."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗","type":"tf","s":"الشَّمْسُ مُشْرِقَةٌ فِي الرَّبِيعِ.","uz":"Bahorda quyosh charaqlaydi.","ok":true},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"كَمْ دَرَجَةُ الْحَرَارَةِ فِي الشِّتَاءِ فِي رُوسْيَا؟","opts":["تَحْتَ الصِّفْرِ","مُعْتَدِلَةٌ","مُرْتَفِعَةٌ جِدًّا"],"ok":"تَحْتَ الصِّفْرِ"},{"type":"match","ins":"صِلِ الْمُفْرَدَ بِجَمْعِهِ","q":"Birlikni koʻplik shakli bilan ulang","pairs":[["دَرَجَةٌ","دَرَجَاتٌ"],["فَصْلٌ","فُصُولٌ"],["مَنْظَرٌ","مَنَاظِرُ"],["خَبَرٌ","أَخْبَارٌ"],["ثَلْجٌ","ثُلُوجٌ"],["اللَّيْلُ","اللَّيَالِي"]]},{"type":"match","ins":"صِلِ الْجُمْلَةَ بِالْفَصْلِ الْمُنَاسِبِ لَهَا","q":"Gapni mos fasl bilan ulang","pairs":[["تَتَسَاقَطُ أَوْرَاقُ الْأَشْجَارِ فِي …","فَصْلِ الْخَرِيفِ"],["نَتَنَاوَلُ الْعَصِيرَ وَالْمُثَلَّجَاتِ فِي …","فَصْلِ الصَّيْفِ"],["تَتَسَاقَطُ الثُّلُوجُ فِي …","فَصْلِ الشِّتَاءِ"],["تَتَفَتَّحُ الْأَزْهَارُ فِي …","فَصْلِ الرَّبِيعِ"]]},{"type":"match","ins":"اخْتَرْ حَرْفَ الْجَرِّ الْمُنَاسِبَ","q":"Har bir gapga mos predlogni toping","pairs":[["صَدِيقِي يَشْعُرُ ……… الْبَرْدِ.","بِـ"],["نَزَلَ كَثِيرٌ ……… الْمَطَرِ أَمْسِ.","مِنَ"],["لَا تَتَأَخَّرْ ……… الدَّرْسِ.","عَنِ"],["الْجَوُّ حَارٌّ ……… فَصْلِ الصَّيْفِ.","فِي"],["سَأَعُودُ ……… الْبَيْتِ قَبْلَ الظُّهْرِ.","إِلَى"]]}]},{"k":"muhadatha1","t":"Suhbat · الْمُحَادَثَةُ (1)","ar":"الْأَمَاكِنُ وَالْجَوُّ","d":"Shahar va ob-havo haqida savollar","items":[{"type":"read","ins":"تَحَدَّثْ مَعَ زَمِيلِكَ مُسْتَعِينًا بِالْأَسْئِلَةِ الْآتِيَةِ","title":"الْأَمَاكِنُ وَالْجَوُّ","lines":[["","فِي أَيِّ مَدِينَةٍ تَسْكُنُ؟","Qaysi shaharda yashaysiz?"],["","هَلْ مَدِينَتُكَ كَبِيرَةٌ أَمْ صَغِيرَةٌ؟","Shahringiz kattami yoki kichikmi?"],["","هَلْ يُوجَدُ سُوقٌ فِي مِنْطَقَتِكَ؟","Hududingizda bozor bormi?"],["","أَيْنَ تَذْهَبُ فِي عُطْلَةِ نِهَايَةِ الْأُسْبُوعِ؟","Dam olish kunlari qayerga borasiz?"],["","مَا مَكَانُكَ الْمُفَضَّلُ فِي مَدِينَتِكَ؟","Shahringizdagi sevimli joyingiz qaysi?"],["","كَيْفَ الْجَوُّ الْيَوْمَ؟","Bugun ob-havo qanday?"],["","هَلِ الْجَوُّ حَارٌّ أَمْ بَارِدٌ؟","Havo issiqmi yoki sovuqmi?"],["","هَلْ تُحِبُّ الْجَوَّ الْمَاطِرَ؟","Yomgʻirli havoni yoqtirasizmi?"],["","مَا فَصْلُكَ الْمُفَضَّلُ؟","Sevimli faslingiz qaysi?"],["","هَلْ تُحِبُّ الصَّيْفَ أَمِ الشِّتَاءَ؟","Yozni yoqtirasizmi yoki qishni?"]]},{"ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","type":"choose","q":"كَيْفَ الْجَوُّ الْيَوْمَ؟","qz":"Mos javob","opts":["الْجَوُّ مُشْمِسٌ وَحَارٌّ.","أُفَضِّلُ فَصْلَ الرَّبِيعِ.","فِي وَسَطِ الْمَدِينَةِ."],"ok":"الْجَوُّ مُشْمِسٌ وَحَارٌّ."},{"ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","type":"choose","q":"مَا فَصْلُكَ الْمُفَضَّلُ؟","qz":"Mos javob","opts":["أُفَضِّلُ فَصْلَ الرَّبِيعِ.","الْجَوُّ بَارِدٌ.","نَعَمْ، يُوجَدُ سُوقٌ."],"ok":"أُفَضِّلُ فَصْلَ الرَّبِيعِ."},{"ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","type":"choose","q":"هَلْ يُوجَدُ سُوقٌ فِي مِنْطَقَتِكَ؟","qz":"Mos javob","opts":["نَعَمْ، يُوجَدُ سُوقٌ قَرِيبٌ مِنْ بَيْتِي.","الْجَوُّ حَارٌّ.","فِي فَصْلِ الشِّتَاءِ."],"ok":"نَعَمْ، يُوجَدُ سُوقٌ قَرِيبٌ مِنْ بَيْتِي."},{"type":"free","ins":"تَحَدَّثْ مَعَ زَمِيلِكَ","q":"Savollarning kamida beshtasiga oʻz shahringiz va ob-havo haqida arabcha javob bering (yozing yoki ovoz yozib yuboring).","hint":"أَسْكُنُ فِي مَدِينَةِ … . الْجَوُّ الْيَوْمَ … . أُفَضِّلُ فَصْلَ … ."}]},{"k":"muhadatha2","t":"Suhbat · الْمُحَادَثَةُ (2)","ar":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","d":"رُبَّمَا، غَالِبًا، طَوَالَ الْيَوْمِ","items":[{"type":"read","ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","title":"التَّعَابِيرُ","lines":[["رُبَّمَا","رُبَّمَا يَنْزِلُ الْمَطَرُ الْيَوْمَ.","Bugun yomgʻir yogʻishi mumkin."],["غَالِبًا","أَ