{"title":"6-vahda · Joylar va ob-havo","uz":"Shahar, yoʻnalishlar, ob-havo va fasllar; payt va oʻrin holi (ظَرْفٌ); hozirgi zamon feʼli (yakka olmoshlar)","a1":6,"book":"Al-Manhaj · A1","steps":[{"k":"mufradat","t":"Lugʻat · الْمُفْرَدَاتُ","ar":"الْمُفْرَدَاتُ","d":"Ob-havo, tomonlar, zid soʻzlar","items":[{"type":"intro","ins":"اسْتَمِعْ وَكَرِّرْ","words":[["مُعْتَدِلٌ","🌤️ moʻtadil"],["بِجَانِبِ","yonida"],["مُمْطِرٌ","🌧️ yomgʻirli"],["مُزْدَحِمٌ","gavjum, tirband"],["غَائِمٌ","☁️ bulutli"],["اتِّجَاهٌ","🧭 yoʻnalish"],["مُشْمِسٌ","☀️ quyoshli"],["يَتَسَاقَطُ","yogʻadi, toʻkiladi"],["مَنْظَرٌ","🏞️ manzara"],["احْتِمَالٌ","ehtimol"],["عَاصِمَةٌ","poytaxt"],["حَارٌّ","🥵 issiq"],["بَارِدٌ","🥶 sovuq"],["شَرْقٌ","sharq"],["غَرْبٌ","gʻarb"],["شَمَالٌ","shimol"],["جَنُوبٌ","janub"],["يَمِينٌ","➡️ oʻng"],["يَسَارٌ","⬅️ chap"],["مُرْتَفِعٌ","baland"],["مُنْخَفِضٌ","past"],["خَفِيفَةٌ","yengil"],["شَدِيدَةٌ","kuchli, qattiq"],["نَهَارًا","kunduzi"],["لَيْلًا","🌙 kechasi"]]},{"type":"pick","ar":"غَائِمٌ","ok":"☁️","pool":["☁️","☀️","🌧️","🌙","🧭","🏞️"]},{"type":"pick","ar":"مَنْظَرٌ","ok":"🏞️","pool":["☁️","☀️","🌧️","🌙","🧭","🏞️"]},{"type":"listen1","ar":"عَاصِمَةٌ","opts":["Poytaxt","Manzara","Yoʻnalish"],"ok":"Poytaxt"},{"type":"listen1","ar":"احْتِمَالٌ","opts":["Ehtimol","Ehtiyoj","Yoʻnalish"],"ok":"Ehtimol"},{"type":"choose","q":"مُرْتَفِعٌ","qz":"Ziddini toping","opts":["مُنْخَفِضٌ","خَفِيفَةٌ","مُعْتَدِلٌ"],"ok":"مُنْخَفِضٌ","why":"مُرْتَفِعٌ (baland) × مُنْخَفِضٌ (past)."},{"type":"choose","q":"شَرْقٌ","qz":"Ziddini toping","opts":["جَنُوبٌ","غَرْبٌ","يَمِينٌ"],"ok":"غَرْبٌ","why":"شَرْقٌ (sharq) × غَرْبٌ (gʻarb); شَمَالٌ × جَنُوبٌ."}]},{"k":"tarakib","t":"Iboralar · التَّرَاكِيبُ","ar":"التَّرَاكِيبُ","d":"8 ta tayyor ibora","items":[{"type":"intro","ins":"اسْتَمِعْ وَكَرِّرْ","words":[["يَشْعُرُ بِـ","…ni his qiladi"],["مَوْقِفُ السَّيَّارَاتِ","🅿️ avtoturargoh"],["إِشَارَاتُ الْمُرُورِ","🚦 svetofor"],["أَوْرَاقُ الشَّجَرِ","🍂 daraxt barglari"],["طَوَالَ الْيَوْمِ","