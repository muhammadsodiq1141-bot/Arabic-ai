ةٌ (stol) elektr jihozi emas."},{"type":"classify","ins":"صَنِّفِ الْكَلِمَاتِ بِحَسَبِ الْجَدْوَلِ","q":"Har bir buyum qaysi xonada boʻladi?","cols":["غُرْفَةُ النَّوْمِ","غُرْفَةُ الْجُلُوسِ","الْمَطْبَخُ","الْحَمَّامُ"],"words":[["سَرِيرٌ",0],["خِزَانَةُ مَلَابِسَ",0],["أَرِيكَةٌ",1],["سَجَّادَةٌ",1],["فُرْنٌ",2],["طَبَقٌ",2],["مِلْعَقَةٌ",2],["ثَلَّاجَةٌ",2],["سِكِّينٌ",2],["شَوْكَةٌ",2],["حَوْضٌ",3]]},{"type":"letters","ins":"ابْحَثْ عَنِ الْكَلِمَاتِ فِي الشَّبَكَةِ","q":"Soʻzni harflardan yigʻing","show":"مِصْبَاحٌ","letters":["مِ","صْ","بَا","حٌ"],"uz":"chiroq","pic":"💡"},{"type":"letters","ins":"ابْحَثْ عَنِ الْكَلِمَاتِ فِي الشَّبَكَةِ","q":"Soʻzni harflardan yigʻing","show":"جَرَسٌ","letters":["جَ","رَ","سٌ"],"uz":"qoʻngʻiroq","pic":"🔔"}]},{"k":"qiroat1","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ (1)","ar":"أَسْكُنُ فِي شَقَّةٍ مَفْرُوشَةٍ","d":"Haysam va Hozim suhbati","items":[{"type":"read","ins":"اقْرَأْ ثُمَّ أَجِبْ","title":"أَسْكُنُ فِي شَقَّةٍ مَفْرُوشَةٍ","lines":[["هَيْثَمٌ","أَيْنَ تَسْكُنُ يَا حَازِمُ؟","Qayerda yashaysan, Hozim?"],["حَازِمٌ","أَسْكُنُ فِي شَقَّةٍ مَفْرُوشَةٍ.","Mebelli kvartirada yashayman."],["هَيْثَمٌ","وَأَيْنَ تَقَعُ الشَّقَّةُ؟","Kvartira qayerda joylashgan?"],["حَازِمٌ","تَقَعُ فِي حَيِّ السَّعَادَةِ، قَرِيبٌ مِنْ وَسَطِ الْمَدِينَةِ.","«Saodat» mahallasida, shahar markaziga yaqin."],["هَيْثَمٌ","فِي أَيِّ طَابَقٍ الشَّقَّةُ؟","Kvartira nechanchi qavatda?"],["حَازِمٌ","فِي الطَّابَقِ الْخَامِسِ.","Beshinchi qavatda."],["هَيْثَمٌ","هَلْ هُنَاكَ مِصْعَدٌ؟","Lift bormi?"],["حَازِمٌ","نَعَمْ، مَوْجُودٌ.","Ha, bor."],["هَيْثَمٌ","كَمْ غُرْفَةً فِي الشَّقَّةِ؟","Kvartirada nechta xona bor?"],["حَازِمٌ","فِي الشَّقَّةِ غُرْفَتَانِ: غُرْفَةُ النَّوْمِ وَفِيهَا سَرِيرٌ وَخِزَانَةُ مَلَابِسَ، وَغُرْفَةُ الْجُلُوسِ وَفِيهَا أَرِيكَةٌ وَطَاوِلَةٌ وَتِلْفَازٌ، إِضَافَةً إِلَى صَالَةٍ صَغِيرَةٍ وَمَطْبَخٍ وَحَمَّامٍ.","Kvartirada ikki xona bor: yotoqxona — unda karavot va kiyim shkafi; mehmonxona — unda divan, stol va televizor. Bundan tashqari kichik zal, oshxona va hammom bor."],["هَيْثَمٌ","هَلْ لَدَيْكَ شُرْفَةٌ فِي شَقَّتِكَ؟","Kvartirangda balkon bormi?"],["حَازِمٌ","نَعَمْ، هُنَاكَ شُرْفَةٌ تُطِلُّ عَلَى الْحَدِيقَةِ.","Ha, bogʻga qaragan balkon bor."],["هَيْثَمٌ","أُرِيدُ أَنْ أَزُورَكَ لِأَرَى الشَّقَّةَ.","Kvartirani koʻrish uchun mehmonga bormoqchiman."],["حَازِمٌ","بِكُلِّ سُرُورٍ، أَنْتَظِرُكَ يَوْمَ الْعُطْلَةِ.","Jon deb, dam olish kuni kutaman."]]},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"يَسْكُنُ حَازِمٌ فِي ………","opts":["بَيْتٍ كَبِيرٍ","شَقَّةٍ مَفْرُوشَةٍ","فُنْدُقٍ"],"ok":"شَقَّةٍ مَفْرُوشَةٍ","full":"يَسْكُنُ حَازِمٌ فِي شَقَّةٍ مَفْرُوشَةٍ."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"فِي الشَّقَّةِ ………","opts":["غُرْفَةٌ وَاحِدَةٌ","غُرْفَتَانِ","ثَلَاثُ غُرَفٍ"],"ok":"غُرْفَتَانِ","full":"فِي الشَّقَّةِ غُرْفَتَانِ.","why":"Hozim: «فِي الشَّقَّةِ غُرْفَتَانِ» — yotoqxona va mehmonxona."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"الشَّقَّةُ فِي الطَّابَقِ ………","opts":["الْأَوَّلِ","الثَّالِثِ","الْخَامِسِ"],"ok":"الْخَامِسِ","full":"الشَّقَّةُ فِي الطَّابَقِ الْخَامِسِ."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ النَّصِّ","type":"tf","s":"الصَّدِيقَانِ يَسْكُنَانِ فِي شَقَّةٍ وَاحِدَةٍ.","uz":"Ikki doʻst bitta kvartirada yashaydi.","ok":false,"why":"Haysam Hozimning kvartirasini koʻrgani bormoqchi — demak, ular birga yashamaydi."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ النَّصِّ","type":"tf","s":"لَيْسَ هُنَاكَ مِصْعَدٌ.","uz":"Lift yoʻq.","ok":false,"why":"Hozim: «نَعَمْ، مَوْجُودٌ» — lift bor."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ النَّصِّ","type":"tf","s":"الشَّقَّةُ قَرِيبَةٌ مِنْ وَسَطِ الْمَدِينَةِ.","uz":"Kvartira shahar markaziga yaqin.","ok":true},{"type":"classify","ins":"اذْكُرِ الْأَثَاثَ الْمَوْجُودَ فِي الشَّقَّةِ","q":"Hozimning kvartirasida bormi? ✓ — bor, ✗ — yoʻq","cols":["✓","✗"],"words":[["سَرِيرٌ",0],["خِزَانَةُ مَلَابِسَ",0],["أَرِيكَةٌ",0],["طَاوِلَةٌ",0],["تِلْفَازٌ",0],["سَجَّادَةٌ",1],["مِرْآةٌ",1],["غَسَّالَةٌ",1]]},{"type":"match","ins":"أَكْمِلْ بِالْكَلِمَةِ الْمُنَاسِبَةِ","q":"Har bir gapga mos soʻzni toping","pairs":[["الشَّقَّةُ فِي ……… خَامِسٍ.","طَابَقٍ"],["الْغُرْفَةُ ……… .","وَاسِعَةٌ"],["تَقَعُ الشَّقَّةُ فِي ……… جَمِيلٍ.","حَيٍّ"],["……… تُطِلُّ عَلَى الْحَدِيقَةِ.","الشُّرْفَةُ"],["لِي ……… طَيِّبٌ فِي الشَّقَّةِ الْمُجَاوِرَةِ.","جَارٌ"]]},{"type":"match","ins":"صِلِ الْفِعْلَ بِمَا يُنَاسِبُهُ","q":"Feʼlni gapning davomi bilan ulang","pairs":[["تَتَكَوَّنُ","شَقَّتِي مِنْ أَرْبَعِ غُرَفٍ"],["أَسْكُنُ","فِي مَدِينَةِ الْقَاهِرَةِ"],["تَقَعُ","الشَّقَّةُ فِي وَسَطِ الْمَدِينَةِ"],["أَحْتَاجُ","إِلَى أَثَاثٍ جَدِيدٍ لِلشَّقَّةِ"],["تُطِلُّ","شُرْفَتِي عَلَى حَدِيقَةِ الْبَيْتِ"]]},{"type":"choose","ins":"اكْتُبِ اسْمَ الْأَثَاثِ ثُمَّ صِلْهُ بِلَوْنِهِ","q":"سِتَارَةٌ ………","qz":"Rasmda: qizil parda","opts":["أَحْمَرُ","حَمْرَاءُ","زَرْقَاءُ"],"ok":"حَمْرَاءُ","full":"سِتَارَةٌ حَمْرَاءُ","fz":"qizil parda","why":"سِتَارَةٌ muannas (ة) — rang ham muannas shaklda: حَمْرَاءُ."},{"type":"choose","ins":"اكْتُبِ اسْمَ الْأَثَاثِ ثُمَّ صِلْهُ بِلَوْنِهِ","q":"كُرْسِيٌّ ………","qz":"Rasmda: koʻk stul","pic":"🪑","opts":["زَرْقَاءُ","أَزْرَقُ","أَخْضَرُ"],"ok":"أَزْرَقُ","full":"كُرْسِيٌّ أَزْرَقُ","fz":"koʻk stul","why":"كُرْسِيٌّ muzakkar — rang muzakkar shaklda: أَزْرَقُ."}]},{"k":"qiroat2","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ (2)","ar":"جَارُنَا الْجَدِيدُ","d":"Er, xotin va yangi qoʻshni","items":[{"type":"read","ins":"اقْرَأْ ثُمَّ أَجِبْ","title":"جَارُنَا الْجَدِيدُ","lines":[["الزَّوْجُ","أَيْنَ الْعَصِيرُ؟ جَارُنَا الْجَدِيدُ سَيَأْتِي الْآنَ.","Sharbat qani? Yangi qoʻshnimiz hozir keladi."],["الزَّوْجَةُ","الْعَصِيرُ جَاهِزٌ فِي صَالَةِ الْجُلُوسِ، الْجَرَسُ يَرِنُّ، افْتَحِ الْبَابَ.","Sharbat mehmonxonada tayyor. Qoʻngʻiroq jiringlayapti, eshikni och."],["الزَّوْجُ","مَرْحَبًا بِجَارِنَا الْجَدِيدِ، تَفَضَّلْ.","Yangi qoʻshnimiz, xush kelibsiz, marhamat."],["الْجَارُ","شُكْرًا لَكَ.","Rahmat."],["الزَّوْجُ","مَا أَخْبَارُ الشَّقَّةِ الْجَدِيدَةِ؟","Yangi kvartira qalay?"],["الْجَارُ","الشَّقَّةُ جَمِيلَةٌ وَأَعْجَبَتْنِي كَثِيرًا، وَهِيَ تَتَكَوَّنُ مِنْ ثَلَاثِ غُرَفٍ، وَصَالَةٍ كَبِيرَةٍ، وَمَطْبَخٍ وَاسِعٍ، إِضَافَةً إِلَى حَمَّامَيْنِ.","Kvartira chiroyli, menga juda yoqdi. U uch xona, katta zal, keng oshxona va ikkita hammomdan iborat."],["الزَّوْجُ","مُمْتَازٌ، وَأَيْضًا تُطِلُّ الشُّرْفَةُ عَلَى حَدِيقَةِ الْحَيِّ.","Aʼlo, yana balkon mahalla bogʻiga qaraydi."],["الْجَارُ","نَعَمْ، هٰذَا أَجْمَلُ شَيْءٍ!","Ha, eng chiroylisi shu!"],["الزَّوْجُ","وَمَاذَا عَنِ الْإِيجَارِ؟ هَلْ هُوَ غَالٍ؟","Ijara-chi? Qimmatmi?"],["الْجَارُ","لَا، الْإِيجَارُ مُنَاسِبٌ، ٣٠٠ دُولَارٍ فِي الشَّهْرِ، وَيَشْمَلُ خِدْمَاتِ الْمَاءِ وَالْغَازِ وَالْكَهْرَبَاءِ، وَمَكَانًا لِلسَّيَّارَةِ، لٰكِنْ أَحْتَاجُ إِلَى الْمُسَاعَدَةِ فِي شِرَاءِ بَعْضِ الْأَثَاثِ.","Yoʻq, ijara maqbul: oyiga 300 dollar, suv, gaz, elektr xizmatlari va mashina joyi ham kiradi. Lekin baʼzi mebellarni sotib olishda yordam kerak."],["الزَّوْجُ","بِكُلِّ سُرُورٍ، مَاذَا تُرِيدُ أَنْ تَشْتَرِيَ؟","Jon deb. Nima sotib olmoqchisiz?"],["الْجَارُ","أَحْتَاجُ سَجَّادَةً وَسِتَارَةً وَطَاوِلَةً لِلتِّلْفَازِ، إِضَافَةً إِلَى الْأَجْهِزَةِ الْكَهْرَبَائِيَّةِ كَالثَّلَّاجَةِ وَالْغَسَّالَةِ وَالْمِكْوَاةِ وَبَعْضِ أَدَوَاتِ الْمَطْبَخِ.","Gilam, parda va televizor stoli kerak; yana muzlatgich, kir yuvish mashinasi, dazmol kabi elektr jihozlari va baʼzi oshxona anjomlari."],["الزَّوْجُ","حَسَنًا! نَشْرَبُ الْعَصِيرَ أَوَّلًا، ثُمَّ نَذْهَبُ إِلَى الْمَتْجَرِ.","Yaxshi! Avval sharbat ichamiz, keyin doʻkonga boramiz."]]},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"جَهَّزَتِ الزَّوْجَةُ ………","opts":["الشَّايَ","الْقَهْوَةَ","الْعَصِيرَ"],"ok":"الْعَصِيرَ","full":"جَهَّزَتِ الزَّوْجَةُ الْعَصِيرَ."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"يَحْتَاجُ الْجَارُ الْمُسَاعَدَةَ فِي ………","opts":["شِرَاءِ الْأَثَاثِ","طَبْخِ الطَّعَامِ","أُجْرَةِ الْبَيْتِ"],"ok":"شِرَاءِ الْأَثَاثِ","full":"يَحْتَاجُ الْجَارُ الْمُسَاعَدَةَ فِي شِرَاءِ الْأَثَاثِ."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"سَيَذْهَبُ الزَّوْجُ مَعَ الْجَارِ إِلَى ………","opts":["السُّوقِ","الْمَتْجَرِ","الْمَكْتَبَةِ"],"ok":"الْمَتْجَرِ","full":"سَيَذْهَبُ الزَّوْجُ مَعَ الْجَارِ إِلَى الْمَتْجَرِ."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"يُرِيدُ الْجَارُ أَنْ يَشْتَرِيَ ………","opts":["تِلْفَازًا","حَاسُوبًا","ثَلَّاجَةً"],"ok":"ثَلَّاجَةً","full":"يُرِيدُ الْجَارُ أَنْ يَشْتَرِيَ ثَلَّاجَةً."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","type":"tf","s":"إِيجَارُ الشَّقَّةِ غَالِي الثَّمَنِ.","uz":"Kvartira ijarasi qimmat.","ok":false,"why":"Qoʻshni: «لَا، الْإِيجَارُ مُنَاسِبٌ» — ijara maqbul."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","type":"tf","s":"فِي الشَّقَّةِ حَمَّامٌ وَاحِدٌ.","uz":"Kvartirada bitta hammom bor.","ok":false,"why":"Matnda: «إِضَافَةً إِلَى حَمَّامَيْنِ» — ikkita hammom."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","type":"tf","s":"تُطِلُّ الشُّرْفَةُ عَلَى الْحَدِيقَةِ.","uz":"Balkon bogʻga qaraydi.","ok":true},{"ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","type":"choose","q":"كَمْ إِيجَارُ الشَّقَّةِ الْجَدِيدَةِ؟","opts":["٣٠٠ دُولَارٍ فِي الشَّهْرِ","٣ دُولَارَاتٍ فِي الشَّهْرِ","لَا يُوجَدُ إِيجَارٌ"],"ok":"٣٠٠ دُولَارٍ فِي الشَّهْرِ"},{"ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","type":"choose","q":"مَاذَا طَلَبَتِ الزَّوْجَةُ مِنَ الزَّوْجِ؟","opts":["أَنْ يَفْتَحَ الْبَابَ","أَنْ يَشْرَبَ الْعَصِيرَ","أَنْ يَذْهَبَ إِلَى الْمَتْجَرِ"],"ok":"أَنْ يَفْتَحَ الْبَابَ","why":"Xotin: «الْجَرَسُ يَرِنُّ، افْتَحِ الْبَابَ» — eshikni ochishni soʻradi."},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِالصُّورَةِ","q":"Soʻzni maʼnosi bilan ulang","pairs":[["أَرِيكَةٌ","🛋️ divan"],["مِدْفَأَةٌ","isitgich"],["غَسَّالَةٌ","kir yuvish mashinasi"],["مِرْآةٌ","🪞 koʻzgu"],["خِزَانَةُ أَطْبَاقٍ","idish javoni"],["فُرْنٌ","pech, plita"]]},{"type":"match","ins":"اخْتَرْ حَرْفَ الْجَرِّ الْمُنَاسِبَ","q":"Har bir gapga mos predlogni toping","pairs":[["تُطِلُّ غُرْفَتِي ……… الْحَدِيقَةِ.","عَلَى"],["تَقَعُ الْجَامِعَةُ ……… وَسَطِ الْمَدِينَةِ.","فِي"],["تَتَكَوَّنُ الشَّقَّةُ ……… غُرْفَتَيْنِ وَصَالَةٍ.","مِنْ"],["مَاذَا ……… أَخْبَارِ الشَّقَّةِ الْجَدِيدَةِ؟","عَنْ"],["أَحْتَاجُ ……… الْمُسَاعَدَةِ فِي شِرَاءِ الْأَثَاثِ.","إِلَى"]]}]},{"k":"muhadatha1","t":"Suhbat · الْمُحَادَثَةُ (1)","ar":"السَّكَنُ وَالْأَثَاثُ","d":"Uy haqida savollar","items":[{"type":"read","ins":"تَحَدَّثْ مَعَ زَمِيلِكَ","title":"السَّكَنُ وَالْأَثَاثُ","lines":[["","أَيْنَ تَسْكُنُ؟","Qayerda yashaysiz?"],["","هَلْ تَسْكُنُ فِي بَيْتٍ أَمْ فِي شَقَّةٍ؟","Uyda yashaysizmi yoki kvartirada?"],["","هَلْ بَيْتُكَ كَبِيرٌ أَمْ صَغِيرٌ؟","Uyingiz kattami yoki kichikmi?"],["","كَمْ غُرْفَةً فِي بَيْتِكَ؟","Uyingizda nechta xona bor?"],["","مَا غُرْفَتُكَ الْمُفَضَّلَةُ فِي الْبَيْتِ؟","Uydagi sevimli xonangiz qaysi?"],["","هَلْ لَدَيْكَ غُرْفَةٌ خَاصَّةٌ؟","Shaxsiy xonangiz bormi?"],["","مَاذَا يُوجَدُ فِي غُرْفَةِ النَّوْمِ؟","Yotoqxonangizda nimalar bor?"],["","أَيْنَ تَضَعُ الْكُتُبَ؟","Kitoblarni qayerga qoʻyasiz?"],["","هَلْ يُوجَدُ تِلْفَازٌ فِي بَيْتِكَ؟","Uyingizda televizor bormi?"],["","أَيْنَ تَضَعُ الْمَلَابِسَ؟","Kiyimlarni qayerga qoʻyasiz?"]]},{"ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","type":"choose","q":"أَيْنَ تَسْكُنُ؟","qz":"Mos javob","opts":["أَسْكُنُ فِي شَقَّةٍ مَفْرُوشَةٍ.","فِي الطَّابَقِ الْخَامِسِ.","بِكُلِّ سُرُورٍ."],"ok":"أَسْكُنُ فِي شَقَّةٍ مَفْرُوشَةٍ."},{"ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","type":"choose","q":"كَمْ غُرْفَةً فِي بَيْتِكَ؟","qz":"Mos javob","opts":["فِي بَيْتِي ثَلَاثُ غُرَفٍ.","بَيْتِي قَرِيبٌ مِنَ الْجَامِعَةِ.","نَعَمْ، مَوْجُودٌ."],"ok":"فِي بَيْتِي ثَلَاثُ غُرَفٍ."},{"ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","type":"choose","q":"مَاذَا يُوجَدُ فِي غُرْفَةِ النَّوْمِ؟","qz":"Mos javob","opts":["سَرِيرٌ وَخِزَانَةُ مَلَابِسَ.","فُرْنٌ وَثَلَّاجَةٌ.","حَوْضٌ وَمِرْآةٌ."],"ok":"سَرِيرٌ وَخِزَانَةُ مَلَابِسَ."},{"ins":"اخْتَرِ الْجَوَابَ الْمُنَاسِبَ","type":"choose","q":"أَيْنَ تَضَعُ الْمَلَابِسَ؟","qz":"Mos javob","opts":["فِي خِزَانَةِ الْمَلَابِسِ.","فِي الثَّلَّاجَةِ.","عَلَى الْأَرِيكَةِ."],"ok":"فِي خِزَانَةِ الْمَلَابِسِ."},{"type":"free","ins":"تَحَدَّثْ مَعَ زَمِيلِكَ","q":"Yuqoridagi savollarning kamida beshtasiga oʻzingiz haqingizda arabcha javob bering (yozing yoki ovoz yozib yuboring).","hint":"أَسْكُنُ فِي … . فِي بَيْتِي … غُرَفٍ. فِي غُرْفَةِ النَّوْمِ سَرِيرٌ وَ… ."}]},{"k":"muhadatha2","t":"Suhbat · الْمُحَادَثَةُ (2)","ar":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","d":"Iboralar va ularga misollar","items":[{"type":"read","ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","title":"التَّعَابِيرُ","lines":[["قَرِيبٌ مِنْ","بَيْتِي قَرِيبٌ مِنَ الْجَامِعَةِ.","Uyim universitetga yaqin."],["قَرِيبٌ مِنْ","هُنَاكَ مَطْعَمٌ قَرِيبٌ مِنْ مَعْهَدِ اللُّغَاتِ.","Tillar institutiga yaqin bir restoran bor."],["تُطِلُّ عَلَى","الشَّقَّةُ تُطِلُّ عَلَى الْبَحْرِ.","Kvartira dengizga qaraydi."],["تُطِلُّ عَلَى","الْمَدْرَسَةُ تُطِلُّ عَلَى الشَّارِعِ.","Maktab koʻchaga qaraydi."],["إِضَافَةً إِلَى","أَكَلْتُ الْبَطَاطِسَ، إِضَافَةً إِلَى السَّلَطَةِ.","Kartoshka yedim, yana salat ham."],["إِضَافَةً إِلَى","اشْتَرَيْتُ بُرْتُقَالًا وَمَوْزًا، إِضَافَةً إِلَى التُّفَّاحِ.","Apelsin va banan oldim, yana olma ham."],["خَاصٌّ بِـ","هٰذَا الْهَاتِفُ خَاصٌّ بِي.","Bu telefon meniki."],["خَاصٌّ بِـ","الْكُرْسِيُّ الْكَبِيرُ خَاصٌّ بِالْمُعَلِّمِ.","Katta stul oʻqituvchiniki."],["يَتَكَوَّنُ مِنْ","الْبَيْتُ يَتَكَوَّنُ مِنْ غُرْفَتَيْنِ وَصَالَةٍ.","Uy ikki xona va zaldan iborat."],["يَتَكَوَّنُ مِنْ","الْعَصِيرُ يَتَكَوَّنُ مِنْ مَاءٍ، وَفَاكِهَةٍ، وَسُكَّرٍ.","Sharbat suv, meva va shakardan iborat."],["تَقَعُ … فِي","تَقَعُ شَقَّتِي فِي وَسَطِ الْمَدِينَةِ.","Kvartiram shahar markazida joylashgan."],["تَقَعُ … فِي","تَقَعُ مِصْرُ فِي قَارَّةِ أَفْرِيقْيَا.","Misr Afrika qitʼasida joylashgan."]]},{"ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","type":"choose","q":"بَيْتِي قَرِيبٌ ……… الْجَامِعَةِ.","opts":["مِنَ","عَلَى","بِـ"],"ok":"مِنَ","full":"بَيْتِي قَرِيبٌ مِنَ الْجَامِعَةِ.","fz":"Uyim universitetga yaqin."},{"ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","type":"choose","q":"الشَّقَّةُ تُطِلُّ ……… الْبَحْرِ.","opts":["مِنَ","عَلَى","فِي"],"ok":"عَلَى","full":"الشَّقَّةُ تُطِلُّ عَلَى الْبَحْرِ.","fz":"Kvartira dengizga qaraydi."},{"ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","type":"choose","q":"هٰذَا الْهَاتِفُ خَاصٌّ ……… .","opts":["بِي","مِنِّي","عَلَيَّ"],"ok":"بِي","full":"هٰذَا الْهَاتِفُ خَاصٌّ بِي.","fz":"Bu telefon meniki."},{"ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","type":"choose","q":"الْبَيْتُ ……… مِنْ غُرْفَتَيْنِ وَصَالَةٍ.","opts":["يَتَكَوَّنُ","يَقَعُ","يُطِلُّ"],"ok":"يَتَكَوَّنُ","full":"الْبَيْتُ يَتَكَوَّنُ مِنْ غُرْفَتَيْنِ وَصَالَةٍ.","fz":"Uy ikki xona va zaldan iborat."},{"ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا","type":"choose","q":"تَقَعُ مِصْرُ ……… قَارَّةِ أَفْرِيقْيَا.","opts":["فِي","عَلَى","إِلَى"],"ok":"فِي","full":"تَقَعُ مِصْرُ فِي قَارَّةِ أَفْرِيقْيَا."}]},{"k":"qawaid1","t":"Qoida · الْقَوَاعِدُ (1)","ar":"الْجُمْلَةُ الْفِعْلِيَّةُ","d":"Feʼl bilan boshlanadigan gap","rule":{"h":"الْجُمْلَةُ الْفِعْلِيَّةُ","p":["<b>Feʼl gap</b> ( <span class=\"ar\">الْجُمْلَةُ الْفِعْلِيَّةُ</span> ) — feʼl bilan boshlanadigan gap: <span class=\"ar\">تُطِلُّ الشُّرْفَةُ عَلَى الْبَحْرِ.</span>","Ot bilan boshlansa — <b>ot gap</b> ( <span class=\"ar\">الْجُمْلَةُ الِاسْمِيَّةُ</span> ): <span class=\"ar\">صَالَةُ الْبَيْتِ وَاسِعَةٌ.</span>","Feʼl uch xil: <b>oʻtgan zamon</b> <span class=\"ar\">مَاضٍ</span> — <span class=\"ar\">سَكَنَ</span>; <b>hozirgi-kelasi</b> <span class=\"ar\">مُضَارِعٌ</span> — <span class=\"ar\">يَسْكُنُ</span>; <b>buyruq</b> <span class=\"ar\">أَمْرٌ</span> — <span class=\"ar\">اسْكُنْ</span>."]},"items":[{"type":"read","ins":"اقْرَأِ الْجُمَلَ الْآتِيَةَ، وَلَاحِظِ الْكَلِمَاتِ الْمُلَوَّنَةَ","title":"الْمَاضِي · الْمُضَارِعُ · الْأَمْرُ","lin