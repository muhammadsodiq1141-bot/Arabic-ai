ins":"صَنِّفِ الصُّوَرَ حَسَبَ الْجَدْوَلِ","q":"Turi boʻyicha ajrating","cols":["عَقْلِيَّةٌ","بَدَنِيَّةٌ"],"words":[["الْمَتَاهَةُ",0],["الْكَلِمَاتُ الْمُتَقَاطِعَةُ",0],["رَفْعُ الْأَثْقَالِ",1],["الشِّطْرَنْجُ",0],["كُرَةُ الْقَدَمِ",1]]},{"type":"classify","ins":"صَنِّفِ الصُّوَرَ حَسَبَ الْجَدْوَلِ","q":"Mashgʻulot usuli boʻyicha ajrating","cols":["فَرْدِيَّةٌ","ثُنَائِيَّةٌ","جَمَاعِيَّةٌ"],"words":[["الْمَتَاهَةُ",0],["الْكَلِمَاتُ الْمُتَقَاطِعَةُ",0],["رَفْعُ الْأَثْقَالِ",0],["الشِّطْرَنْجُ",1],["كُرَةُ الْقَدَمِ",2]]}]},{"k":"matn1","t":"Oʻqish · هِوَايَتِي فِي وَقْتِ الْفَرَاغِ","ar":"الْقِرَاءَةُ وَالْفَهْمُ: النَّصُّ الْأَوَّلُ","d":"Sinfda: har kimning xobbisi","items":[{"type":"read","ins":"اقْرَأْ","title":"هِوَايَتِي فِي وَقْتِ الْفَرَاغِ","lines":[["الْمُعَلِّمُ","مَرْحَبًا بِكُمْ طُلَّابِي! نَحْنُ نَعْرِفُ أَنَّ الرِّيَاضَةَ وَمُمَارَسَةَ الْهِوَايَاتِ مُفِيدَةٌ جِدًّا، فَهِيَ تُنَشِّطُ الْجِسْمَ وَتُقَوِّي الْعَضَلَاتِ وَتَزِيدُ الذَّكَاءَ. وَنُرِيدُ الْيَوْمَ أَنْ نَتَعَرَّفَ عَلَى هِوَايَاتِكُمُ الْمُفَضَّلَةِ.","Xush kelibsiz, talabalarim! Bilamizki, sport va xobbi bilan shugʻullanish juda foydali: u tanani tetiklashtiradi, muskullarni kuchaytiradi va zehnni oshiradi. Bugun sevimli mashgʻulotlaringiz bilan tanishmoqchimiz."],["سَعْدٌ","أَنَا أُحِبُّ الْهِوَايَاتِ الْعَقْلِيَّةَ مِثْلَ حَلِّ الْأَلْغَازِ وَالْقِرَاءَةِ.","Men jumboq yechish va kitob oʻqish kabi aqliy mashgʻulotlarni yaxshi koʻraman."],["الْمُعَلِّمُ","هَلْ تُمَارِسُ رِيَاضَةً بَدَنِيَّةً؟","Jismoniy sport bilan shugʻullanasanmi?"],["سَعْدٌ","نَعَمْ. أُمَارِسُ كُرَةَ الْقَدَمِ مَعَ أَصْدِقَائِي يَوْمَ الْعُطْلَةِ.","Ha. Dam olish kuni doʻstlarim bilan futbol oʻynayman."],["فِرَاسٌ","أَنَا هِوَايَتِي الْبَدَنِيَّةُ: الْمُلَاكَمَةُ، وَهِوَايَتِي الْعَقْلِيَّةُ: قِرَاءَةُ الْكُتُبِ الْأَدَبِيَّةِ.","Mening jismoniy xobbim — boks, aqliy xobbim — badiiy kitoblar oʻqish."],["الْمُعَلِّمُ","وَمَاذَا عَنْكِ يَا كَرِيمَةُ؟","Senchi, Karima?"],["كَرِيمَةُ","أَنَا مَاهِرَةٌ جِدًّا فِي التَّطْرِيزِ وَالرَّسْمِ، إِضَافَةً إِلَى هِوَايَةِ تَرْبِيَةِ الْحَيَوَانَاتِ الْأَلِيفَةِ.","Men kashtachilik va rasm chizishda juda mohirman, bundan tashqari uy hayvonlarini boqishni yoqtiraman."],["الْمُعَلِّمُ","وَأَنْتِ يَا هُدَى؟","Sen-chi, Hudo?"],["هُدَى","بِالنِّسْبَةِ إِلَيَّ أُحِبُّ تَعَلُّمَ اللُّغَاتِ، فَأَنَا أَعْرِفُ الْإِنْجِلِيزِيَّةَ وَالْعَرَبِيَّةَ وَالتُّرْكِيَّةَ.","Men uchun — tillarni oʻrganishni yaxshi koʻraman: ingliz, arab va turk tillarini bilaman."],["الْمُعَلِّمُ","مُمْتَازٌ! تَعَلُّمُ اللُّغَاتِ يُنَشِّطُ الْعَقْلَ وَيَزِيدُ الذَّكَاءَ.","Ajoyib! Til oʻrganish aqlni charxlaydi va zehnni oshiradi."],["الطُّلَّابُ","وَمَاذَا عَنْكُمْ يَا أُسْتَاذُ؟","Sizchi, ustoz?"],["الْمُعَلِّمُ","أَنَا هِوَايَتِي الْقِرَاءَةُ وَالْكِتَابَةُ، بِالْإِضَافَةِ إِلَى رِيَاضَةِ الْمَشْيِ، أُمَارِسُهَا فِي وَقْتِ الْفَرَاغِ.","Mening xobbim — oʻqish va yozish, bundan tashqari piyoda yurish; boʻsh vaqtimda shugʻullanaman."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"يُمَارِسُ فِرَاسٌ رِيَاضَةَ ……","opts":["السِّبَاحَةِ","الْمُلَاكَمَةِ","التَّزَلُّجِ"],"ok":"الْمُلَاكَمَةِ","full":"يُمَارِسُ فِرَاسٌ رِيَاضَةَ الْمُلَاكَمَةِ.","fz":"Firos boks bilan shugʻullanadi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"يُمَارِسُ …… رِيَاضَةَ الْمَشْيِ.","opts":["سَعْدٌ","فِرَاسٌ","الْمُعَلِّمُ"],"ok":"الْمُعَلِّمُ","full":"يُمَارِسُ الْمُعَلِّمُ رِيَاضَةَ الْمَشْيِ.","fz":"Oʻqituvchi piyoda yurish bilan shugʻullanadi."},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗، مَعَ تَصْحِيحِ الْخَطَأِ","s":"يُمَارِسُ سَعْدٌ رِيَاضَةَ كُرَةِ السَّلَّةِ.","uz":"Notoʻgʻri: Saʼd futbol (كُرَةَ الْقَدَمِ) oʻynaydi.","ok":false},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗، مَعَ تَصْحِيحِ الْخَطَأِ","s":"يُمَارِسُ سَعْدٌ هِوَايَتَهُ يَوْمَ الْعُطْلَةِ.","uz":"Toʻgʻri: «يَوْمَ الْعُطْلَةِ» — dam olish kuni.","ok":true},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"كَمْ لُغَةً تَعْرِفُ هُدَى؟","opts":["لُغَتَيْنِ","ثَلَاثَ لُغَاتٍ","أَرْبَعَ لُغَاتٍ"],"ok":"ثَلَاثَ لُغَاتٍ","why":"الْإِنْجِلِيزِيَّةَ وَالْعَرَبِيَّةَ وَالتُّرْكِيَّةَ — uchta til."},{"type":"match","ins":"امْلَأِ الْجَدْوَلَ بِالْبَيَانَاتِ الْآتِيَةِ","q":"Kimning xobbisi qaysi? Ulang","pairs":[["سَعْدٌ","كُرَةُ الْقَدَمِ"],["فِرَاسٌ","الْمُلَاكَمَةُ"],["كَرِيمَةُ","التَّطْرِيزُ وَالرَّسْمُ"],["هُدَى","تَعَلُّمُ اللُّغَاتِ"],["الْمُعَلِّمُ","رِيَاضَةُ الْمَشْيِ"]]},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِالضِّدِّ","q":"Soʻzni zid maʼnolisi bilan ulang","pairs":[["تُقَوِّي","تُضْعِفُ"],["مُفِيدَةٌ","ضَارَّةٌ"],["تَزِيدُ","تُنْقِصُ"],["أُحِبُّ","أَكْرَهُ"],["مَشْغُولٌ","مُتَفَرِّغٌ"]]},{"type":"pick","ins":"اكْتُبِ اسْمَ الْهِوَايَةِ تَحْتَ كُلِّ صُورَةٍ","ar":"التَّصْوِيرُ","ok":"📷","pool":["📷","🎣","🐈","⛸️","🍳","✈️","🧵","🏇"]},{"type":"pick","ins":"اكْتُبِ اسْمَ الْهِوَايَةِ تَحْتَ كُلِّ صُورَةٍ","ar":"صَيْدُ السَّمَكِ","ok":"🎣","pool":["📷","🎣","🐈","⛸️","🍳","✈️","🧵","🏇"]},{"type":"pick","ins":"اكْتُبِ اسْمَ الْهِوَايَةِ تَحْتَ كُلِّ صُورَةٍ","ar":"رُكُوبُ الْخَيْلِ","ok":"🏇","pool":["📷","🎣","🐈","⛸️","🍳","✈️","🧵","🏇"]}]},{"k":"matn2","t":"Oʻqish · رِيَاضَتِي الْمُفَضَّلَةُ","ar":"الْقِرَاءَةُ وَالْفَهْمُ: النَّصُّ الثَّانِي","d":"Honiy va Odil: suzish va yugurish","items":[{"type":"read","ins":"اقْرَأْ","title":"رِيَاضَتِي الْمُفَضَّلَةُ","lines":[["هَانِي","مَرْحَبًا عَادِلُ، أَيْنَ سَتَذْهَبُ؟","Salom, Odil, qayerga ketyapsan?"],["عَادِلٌ","مَرْحَبًا هَانِي، سَأَذْهَبُ إِلَى النَّادِي.","Salom, Honiy, klubga boraman."],["هَانِي","مَا الرِّيَاضَةُ الَّتِي تُمَارِسُهَا؟","Qaysi sport bilan shugʻullanasan?"],["عَادِلٌ","أُمَارِسُ رِيَاضَةَ السِّبَاحَةِ.","Suzish bilan shugʻullanaman."],["هَانِي","كَمْ يَوْمًا تُمَارِسُهَا فِي الْأُسْبُوعِ؟","Haftada necha kun shugʻullanasan?"],["عَادِلٌ","أُمَارِسُهَا يَوْمَيْنِ فِي الْأُسْبُوعِ.","Haftada ikki kun."],["هَانِي","هَلْ شَارَكْتَ فِي مُسَابَقَاتٍ؟","Musobaqalarda qatnashganmisan?"],["عَادِلٌ","لَا، هِيَ هِوَايَةٌ جَمِيلَةٌ، أَشْعُرُ بِالسَّعَادَةِ وَأَنَا أُمَارِسُهَا، وَأَيْضًا مُفِيدَةٌ لِلْجِسْمِ.","Yoʻq, bu shunchaki goʻzal mashgʻulot: shugʻullanganimda oʻzimni baxtli his qilaman, tanaga ham foydali."],["هَانِي","هَلْ تُمَارِسُ السِّبَاحَةَ فِي فَصْلِ الشِّتَاءِ؟","Qishda ham suzasanmi?"],["عَادِلٌ","لَا، فِي الشِّتَاءِ أُمَارِسُ رِيَاضَةَ التَّزَلُّجِ عَلَى الْجَلِيدِ. وَأَنْتَ هَلْ تُمَارِسُ الرِّيَاضَةَ؟","Yoʻq, qishda muzda uchaman. Sen-chi, sport bilan shugʻullanasanmi?"],["هَانِي","نَعَمْ، أُمَارِسُ رِيَاضَةَ الْجَرْيِ يَوْمِيًّا.","Ha, har kuni yuguraman."],["عَادِلٌ","أَيْنَ تُمَارِسُ هِوَايَتَكَ؟","Qayerda shugʻullanasan?"],["هَانِي","فِي حَدِيقَةِ الْحَيِّ صَبَاحًا، أَرَاكَ لَاحِقًا.","Ertalab mahalla bogʻida. Keyin koʻrishamiz."],["عَادِلٌ","مَعَ السَّلَامَةِ.","Xayr."]]},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"سَيَذْهَبُ عَادِلٌ إِلَى ……","opts":["الْحَدِيقَةِ","النَّادِي","السُّوقِ"],"ok":"النَّادِي","full":"سَيَذْهَبُ عَادِلٌ إِلَى النَّادِي.","fz":"Odil klubga boradi."},{"type":"choose","ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","q":"يُمَارِسُ عَادِلٌ هِوَايَتَهُ …… فِي الْأُسْبُوعِ.","opts":["مَرَّةً","مَرَّتَيْنِ","ثَلَاثَ مَرَّاتٍ"],"ok":"مَرَّتَيْنِ","why":"«يَوْمَيْنِ فِي الْأُسْبُوعِ» — haftada ikki marta."},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗، مَعَ تَصْحِيحِ الْخَطَأِ","s":"شَارَكَ عَادِلٌ فِي مُسَابَقَاتٍ كَثِيرَةٍ.","uz":"Notoʻgʻri: «لَا» dedi — musobaqalarda qatnashmagan.","ok":false},{"type":"tf","ins":"ضَعْ عَلَامَةَ ✓ أَوْ عَلَامَةَ ✗، مَعَ تَصْحِيحِ الْخَطَأِ","s":"يَذْهَبُ هَانِي إِلَى الْحَدِيقَةِ كُلَّ يَوْمٍ.","uz":"Toʻgʻri: u har kuni (يَوْمِيًّا) mahalla bogʻida yuguradi.","ok":true},{"type":"choose","ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","q":"مَا هِوَايَةُ عَادِلٍ فِي فَصْلِ الشِّتَاءِ؟","opts":["السِّبَاحَةُ","الْجَرْيُ","التَّزَلُّجُ عَلَى الْجَلِيدِ"],"ok":"التَّزَلُّجُ عَلَى الْجَلِيدِ"},{"type":"match","ins":"صِلِ الْجُمْلَةَ بِالْكَلِمَةِ الَّتِي تَدُلُّ عَلَيْهَا","q":"Taʼrifni soʻz bilan ulang","pairs":[["هِوَايَةٌ بَدَنِيَّةٌ نُمَارِسُهَا فِي الْبَحْرِ.","السِّبَاحَةُ"],["وَقْتٌ نُمَارِسُ فِيهِ الْهِوَايَاتِ.","وَقْتُ الْفَرَاغِ"],["هِوَايَةٌ عَقْلِيَّةٌ تَحْتَاجُ إِلَى تَفْكِيرٍ.","حَلُّ الْأَلْغَازِ"],["مَكَانٌ وَاسِعٌ نُمَارِسُ فِيهِ الرِّيَاضَةَ.","النَّادِي"],["أَلْعَابٌ نُمَارِسُهَا فِي الْهَاتِفِ أَوِ الْحَاسُوبِ.","أَلْعَابٌ إِلِكْتْرُونِيَّةٌ"]]},{"type":"choose","ins":"اخْتَرْ حَرْفَ الْجَرِّ الْمُنَاسِبَ","q":"صَدِيقِي مَاهِرٌ جِدًّا …… السِّبَاحَةِ.","opts":["عَنْ","بِـ","فِي","إِلَى","عَلَى"],"ok":"فِي","full":"صَدِيقِي مَاهِرٌ جِدًّا فِي السِّبَاحَةِ.","fz":"Doʻstim suzishda juda mohir.","why":"مَاهِرٌ فِي … — «… da mohir»."},{"type":"choose","ins":"اخْتَرْ حَرْفَ الْجَرِّ الْمُنَاسِبَ","q":"يَنْصَحُ الْأَطِبَّاءُ …… مُمَارَسَةِ الرِّيَاضَةِ.","opts":["عَنْ","بِـ","فِي","إِلَى","عَلَى"],"ok":"بِـ","full":"يَنْصَحُ الْأَطِبَّاءُ بِمُمَارَسَةِ الرِّيَاضَةِ.","fz":"Shifokorlar sport bilan shugʻullanishni maslahat beradi.","why":"يَنْصَحُ بِـ … — «… ni maslahat beradi»."},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِالْمَعْنَى الْمُنَاسِبِ","q":"Soʻzni maʼnodoshi bilan ulang","pairs":[["هِوَايَةٌ","رِيَاضَةٌ"],["سَعَادَةٌ","سُرُورٌ"],["مُفِيدَةٌ","نَافِعَةٌ"],["أَشْعُرُ","أُحِسُّ"],["بَدَنِيَّةٌ","جِسْمِيَّةٌ"],["الْجَلِيدُ","الثَّلْجُ"]]}]},{"k":"suhbat","t":"Suhbat · الْمُحَادَثَةُ","ar":"الْمُحَادَثَةُ: الْهِوَايَاتُ وَالرِّيَاضَةُ","d":"Savollar va iboralar","items":[{"type":"read","ins":"اقْرَأْ وَأَجِبْ","title":"الْهِوَايَاتُ وَالرِّيَاضَةُ","lines":[["","مَا هِوَايَتُكَ؟","Sevimli mashgʻuloting nima?"],["","هَلْ تُحِبُّ الرِّيَاضَةَ؟","Sportni yoqtirasanmi?"],["","مَا رِيَاضَتُكَ الْمُفَضَّلَةُ؟","Eng sevimli sporting qaysi?"],["","هَلْ تَلْعَبُ كُرَةَ الْقَدَمِ؟","Futbol oʻynaysanmi?"],["","مَعَ مَنْ تَلْعَبُ الرِّيَاضَةَ؟","Sportni kim bilan oʻynaysan?"],["","كَمْ مَرَّةً تُمَارِسُ الرِّيَاضَةَ فِي الْأُسْبُوعِ؟","Haftasiga necha marta sport bilan shugʻullanasan?"],["","هَلْ تَذْهَبُ إِلَى النَّادِي الرِّيَاضِيِّ؟","Sport klubiga borasanmi?"],["","هَلْ تُفَضِّلُ الرِّيَاضَةَ الْفَرْدِيَّةَ أَمِ الْجَمَاعِيَّةَ؟","Yakka sportni afzal koʻrasanmi yoki jamoaviysini?"],["","هَلْ تُحِبُّ السِّبَاحَةَ؟","Suzishni yoqtirasanmi?"],["","هَلْ تُحِبُّ الْجَرْيَ؟","Yugurishni yoqtirasanmi?"]]},{"type":"read","ins":"تَأَمَّلِ التَّعَابِيرَ الْآتِيَةَ، وَهَاتِ مِثْلَهَا مِنْ عِنْدِكَ","title":"تَعَابِيرُ","lines":[["","أَنَا مَاهِرٌ فِي رِيَاضَةِ السِّبَاحَةِ.","Men suzish sportida mohirman."],["","أُمِّي مَاهِرَةٌ فِي طَبْخِ الطَّعَامِ.","Onam ovqat pishirishda mohir."],["","أُمَارِسُ رِيَاضَةَ الْمَشْيِ يَوْمِيًّا.","Har kuni piyoda yurish bilan shugʻullanaman."],["","أَذْهَبُ لِزِيَارَةِ أَقَارِبِي أُسْبُوعِيًّا.","Har hafta qarindoshlarimni koʻrgani boraman."],["","يَنْصَحُ الْمُعَلِّمُ بِالْقِرَاءَةِ كَثِيرًا.","Oʻqituvchi koʻp oʻqishni maslahat beradi."],["","يَنْصَحُ الطَّبِيبُ بِتَنَاوُلِ الْخَضْرَاوَاتِ الطَّازَجَةِ.","Shifokor yangi sabzavotlar yeyishni maslahat beradi."],["","بِالنِّسْبَةِ إِلَيَّ أُفَضِّلُ فَصْلَ الصَّيْفِ لِأُمَارِسَ هِوَايَاتِي.","Men uchun — xobbilarim bilan shugʻullanish uchun yozni afzal koʻraman."],["","بِالنِّسْبَةِ إِلَيَّ أُفَضِّلُ الدَّجَاجَ الْمَشْوِيَّ لِأَنَّ طَعْمَهُ لَذِيذٌ.","Men uchun — grilda pishirilgan tovuqni afzal koʻraman, chunki mazasi yoqimli."]]},{"type":"choose","q":"مَا رِيَاضَتُكَ الْمُفَضَّلَةُ؟","qz":"Mos javobni tanlang","say":"مَا رِيَاضَتُكَ الْمُفَضَّلَةُ؟","opts":["أُمَارِسُ رِيَاضَةَ السِّبَاحَةِ.","أَرَاكَ لَاحِقًا.","مَعَ السَّلَامَةِ."],"ok":"أُمَارِسُ رِيَاضَةَ السِّبَاحَةِ."},{"type":"choose","q":"«Men har kuni piyoda yuraman» qanday aytiladi?","opts":["أُمَارِسُ رِيَاضَةَ الْمَشْيِ يَوْمِيًّا.","أَذْهَبُ لِزِيَارَةِ أَقَارِبِي أُسْبُوعِيًّا.","أَنَا مَاهِرٌ فِي رِيَاضَةِ السِّبَاحَةِ."],"ok":"أُمَارِسُ رِيَاضَةَ الْمَشْيِ يَوْمِيًّا.","why":"يَوْمِيًّا — har kuni, أُسْبُوعِيًّا — har hafta."},{"type":"choose","q":"بِالنِّسْبَةِ إِلَيَّ أُفَضِّلُ فَصْلَ الصَّيْفِ.","qz":"Maʼnosi qaysi?","opts":["Men uchun yoz fasli afzal.","Men yozda sport qilmayman.","Yoz fasli juda issiq."],"ok":"Men uchun yoz fasli afzal.","why":"أُفَضِّلُ — afzal koʻraman (kitobda bu yerda xato bilan أَفْضَلُ bosilgan)."},{"type":"free","ins":"تَحَدَّثْ","q":"Savollardan 4 tasiga oʻzingiz haqingizda arabcha javob bering (yozing yoki ovoz bilan ayting): مَا هِوَايَتُكَ؟ مَا رِيَاضَتُكَ الْمُفَضَّلَةُ؟ كَمْ مَرَّةً تُمَارِسُ الرِّيَاضَةَ فِي الْأُسْبُوعِ؟ هَلْ تُفَضِّلُ الرِّيَاضَةَ الْفَرْدِيَّةَ أَمِ الْجَمَاعِيَّةَ؟","hint":"هِوَايَتِي … أُمَارِسُ … يَوْمِيًّا."}]},{"k":"qoida1","t":"Qoida · الصِّفَةُ وَالْمَوْصُوفُ","ar":"الصِّفَةُ وَالْمَوْصُوفُ","d":"Sifat mavsufga toʻrt jihatdan ergashadi","rule":{"h":"الصِّفَةُ وَالْمَوْصُوفُ","p":["Sifat (<span class=\"ar\">الصِّفَةُ</span>) oʻzidan oldingi otni tasvirlaydi; oʻsha ot — <b>mavsuf</b> (<span class=\"ar\">الْمَوْصُوفُ</span>): <span class=\"ar\">أُفَضِّلُ الرِّيَاضَةَ الْعَقْلِيَّةَ</span>.","Sifat mavsufga 4 narsada ergashadi: <b>kelishik</b>, <b>son</b>, <b>jins</b>, <b>aniqlik</b>.","<span class=\"ar\">تُسَاعِدُ الرِّيَاضَةُ عَلَى النَّوْمِ الْهَادِئِ - أُحِبُّ مُشَاهَدَةَ مَنْظَرِ الْبَحْرِ الْجَمِيلِ</span>."]},"items":[{"type":"choose","ins":"اخْتَرِ الصِّفَةَ الْمُنَاسِبَةَ وَاكْتُبْهَا فِي الْفَرَاغِ","q":"يُحِبُّ صَدِيقِي اللَّوْنَ ……","opts":["الصَّغِيرَ","الْأَزْرَقَ","السَّمِينَ"],"ok":"الْأَزْرَقَ","full":"يُحِبُّ صَدِيقِي اللَّوْنَ الْأَزْرَقَ.","fz":"Doʻstim koʻk rangni yoqtiradi."},{"type":"choose","ins":"اخْتَرِ الصِّفَةَ الْمُنَاسِبَةَ وَاكْتُبْهَا فِي الْفَرَاغِ","q":"جَمْعُ الطَّوَابِعِ هِوَايَةٌ ……","opts":["جَدِيدَةٌ","صَغِيرَةٌ","مُمْتِعَةٌ"],"ok":"مُمْتِعَةٌ","full":"جَمْعُ الطَّوَابِعِ هِوَايَةٌ مُمْتِعَةٌ.","fz":"Marka yigʻish — qiziqarli mashgʻulot."},{"type":"choose","ins":"اخْتَرِ الصِّفَةَ الْمُنَاسِبَةَ وَاكْتُبْهَا فِي الْفَرَاغِ","q":"وَضَعْتُ الْكُتُبَ …… فِي الْحَقِيبَةِ.","opts":["النَّشِيطَةَ","الْحَزِينَةَ","الْجَدِيدَةَ"],"ok":"الْجَدِيدَةَ","full":"وَضَعْتُ الْكُتُبَ الْجَدِيدَةَ فِي الْحَقِيبَةِ.","fz":"Yangi kitoblarni sumkaga soldim.","why":"الْكُتُبَ — aniq va tushum kelishigida, s