 <span class=\"ar\">تِلْكَ</span>: <span class=\"ar\">تِلْكَ سَيَّارَاتٌ</span> (✓), <span class=\"ar\">أُولَئِكَ سَيَّارَاتٌ</span> (✗)."]},"items":[{"type":"classify","ins":"اقْرَأِ الْجُمَلَ الْآتِيَةَ، وَلَاحِظِ الْفَرْقَ بَيْنَ الْقَرِيبِ وَالْبَعِيدِ","q":"Yaqin va uzoqni ajrating","cols":["الْقَرِيبُ","الْبَعِيدُ"],"words":[["هَذَا",0],["ذَلِكَ",1],["هَذِهِ",0],["تِلْكَ",1],["هَؤُلَاءِ",0],["أُولَئِكَ",1]]},{"type":"choose","ins":"حَوِّلِ اسْمَ الْإِشَارَةِ الْقَرِيبَ إِلَى اسْمِ إِشَارَةٍ لِلْبَعِيدِ","q":"هَذَا الْمَنْظَرُ جَمِيلٌ. ← …… الْمَنْظَرُ جَمِيلٌ.","opts":["ذَلِكَ","تِلْكَ","أُولَئِكَ"],"ok":"ذَلِكَ","full":"ذَلِكَ الْمَنْظَرُ جَمِيلٌ.","fz":"Anavi manzara chiroyli."},{"type":"choose","ins":"حَوِّلِ اسْمَ الْإِشَارَةِ الْقَرِيبَ إِلَى اسْمِ إِشَارَةٍ لِلْبَعِيدِ","q":"هَؤُلَاءِ الرِّجَالُ يُمَارِسُونَ الرِّيَاضَةَ. ← …… الرِّجَالُ يُمَارِسُونَ الرِّيَاضَةَ.","opts":["ذَلِكَ","تِلْكَ","أُولَئِكَ"],"ok":"أُولَئِكَ","full":"أُولَئِكَ الرِّجَالُ يُمَارِسُونَ الرِّيَاضَةَ.","fz":"Anavi erkaklar sport bilan shugʻullanishyapti."},{"type":"choose","ins":"اخْتَرِ اسْمَ الْإِشَارَةِ الْمُنَاسِبَ","q":"مِنْ أَيْنَ …… الرِّجَالُ؟","opts":["هَاتَانِ","أُولَئِكَ","تِلْكَ"],"ok":"أُولَئِكَ","full":"مِنْ أَيْنَ أُولَئِكَ الرِّجَالُ؟","fz":"Anavi erkaklar qayerdan?"},{"type":"choose","ins":"اخْتَرِ اسْمَ الْإِشَارَةِ الْمُنَاسِبَ","q":"…… الْجِبَالُ عَالِيَةٌ.","opts":["هَؤُلَاءِ","أُولَئِكَ","تِلْكَ"],"ok":"تِلْكَ","full":"تِلْكَ الْجِبَالُ عَالِيَةٌ.","fz":"Anavi togʻlar baland.","why":"الْجِبَالُ — jonsiz narsalar koʻpligi: تِلْكَ."},{"type":"choose","ins":"اخْتَرِ اسْمَ الْإِشَارَةِ الْمُنَاسِبَ","q":"…… الْمُهَنْدِسُ نَشِيطٌ.","opts":["تِلْكَ","ذَلِكَ","أُولَئِكَ"],"ok":"ذَلِكَ","full":"ذَلِكَ الْمُهَنْدِسُ نَشِيطٌ.","fz":"Anavi muhandis gʻayratli."},{"type":"choose","ins":"حَوِّلِ الضَّمِيرَ إِلَى اسْمِ إِشَارَةٍ مُنَاسِبٍ، كَمَا فِي الْمِثَالِ","q":"هُمَا رَسَّامَانِ مَاهِرَانِ. (قَرِيبٌ)","opts":["هَذَانِ","هَاتَانِ","هَؤُلَاءِ"],"ok":"هَذَانِ","full":"هَذ