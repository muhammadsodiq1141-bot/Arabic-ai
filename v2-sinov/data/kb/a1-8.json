 — طَاوِلَةٌ — سَلَطَةٌ — حَسَاءٌ","qz":"Guruhga mos kelmaydigan soʻz","opts":["عَصِيرٌ","طَاوِلَةٌ","سَلَطَةٌ","حَسَاءٌ"],"ok":"طَاوِلَةٌ","why":"طَاوِلَةٌ (stol) — mebel, yeb-ichiladigan narsa emas."},{"ins":"اخْتَرِ الْكَلِمَةَ الْمُخْتَلِفَةَ","type":"choose","q":"الْفَطُورُ — الْغَدَاءُ — الْعَشَاءُ — الظُّهْرُ","qz":"Guruhga mos kelmaydigan soʻz","opts":["الْفَطُورُ","الْغَدَاءُ","الْعَشَاءُ","الظُّهْرُ"],"ok":"الظُّهْرُ","why":"الظُّهْرُ — tush vaqti; qolganlari ovqatlanish nomlari."},{"type":"match","ins":"صِلِ الْفِعْلَ بِالْجُمْلَةِ الْمُنَاسِبَةِ","q":"Gapning boshini davomi bilan ulang","pairs":[["شَرِبْتُ","عَصِيرَ الْبُرْتُقَالِ الطَّازَجَ."],["طَلَبْتُ مِنَ","النَّادِلِ قَائِمَةَ الْوَجَبَاتِ."],["طَبَخَتْ أُمِّي","طَعَامًا لَذِيذًا."],["أُرِيدُ أَنْ","آكُلَ الْآنَ، أَنَا جَائِعٌ جِدًّا."],["أَكَلْتُ الرُّزَّ","وَالْحَسَاءَ وَالدَّجَاجَ."]]},{"type":"match","ins":"اخْتَرِ الْكَلِمَةَ الْمُنَاسِبَةَ","q":"Har bir gapga mos soʻzni toping","pairs":[["لَا أَتَنَاوَلُ الْأَطْعِمَةَ ……… .","الدَّسِمَةَ"],["……… الْأَزْهَارِ جَمِيلَةٌ.","رَائِحَةُ"],["أَكَلْتُ ……… خَفِيفَةً فِي الْعَمَلِ.","وَجْبَةً"],["وَضَعَ ……… الطَّعَامَ عَلَى الْمَائِدَةِ.","النَّادِلُ"],["صَدِيقَتِي ………؛ لِذٰلِكَ لَا تَأْكُلُ اللُّحُومَ.","نَبَاتِيَّةٌ"]]}]},{"k":"qiroat1","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ (1)","ar":"أَنَا جَائِعٌ جِدًّا","d":"Oʻgʻil va ona: uyda tushlik","items":[{"type":"read","ins":"اقْرَأْ ثُمَّ أَجِبْ","title":"أَنَا جَائِعٌ جِدًّا","lines":[["الِابْنُ","أُمِّي، أَنَا جَائِعٌ جِدًّا.","Oyi, men juda och qoldim."],["الْأُمُّ","الطَّعَامُ جَاهِزٌ، انْتَظِرْ قَلِيلًا، سَأُعِدُّ السَّلَطَةَ الْآنَ.","Ovqat tayyor, biroz kut, hozir salat tayyorlayman."],["الِابْنُ","أَشُمُّ رَائِحَةَ طَعَامٍ لَذِيذٍ، مَاذَا طَبَخْتِ الْيَوْمَ؟","Mazali ovqat hidi kelyapti, bugun nima pishirdingiz?"],["الْأُمُّ","طَبَخْتُ رُزًّا وَفَاصُولْيَا وَحَسَاءً وَدَجَاجًا.","Guruch, loviya, shoʻrva va tovuq pishirdim."],["الِابْنُ","هَلِ الدَّجَاجُ مَسْلُوقٌ أَوْ مَقْلِيٌّ؟","Tovuq qaynatilganmi yoki qovurilganmi?"],["الْأُمُّ","دَجَاجٌ مَقْلِيٌّ كَمَا تُحِبُّ.","Oʻzing yoqtirgandek qovurilgan tovuq."],["الِابْنُ","هَلْ هُنَاكَ عَصِيرٌ؟","Sharbat bormi?"],["الْأُمُّ","نَعَمْ، عَصِيرُ الْبُرْتُقَالِ جَاهِزٌ فِي الثَّلَّاجَةِ، هَلْ تَنَاوَلْتَ شَيْئًا فِي الْمَدْرَسَةِ؟","Ha, apelsin sharbati muzlatgichda tayyor. Maktabda biror narsa yedingmi?"],["الِابْنُ","نَعَمْ، أَكَلْتُ شَطِيرَةَ جُبْنٍ.","Ha, pishloqli buterbrod yedim."],["الْأُمُّ","حَسَنًا، اشْرَبِ الْعَصِيرَ، وَبَدِّلْ مَلَابِسَكَ، وَسَأَضَعُ الطَّعَامَ عَلَى الْمَائِدَةِ.","Yaxshi, sharbatni ich, kiyimingni almashtir, men ovqatni dasturxonga qoʻyaman."],["الِابْنُ","سَلِمَتْ يَدَاكِ يَا أُمِّي.","Qoʻlingiz dard koʻrmasin, oyijon."]]},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"رَجَعَ الِابْنُ مِنَ ………","opts":["الْمَتْجَرِ","الْمَدْرَسَةِ","السُّوقِ"],"ok":"الْمَدْرَسَةِ","full":"رَجَعَ الِابْنُ مِنَ الْمَدْرَسَةِ."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"شَرِبَ الِابْنُ عَصِيرَ ………","opts":["اللَّيْمُونِ","التُّفَّاحِ","الْبُرْتُقَالِ"],"ok":"الْبُرْتُقَالِ","full":"شَرِبَ الِابْنُ عَصِيرَ الْبُرْتُقَالِ."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"سَيَتَنَاوَلُ الِابْنُ وَجْبَةَ ………","opts":["الْفَطُورِ","الْغَدَاءِ","الْعَشَاءِ"],"ok":"الْغَدَاءِ","full":"سَيَتَنَاوَلُ الِابْنُ وَجْبَةَ الْغَدَاءِ."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","type":"tf","s":"سَأَلَ الِابْنُ عَنْ نَوْعِ الدَّجَاجِ.","uz":"Oʻgʻil tovuqning turi haqida soʻradi.","ok":true},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","type":"tf","s":"شَرِبَ الِابْنُ الْعَصِيرَ بَعْدَ الطَّعَامِ.","uz":"Oʻgʻil sharbatni ovqatdan keyin ichdi.","ok":false,"why":"Ona ovqatni dasturxonga qoʻyishdan oldin «اشْرَبِ الْعَصِيرَ» dedi."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗ بِحَسَبِ مَا قَرَأْتَ","type":"tf","s":"سَيَضَعُ الِابْنُ الطَّعَامَ عَلَى الْمَائِدَةِ.","uz":"Ovqatni dasturxonga oʻgʻil qoʻyadi.","ok":false,"why":"Ona: «سَأَضَعُ الطَّعَامَ عَلَى الْمَائِدَةِ» — ona qoʻyadi."},{"ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","type":"choose","q":"أَيْنَ وَضَعَتِ الْأُمُّ الْعَصِيرَ؟","opts":["فِي الثَّلَّاجَةِ","عَلَى الْمَائِدَةِ","فِي الْمَدْرَسَةِ"],"ok":"فِي الثَّلَّاجَةِ"},{"ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","type":"choose","q":"مَاذَا تَنَاوَلَ الِابْنُ خَارِجَ الْبَيْتِ؟","opts":["شَطِيرَةَ جُبْنٍ","دَجَاجًا مَقْلِيًّا","حَسَاءً"],"ok":"شَطِيرَةَ جُبْنٍ"},{"type":"match","ins":"صِلِ الْكَلِمَةَ بِمَا يُنَاسِبُهَا","q":"Matndagi birikmalarni tiklang","pairs":[["سَلِمَتْ","يَدَاكِ"],["رَائِحَةُ","طَعَامٍ"],["عَصِيرُ","الْبُرْتُقَالِ"],["الدَّجَاجُ","الْمَقْلِيُّ"],["انْتَظِرْ","قَلِيلًا"]]},{"type":"match","ins":"صِلِ الْفِعْلَ بِالْجُمْلَةِ الْمُنَاسِبَةِ","q":"Feʼlni gapning davomi bilan ulang","pairs":[["آكُلُ","الْجُبْنَ وَالْبَيْضَ فِي الْفَطُورِ."],["أَشْرَبُ","الشَّايَ بَعْدَ الطَّعَامِ غَالِبًا."],["وَضَعَ","النَّادِلُ الطَّعَامَ عَلَى الْمَائِدَةِ."],["أَشُمُّ","رَائِحَةَ طَعَامٍ جَمِيلَةً."],["طَبَخَتْ","أُمِّي الرُّزَّ وَالدَّجَاجَ."]]},{"type":"letters","ins":"امْلَأِ الشَّكْلَ بِأَسْمَاءِ الصُّوَرِ","q":"Rasmdagi narsa nomini yozing","show":"عَسَلٌ","letters":["عَ","سَ","لٌ"],"uz":"asal","pic":"🍯"}]},{"k":"qiroat2","t":"Oʻqish · الْقِرَاءَةُ وَالْفَهْمُ (2)","ar":"الْغَدَاءُ فِي الْمَطْعَمِ","d":"Restoranda tushlik","items":[{"type":"read","ins":"اقْرَأْ ثُمَّ أَجِبْ","title":"الْغَدَاءُ فِي الْمَطْعَمِ","lines":[["النَّادِلُ","مَرْحَبًا بِكُمْ! تَفَضَّلُوا.","Xush kelibsizlar! Marhamat."],["سَالِمٌ","هَلْ هُنَاكَ طَاوِلَةٌ فَارِغَةٌ؟","Boʻsh stol bormi?"],["النَّادِلُ","نَعَمْ، الطَّاوِلَةُ رَقْمُ عَشَرَةٍ بِجِوَارِ النَّافِذَةِ.","Ha, deraza yonidagi oʻninchi stol."],["صَابِرٌ","مِنْ فَضْلِكَ أُرِيدُ قَائِمَةَ الطَّعَامِ.","Iltimos, menyuni bering."],["النَّادِلُ","تَفَضَّلِ الْقَائِمَةَ، هُنَا الشَّطَائِرُ وَهُنَا الْوَجَبَاتُ.","Mana menyu: bu yerda buterbrodlar, bu yerda taomlar."],["صَابِرٌ","مَاذَا سَتَأْكُلُ يَا سَالِمُ؟","Nima yeysan, Solim?"],["سَالِمٌ","أُرِيدُ وَجْبَةً دَسِمَةً مِنَ الدَّجَاجِ الْمَشْوِيِّ مَعَ الْحَسَاءِ وَالسَّلَطَةِ.","Shoʻrva va salat bilan grilda pishgan tovuqdan toʻyimli taom xohlayman."],["صَابِرٌ","وَأَنَا أُرِيدُ وَجْبَةً مِنَ السَّمَكِ مَعَ الرُّزِّ وَالسَّلَطَةِ.","Men esa guruch va salat bilan baliq xohlayman."],["النَّادِلُ","مَاذَا عَنِ الْمَشْرُوبَاتِ؟","Ichimliklar-chi?"],["سَالِمٌ","سَأَشْرَبُ عَصِيرَ اللَّيْمُونِ.","Limon sharbati ichaman."],["صَابِرٌ","وَأَنَا سَأَشْرَبُ الشَّايَ، لٰكِنْ مِنْ فَضْلِكَ، أُرِيدُ الشَّايَ بَعْدَ الطَّعَامِ.","Men choy ichaman, lekin iltimos, choyni ovqatdan keyin olib keling."],["النَّادِلُ","بِكُلِّ سُرُورٍ.","Jon deb."],["صَابِرٌ","لَا تَتَأَخَّرْ؛ أَنَا جَائِعٌ جِدًّا، وَلَدَيْنَا عَمَلٌ كَثِيرٌ.","Kechikmang, men juda ochman, ishimiz ham koʻp."],["النَّادِلُ","عَشْرَ دَقَائِقَ لَا أَكْثَرَ.","Oʻn daqiqa, ortiq emas."],["","بَعْدَ الطَّعَامِ","(Ovqatdan keyin)"],["النَّادِلُ","بِالْهَنَاءِ وَالشِّفَاءِ.","Yoqimli ishtaha!"],["سَالِمٌ","شُكْرًا، كَمِ الْحِسَابُ مِنْ فَضْلِكَ؟","Rahmat, hisob qancha, iltimos?"],["النَّادِلُ","مِئَةٌ وَأَرْبَعُونَ دِينَارًا.","Bir yuz qirq dinor."],["سَالِمٌ","تَفَضَّلْ، وَالْبَاقِي لَكَ.","Marhamat, qaytimi sizga."]]},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"طَلَبَ صَابِرٌ مِنَ النَّادِلِ ………","opts":["قَائِمَةَ الطَّعَامِ","الْحِسَابَ","طَاوِلَةً فَارِغَةً"],"ok":"قَائِمَةَ الطَّعَامِ","full":"طَلَبَ صَابِرٌ مِنَ النَّادِلِ قَائِمَةَ الطَّعَامِ."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"سَيَتَنَاوَلُ صَابِرٌ وَجْبَةً مِنَ ………","opts":["الدَّجَاجِ","السَّمَكِ","الْحَسَاءِ"],"ok":"السَّمَكِ","full":"سَيَتَنَاوَلُ صَابِرٌ وَجْبَةً مِنَ السَّمَكِ."},{"ins":"اخْتَرِ الْجَوَابَ الصَّحِيحَ","type":"choose","q":"سَيَأْكُلُ سَالِمٌ الدَّجَاجَ ………","opts":["الْمَسْلُوقَ","الْمَقْلِيَّ","الْمَشْوِيَّ"],"ok":"الْمَشْوِيَّ","full":"سَيَأْكُلُ سَالِمٌ الدَّجَاجَ الْمَشْوِيَّ."},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗","type":"tf","s":"سَأَلَ سَالِمٌ عَنْ طَاوِلَةٍ فَارِغَةٍ.","uz":"Solim boʻsh stol haqida soʻradi.","ok":true},{"ins":"ضَعْ عَلَامَةَ ✓ أَوْ ✗","type":"tf","s":"الْحِسَابُ مِئَةٌ وَخَمْسُونَ دِينَارًا.","uz":"Hisob bir yuz ellik dinor.","ok":false,"why":"Ofitsiant: «مِئَةٌ وَأَرْبَعُونَ دِينَارًا» — 140 dinor."},{"ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","type":"choose","q":"مَاذَا سَيَشْرَبُ سَالِمٌ؟","opts":["عَصِيرَ اللَّيْمُونِ","الشَّايَ","الْقَهْوَةَ"],"ok":"عَصِيرَ اللَّيْمُونِ"},{"ins":"أَجِبْ عَنِ الْأَسْئِلَةِ الْآتِيَةِ","type":"choose","q":"مَنْ دَفَعَ الْحِسَابَ؟","opts":["سَالِمٌ","صَابِرٌ","النَّادِلُ"],"ok":"سَالِمٌ","why":"Solim: «تَفَضَّلْ، وَالْبَاقِي لَكَ» — u toʻladi."},{"type":"match","ins":"رَتِّبِ الْجُمَلَ كَمَا وَرَدَتْ فِي النَّصِّ","q":"Gaplarni matndagi tartib raqami bilan ulang","pairs":[["هَلْ هُنَاكَ طَاوِلَةٌ فَارِغَةٌ؟","١"],["أُرِيدُ قَائِمَةَ الطَّعَامِ.","٢"],["مَاذَا عَنِ الْمَشْرُوبَاتِ؟","٣"],["أُرِيدُ الشَّايَ بَعْدَ الطَّعَامِ.","٤"],["أَنَا جَائِعٌ جِدًّا.","٥"],["تَفَضَّلْ، وَالْبَاقِي لَكَ.","٦"]]},{"type":"match","ins":"صِلِ الْجُمْلَةَ بِالْكَلِمَةِ الْمُنَاسِبَةِ","q":"Taʼrifni mos soʻz bilan ulang","pairs":[["طَاوِلَةٌ نَضَعُ عَلَيْهَا الطَّعَامَ","مَائِدَةٌ"],["وَرَقَةٌ فِيهَا أَسْمَاءُ الْأَطْعِمَةِ","قَائِمَةُ الطَّعَامِ"],["الْفَطُورُ وَالْغَدَاءُ وَالْعَشَاءُ","وَجَبَاتٌ"],["الْعَصِيرُ وَالشَّايُ وَالْقَهْوَةُ","مَشْرُوبَاتٌ"],["آكُلُ الْخَضْرَاوَاتِ وَالْفَاكِهَةَ فَقَطْ","نَبَاتِيٌّ"]]},{"type":"classify","ins":"صَنِّفِ الْكَلِمَاتِ","q":"Soʻzlarni guruhlarga ajrating","cols":["مَشْرُوبَاتٌ بَارِدَةٌ","مَشْرُوبَاتٌ حَارَّةٌ","الْغَدَاءُ"],"words":[["عَصِيرٌ",0],["مَاءٌ",0],["حَلِيبٌ",0],["قَهْوَةٌ",1],["شَايٌ",1],["أُرْزٌ",2],["دَجَاجٌ",2],["لَحْمٌ",2],["سَمَكٌ",2],["فَاصُولْيَا",2]]}]},{"k":"muhadatha1","t":"Suhbat · الْمُحَادَثَةُ (1)","ar":"الطَّعَامُ وَالشَّرَابُ","d":"Ovqat haqida savollar","items":[{"type":"read","ins":"تَحَدَّثْ مَعَ زَمِيلِكَ","title":"الطَّعَامُ وَالشَّرَابُ","lines":[["","مَا طَعَامُكَ الْمُفَضَّلُ؟","Sevimli taoming nima?"],["","مَا شَرَابُكَ الْمُفَضَّلُ؟","Sevimli ichimliging nima?"],["",