i tanlang","opts":["إِلَيْهِمَا","إِلَيْهِ"],"ok":"إِلَيْهِمَا","full":"الْوَالِدَانِ، ذَهَبْتُ إِلَيْهِمَا.","fz":"Ota-onam — ularning oldiga bordim.","why":"الْوَالِدَانِ — ikkilik: ـهِمَا."},{"type":"choose","ins":"اخْتَرِ الضَّمِيرَ الْمُنَاسِبَ","q":"يَا أَصْدِقَائِي، أَنَا ………","qz":"Mos olmoshni tanlang","opts":["مَعَكُمْ","مَعَكَ"],"ok":"مَعَكُمْ","full":"يَا أَصْدِقَائِي، أَنَا مَعَكُمْ.","fz":"Doʻstlarim, men sizlar bilanman.","why":"Koʻpchilikka murojaat — ـكُمْ."},{"type":"choose","ins":"اخْتَرِ الضَّمِيرَ الْمُنَاسِبَ","q":"يَا أَحْمَدُ، كَمْ ………؟","qz":"Mos olmoshni tanlang","opts":["رَاتِبُكَ","رَاتِبُهُ"],"ok":"رَاتِبُكَ","full":"يَا أَحْمَدُ، كَمْ رَاتِبُكَ؟","fz":"Ahmad, maoshing qancha?","why":"Ahmadning oʻziga murojaat — «sening»: ـكَ."},{"type":"choose","ins":"حَوِّلْ إِلَى الضَّمِيرِ الْمُتَّصِلِ","q":"أَصْدِقَائِي غُرْفَتُـ… جَمِيلَةٌ.","qz":"Mos qoʻshimchani tanlang (namuna: جَدِّي بَيْتُهُ بَعِيدٌ.)","opts":["ـهُمْ","ـهُ","ـهَا"],"ok":"ـهُمْ","full":"أَصْدِقَائِي غُرْفَتُهُمْ جَمِيلَةٌ.","fz":"Doʻstlarimning xonasi chiroyli.","why":"أَصْدِقَائِي — koʻplik (erkaklar): ـهُمْ."},{"type":"choose","ins":"حَوِّلْ إِلَى الضَّمِيرِ الْمُتَّصِلِ","q":"الطَّالِبَةُ اسْمُـ… خَدِيجَةُ.","qz":"Mos qoʻshimchani tanlang","opts":["ـهَا","ـهُ","ـهُمْ"],"ok":"ـهَا","full":"الطَّالِبَةُ اسْمُهَا خَدِيجَةُ.","fz":"Talaba qizning ismi — Xadicha.","why":"الطَّالِبَةُ — muannas birlik: ـهَا."},{"type":"choose","ins":"صِلِ الضَّمِيرَ الْمُنْفَصِلَ بِالْمُتَّصِلِ","q":"الْحَقِيبَةُ لَكُمْ = ………","qz":"Bir xil maʼnolisini tanlang (namuna: الْقَلَمُ لَكَ = قَلَمُكَ)","opts":["حَقِيبَتُكُمْ","حَقِيبَتُهُمْ","حَقِيبَتُكَ"],"ok":"حَقِيبَتُكُمْ","why":"لَكُمْ «sizlarga tegishli» = ـكُمْ."},{"type":"choose","ins":"صِلِ الضَّمِيرَ الْمُنْفَصِلَ بِالْمُتَّصِلِ","q":"سَاعَتُهُ = ………","qz":"Bir xil maʼnolisini tanlang (namuna: كِتَابِي = الْكِتَابُ لِي)","opts":["السَّاعَةُ لَهُ","السَّاعَةُ لَهَا","السَّاعَةُ لَكَ"],"ok":"السَّاعَةُ لَهُ","why":"ـهُ = لَهُ «unga (erkakka) teg